# Maintainer: Capricornus007 <capricornus007@users.noreply.github.com>
# License: The Better WTFPL (TBWTFPL) v114514 - https://github.com/Capricornus007/tbwtfpl/blob/main/LICENSE
# 本倉 in-tree 維護版（2026-11-15）。基底：AUR lib32-openal 1.25.2-2
# （git+tag），改成吃 kcat/openal-soft 的 git HEAD；AUR 上沒有 lib32-openal-git。
# epoch=1 保證 1:1.25.2.rN.gHASH 嚴格大於目標機的 1.25.2-2，杜絕版本回退。
# depends 仍寫官方 openal（openal-git 也 provides openal，兩邊都解析得到）。
# ⚠️ 版號由 pkgver() 現算 ⇒ kind: multilib 天然排除「校驗和回推」。

pkgbase=lib32-openal-git
pkgname=(lib32-openal-git)
pkgver=1.25.2.r1.gf72b6fe7
pkgrel=1
epoch=1
pkgdesc='Cross-platform 3D audio library, software implementation (32-bit, git)'
arch=(x86_64)
url='https://github.com/kcat/openal-soft'
license=(LGPL-2.0-or-later)
depends=(lib32-gcc-libs lib32-glibc openal)
makedepends=(cmake git ninja lib32-alsa-lib lib32-jack lib32-libpulse
             lib32-pipewire lib32-portaudio)
provides=('lib32-openal' libopenal.so)
conflicts=('lib32-openal')
source=("git+https://github.com/kcat/openal-soft.git")
sha256sums=('SKIP')

pkgver() {
  cd openal-soft
  git describe --long --tags --exclude=makemhr | sed 's/^openal-soft-//;s/-/.r/;s/-/./g'
}

build() {
  local cmake_options=(
    -DCMAKE_INSTALL_PREFIX=/usr
    -DCMAKE_BUILD_TYPE=None
    -DCMAKE_INSTALL_LIBDIR=lib32
    -DALSOFT_EXAMPLES=OFF
    -DALSOFT_UTILS=OFF
  )
  export CC="gcc -m32 -mstackrealign"
  export CXX="g++ -m32 -mstackrealign"
  export PKG_CONFIG=i686-pc-linux-gnu-pkg-config
  cmake -S openal-soft -B build -G Ninja "${cmake_options[@]}"
  cmake --build build
}

package_lib32-openal-git() {
  optdepends=('lib32-fluidsynth: MIDI rendering')
  DESTDIR="$pkgdir" cmake --install build
  rm -rvf "$pkgdir"/usr/{include,share,bin}
}
