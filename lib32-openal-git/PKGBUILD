# Maintainer: Capricornus007 <capricornus007@users.noreply.github.com>
# License: The Better WTFPL (TBWTFPL) v114514 - https://github.com/Capricornus007/tbwtfpl/blob/main/LICENSE
# 本倉 in-tree 維護版（2026-11-15）。基底：AUR lib32-openal 1.25.2-2
# （git+tag），改成吃 kcat/openal-soft 的 git HEAD；AUR 上沒有 lib32-openal-git。
# epoch=1 保證 1:1.25.2.rN.gHASH 嚴格大於目標機的 1.25.2-2，杜絕版本回退。
# depends 仍寫官方 openal（openal-git 也 provides openal，兩邊都解析得到）。
# ⚠️ 版號由 pkgver() 現算 ⇒ kind: multilib 天然排除「校驗和回推」。

pkgbase=lib32-openal-git
pkgname=(lib32-openal-git)
pkgver=1.25.2.r1.gf72b6fe7
pkgrel=1
epoch=1
pkgdesc='Cross-platform 3D audio library, software implementation (32-bit, git)'
arch=(x86_64)
url='https://github.com/kcat/openal-soft'
license=(LGPL-2.0-or-later)
depends=(lib32-gcc-libs lib32-glibc openal)
# lib32-portaudio 是 AUR-only，CI multilib 容器沒有也不該為了一個選配
# backend 去裝它（run 43726513086 實測 target not found）。明確關掉 backend。
# ⚠️ lib32-jack 也裁了（run 43816326927/43820282668 實測）：Arch 已從 multilib
# 刪掉 lib32-jack／lib32-fluidsynth／lib32-portaudio（jack 由 pipewire-jack
# 頂替），Artix [lib32] 同步裁掉——這三顆在任何倉都取不到，openal 的 cmake
# 探測不到標頭會自動關掉對應 backend（ALSA／PulseAudio／PipeWire 三個主力
# backend 的庫都還在，不受影響）。
makedepends=(cmake git ninja lib32-alsa-lib lib32-libpulse lib32-pipewire)
provides=('lib32-openal' libopenal.so)
conflicts=('lib32-openal')
source=("git+https://github.com/kcat/openal-soft.git")
sha256sums=('SKIP')

pkgver() {
  cd openal-soft
  git describe --long --tags --exclude=makemhr | sed 's/^openal-soft-//;s/-/.r/;s/-/./g'
}

prepare() {
  cd openal-soft
  # GCC 16 的 libstdc++ 在 <bits/std.cc>（C++ 模組單元）裡用
  # `#if __cpp_lib_xxx` 判斷特性，宏未定義時會觸發 -Werror=undef 直接中斷，
  # 這是工具鏈與函式庫的相容問題，不是本包原始碼缺陷（run 43728961096 實測）。
  # 上游在 ALSOFT_WERROR=OFF 時仍無條件附加 -Werror=undef，這裡降級為一般警告。
  #
  # ⚠️ 上一版寫 `grep -q ... && { echo; return 1; }`——makepkg 的 prepare() 用
  # `set -e` 語義跑，這個複合指令在 grep **成功**（＝sed 沒命中）時執行 return 1，
  # 使整個 prepare 靜默失敗（run 43701041746 實測只有 "ERROR: A failure occurred
  # in prepare()"，連訊息都沒印出來）。改成 if 塊並把失敗訊息寫清楚。
  sed -i 's/list(APPEND C_FLAGS -Werror=undef -Werror=format-security/list(APPEND C_FLAGS -Werror=format-security/' \
    CMakeLists.txt
  if grep -q 'C_FLAGS -Werror=undef' CMakeLists.txt; then
    echo "::error::lib32-openal-git: sed 未命中 -Werror=undef，上游 CMakeLists 改寫法了" >&2
    grep -n 'Werror=undef' CMakeLists.txt >&2 || true
    exit 1
  fi
  echo "prepare: 已把 -Werror=undef 降級（保留 format-security 等其餘告警）"
}

build() {
  local cmake_options=(
    -DCMAKE_INSTALL_PREFIX=/usr
    -DCMAKE_BUILD_TYPE=None
    -DCMAKE_INSTALL_LIBDIR=lib32
    -DALSOFT_EXAMPLES=OFF
    -DALSOFT_UTILS=OFF
    -DALSOFT_BACKEND_PORTAUDIO=OFF
  )
  export CC="gcc -m32 -mstackrealign"
  export CXX="g++ -m32 -mstackrealign"
  export PKG_CONFIG=i686-pc-linux-gnu-pkg-config
  cmake -S openal-soft -B build -G Ninja "${cmake_options[@]}"
  cmake --build build
}

package_lib32-openal-git() {
  # lib32-fluidsynth 已從 Arch multilib／Artix [lib32] 消失，optdepends 一併摘
  # （否則 pacman -Si 會提示一顆永遠裝不上的選配）。
  DESTDIR="$pkgdir" cmake --install build
  rm -rvf "$pkgdir"/usr/{include,share,bin}
}
