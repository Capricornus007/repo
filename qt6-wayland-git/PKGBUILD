# 2026-11-22 in-tree（MLFS 装 kdeconnect-git 的 Qt6 栈）。
# dev 分支（5最）。本機 wayland 是 wayland-git（provides wayland）。
pkgname=qt6-wayland-git
pkgver=6.12.0.dev
pkgrel=1
pkgdesc='A cross-platform application and UI framework (Qt6 wayland, dev branch)'
arch=(x86_64)
url='https://www.qt.io'
license=(GPL-2.0-only LGPL-3.0-only)
depends=(gcc-libs
         glibc
         libxkbcommon
         qt6-base
         qt6-declarative
         wayland)
makedepends=(git
             cmake
             ninja
             wayland-protocols)
provides=('qt6-wayland')
conflicts=('qt6-wayland')
source=(git+https://github.com/qt/qtwayland.git#branch=dev)
sha256sums=('SKIP')

pkgver() {
  cd qtwayland
  _v=$(git describe --tags --match 'v*' --abbrev=0 2>/dev/null | sed 's/^v//;s/-.*//')
  echo "${_v:-6.12.0}.dev"
}

build() {
  cmake -B build -S qtwayland -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DINSTALL_ARCHDATADIR=lib/qt6 \
    -DINSTALL_BINDIR=lib/qt6/bin \
    -DINSTALL_LIBEXECDIR=lib/qt6 \
    -DINSTALL_PLUGINSDIR=lib/qt6/plugins \
    -DINSTALL_QMLDIR=lib/qt6/qml \
    -DQT_BUILD_TESTS=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build

  install -d "$pkgdir"/usr/share/licenses
  ln -s /usr/share/licenses/qt6-wayland "$pkgdir"/usr/share/licenses/$pkgname
}
