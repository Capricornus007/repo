# 2026-11-22 in-tree（MLFS 系统装 flameshot-git 的依赖链）：官方 extra 0.4.1 原样转发。
# AUR 无此包（xorg 官方静态版本包）。
pkgname=xcb-util-keysyms
pkgver=0.4.1
pkgrel=1
pkgdesc="XCB utility library for keycodes"
arch=(x86_64)
url="https://xorg.freedesktop.org/"
license=(MIT)
depends=(libxcb)
makedepends=(pkgconfig xorg-util-macros)
source=(https://xorg.freedesktop.org/archive/individual/lib/xcb-util-keysyms-${pkgver}.tar.xz)
sha256sums=('7c260a5294412aed429df1da2f8afd3bd07b7cba3fec772fba15a613a6d5c638')

build() {
  cd ${pkgname}-${pkgver}
  ./configure --prefix=/usr --disable-static
  make
}

package() {
  cd ${pkgname}-${pkgver}
  make DESTDIR="${pkgdir}" install
  install -Dm644 COPYING -t "${pkgdir}"/usr/share/licenses/${pkgname}
}
