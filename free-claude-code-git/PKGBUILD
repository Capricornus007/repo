# 來源：用戶本地 ~/.cache/yay/free-claude-code-bin/PKGBUILD。實查（git diff + 與 AUR
# cgit raw 比對）該檔與 AUR 現行版（matskuijpers／原提交者 Vitaliy Star，
# 2.0.0.r631.23e409c-1）逐字相同，用戶在本機版裡沒有額外改動。
#
# 依用戶要求改成 -git 版：AUR 那份雖然掛 -bin，source 卻是
# `git+https://github.com/Alishahryar1/free-claude-code.git`、build() 用 uv 從源碼
# 裝進 /opt 下的 venv，根本不是預編譯二進制分發，違反「-bin 只放預編譯產物」的
# AUR 命名慣例，故本倉取名 free-claude-code-git（實查 AUR 沒有同名包）。
#
# bin→git 的全部改動（build()/package() 逐字保留）：
#   1. pkgname 與 install 檔名 → free-claude-code-git；pkgver 由 pkgver() 於構建時
#      重算，寫在檔頭的 2.0.0.r631 只是佔位。
#   2. pkgver() 的 `cd "$srcdir/free-claude-code"` → 相對 `cd "free-claude-code"`：
#      本倉 CI 的泛用 AUR -git 探測（build-packages.yml 預設分支）是把 PKGBUILD 單檔
#      拷進臨時目錄、按 source URL clone 成 ${pkgname%-git}，再直接跑 pkgver()；
#      那時 $srcdir 未定義，原寫法會 cd 到 /free-claude-code 而失敗。本倉其他 -git 包
#      （oh-my-pi-git/mpv-git/qalculate 系）因此一律用相對路徑。
#      hash 固定 --short=7，免得 blobless clone（探測用）與完整 clone（實建用）因物件
#      數不同而自動縮短字數，造成「探測版本 ≠ 產物版本」、每小時白編一次。
#   3. conflicts 補實包名 free-claude-code-bin（理由見下方 provides 取捨註解）。
#   4. package() 的 /usr/bin 聯結由「寫死四個名字」改成「凡 fcc-* 全部聯出」——
#      AUR 那份寫死的 free-claude-code 與 fcc-init 在上游 6.2.39 已不存在，實裝後
#      只剩 2 支指令可用，另 10 支（fcc-codex/-pi/-opencode/-cline/-hermes/-dsh/
#      -grok/-muse/-aider/-desktop）被封在 /opt。除此之外 build()/package() 逐字保留。
#
# 本地驗證 note：本機沒有 Arch 的 uv 包（Artix 未收），build 時用解到 /tmp 的
# uv 0.12.17 官方靜態版（與 Arch extra 同版本）頂替，未往系統裝任何東西；
# CI 容器 makepkg -s 會直接裝 extra 的 uv。
# Maintainer: Vitaliy VVS Star <vitaliy <dot> star <at> Gmail-DOT-Com>

pkgname=free-claude-code-git
pkgver=6.2.39.r1086.8ac3c6c
pkgrel=1
pkgdesc="Proxy to use Claude Code CLI with free alternative providers (NVIDIA NIM, OpenRouter, DeepSeek, etc.)"
arch=('x86_64')
url="https://github.com/Alishahryar1/free-claude-code"
license=('MIT')
depends=('python>=3.14')
makedepends=('git' 'uv')
# provides/conflicts 取捨（先讀過本倉 qoder-cli/PKGBUILD 那段 libalpm 單向命中的註解）：
# pacman 的 conflicts 只單向命中對手的 provides 與實包名（conflict.c 的
# check_conflict→_alpm_depcmp，無「反向衝突豁免」）。本包與 AUR 的 free-claude-code-bin
# 會搶同一批路徑（/opt/free-claude-code 整棵 venv + /usr/bin/{fcc-server,free-claude-code,
# fcc-init,fcc-claude} 四個 symlink），必須互斥，兩邊都要能擋：
#   * 我方 conflicts=('free-claude-code' 'free-claude-code-bin')——前者命中 -bin 自己宣告的
#     provides，後者命中它的實包名，缺任一條就留了繞過路；
#   * 我方 provides=('free-claude-code')（沿用 AUR -bin 的宣告）——讓 -bin 那邊的
#     conflicts=('free-claude-code') 也能命中我們，反向安裝一樣被擋。
#     與 qoder 案例的差別在於：qoder 是「自家 CLI 與 GUI 必須並存」才不能 provides；
#     這裡沒有並存需求（實查 AUR 無 free-claude-code 實包、也沒有別的包 conflicts
#     這個虛擬名），provides 屬純增益，故保留。
provides=('free-claude-code')
conflicts=('free-claude-code' 'free-claude-code-bin')
install="$pkgname.install"
source=("git+${url}.git")
sha256sums=('SKIP')

# 版本演算法：實查上游（2026-09-19）`git tag` 完全為空，本倉慣用的
# `git describe --long --tags --abbrev=7 | sed …`（mpv-git/oh-my-pi-git 式）會直接
# 「沒有發現名稱」而失敗，CI 的版本探測也拿不到值。故沿用 AUR 原式
# <pyproject.toml 的 version>.r<總提交數>.<短 hash>，輸出同樣是 AUR -git 慣例形狀。
pkgver() {
  cd "free-claude-code"
  local ver
  ver=$(grep '^version =' pyproject.toml | sed 's/version = "\(.*\)"/\1/')
  printf "%s.r%s.%s" "$ver" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
  cd "$srcdir/free-claude-code"
  uv venv --python /usr/bin/python3 --python-preference only-system "$srcdir/venv"
  source "$srcdir/venv/bin/activate"
  uv pip install .
  deactivate
}

package() {
  local venv_dir="/opt/free-claude-code"

  install -dm755 "$pkgdir$venv_dir"
  cp -a "$srcdir/venv/." "$pkgdir$venv_dir/"

  sed -i "s|$srcdir/venv|$venv_dir|g" "$pkgdir$venv_dir/pyvenv.cfg"
  find "$pkgdir$venv_dir/bin" -type f -exec sed -i "s|$srcdir/venv|$venv_dir|g" {} +
  find "$pkgdir$venv_dir/lib" -name '*.pth' -exec sed -i "s|$srcdir/venv|$venv_dir|g" {} +
  find "$pkgdir$venv_dir/lib" -name 'direct_url.json' -delete

  install -dm755 "$pkgdir/usr/bin"
  # AUR 版把四個入口名寫死（fcc-server / free-claude-code / fcc-init / fcc-claude），
  # 但上游 6.2.39 的 [project.scripts] 已改名/增設：實測建出來的 venv 裡
  # free-claude-code 與 fcc-init 兩支根本不存在（原寫法的 [ -f ] 靜默跳過，裝完只剩
  # fcc-claude、fcc-server 可用），而 fcc-codex/-pi/-opencode/-cline/-hermes/-dsh/
  # -grok/-muse/-aider 與 gui-script fcc-desktop 全被關在 /opt 裡。
  # 改成「凡 fcc-* 一律聯進 /usr/bin」，上游日後再加指令不必動 PKGBUILD；
  # 只挑 fcc-* 前綴，避免把 venv 裡依賴附帶的 fastapi/dotenv 等雜項也塞進 PATH。
  for cmd in "$pkgdir$venv_dir"/bin/fcc-* "$pkgdir$venv_dir"/bin/free-claude-code; do
    [ -f "$cmd" ] || continue
    _n="$(basename "$cmd")"
    ln -sf "$venv_dir/bin/$_n" "$pkgdir/usr/bin/$_n"
  done

  install -Dm644 /dev/stdin "$pkgdir/usr/share/licenses/$pkgname/LICENSE" <<'EOF'
MIT License

Copyright (c) 2026 Ali Khokhar

Permission is hereby granted, free of charge, to any person obtaining a copy
of this software and associated documentation files (the "Software"), to deal
in the Software without restriction, including without limitation the rights
to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
copies of the Software, and to permit persons to whom the Software is
furnished to do so, subject to the following conditions:

The above copyright notice and this permission notice shall be included in all
copies or substantial portions of the Software.

THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
SOFTWARE.
EOF
}
