# 本倉 in-tree 維護版（用戶 2026-11-01 指定把 libjpeg-turbo 這條收進自動構建倉）。
# 基底：AUR libjpeg-turbo-git（維護者 Chocobo1）。與 AUR 版的差異只有兩處，
# 都是「照 Arch/Artix 官方 libjpeg-turbo 的元數據對齊」，不是自己發明：
#   1. **補 `libturbojpeg.so=0-64` 到 provides**。實查本機 `pacman -Si libjpeg-turbo`
#      （[world-goblins] 3.2.1-1 與 [world] 3.2.0-2 兩份都一樣）提供的是
#      `libjpeg.so=8-64` ＋ `libturbojpeg.so=0-64` 兩個帶架構後綴的虛擬依賴，
#      而 AUR 那顆只有 `libjpeg.so=8-64`。少了第二個，任何改吃
#      `libturbojpeg.so=0-64` 的依賴方在換上 -git 後就會「倉裡明明有卻解析不到」。
#      本機現況（expac 全量掃）是 10 顆吃 `libjpeg.so=8-64`、0 顆吃 turbojpeg，
#      所以這是**防呆**不是救火。
#   2. `install -Dm644 src/jpegint.h "$pkgdir/usr/include"` 改成 `-t`。原本那行能對
#      只是因為 cmake 已經建出 `$pkgdir/usr/include` 目錄、GNU install 才把末參
#      當目錄處理；哪天上游改裝路徑就會把 jpegint.h 裝成**一個名叫
#      /usr/include 的檔案**。
#
# ⚠️ 版號由 pkgver() 從上游 HEAD 現算 ⇒ 本檔要列進「更新校驗和並回推」的排除清單。

# Maintainer: Chocobo1 <chocobo1 AT archlinux DOT net>

pkgname=libjpeg-turbo-git
pkgver=3.2.1.r1.gfa224ebe
pkgrel=1
pkgdesc="JPEG codec with SIMD accelerated compression and decompression"
url="https://libjpeg-turbo.org/"
license=(
  BSD-3-Clause
  IJG
  LicenseRef-libjpeg-turbo
)
arch=(x86_64)
depends=(glibc)
makedepends=(git cmake nasm)
provides=(
  "libjpeg-turbo=$pkgver"
  'libjpeg.so=8-64'
  'libturbojpeg.so=0-64'
)
conflicts=(libjpeg-turbo)
options=(staticlibs)
source=("git+https://github.com/libjpeg-turbo/libjpeg-turbo.git")
sha256sums=('SKIP')

pkgver() {
  cd libjpeg-turbo

  git describe --long --tags | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
  cd libjpeg-turbo

  CFLAGS="$CFLAGS -ffat-lto-objects" \
  CXXFLAGS="$CXXFLAGS -ffat-lto-objects" \
  cmake \
    -B _build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=/usr/lib \
    -DWITH_JPEG8=1 \
    ./
  cmake --build _build
}

package() {
  cd libjpeg-turbo

  DESTDIR="$pkgdir" \
  docdir=/usr/share/doc/libjpeg-turbo \
  exampledir=/usr/share/doc/libjpeg-turbo \
  cmake --install _build

  # required by other software
  install -Dm644 -t "$pkgdir/usr/include" src/jpegint.h
  install -Dm644 -t "$pkgdir/usr/share/licenses/libjpeg-turbo" LICENSE.md
}
