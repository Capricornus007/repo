# 六最納管 2026-11-25（任務#37，鐵律25）：LFS 同源版本源碼構建，pacman 接管所有權。
# 系統現有同名無主命令（LFS 自建），本包版本釘系統現版本，裝即接管非升級。
pkgname=flex
pkgver=2.6.4
pkgrel=1
pkgdesc='flex (LFS 同源構建，六最納管)'
arch=(x86_64)
url='https://ftp.gnu.org/gnu/flex/flex-2.6.4.tar.gz'
license=(GPL-3.0-or-later)

source=("https://github.com/westes/flex/releases/download/v2.6.4/flex-2.6.4.tar.gz")
sha256sums=('SKIP')

build() {
  cd "flex-2.6.4"
  ./configure --prefix=/usr
  make
}

package() {
  cd "flex-2.6.4"
  make DESTDIR="$pkgdir" install
}
