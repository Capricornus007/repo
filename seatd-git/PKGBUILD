# 六最搬運 2026-11-23：seatd 0.9.3，取代 elogind 的 seat/裝置存取部分。
# WITH -Dlibseat-logind=disabled → libseat-systemd:NO / libseat-elogind:NO，
# seatd NEEDED 只有 libc（本機 /tmp 隔離 -O3 -flto -march=znver3 實編驗證）。
pkgname=seatd-git
_pkgbase=seatd
pkgver=0.9.3
pkgrel=1
pkgdesc='Minimal seat management daemon and universal library (六最 znver3 LTO)'
arch=(x86_64)
url='https://github.com/kennylevinsen/seatd'
license=(MIT)
depends=(glibc)
makedepends=(git meson scdoc)
provides=(seatd libseat.so)
conflicts=(seatd)
source=("$_pkgbase-$pkgver.tar.gz::https://git.sr.ht/~kennylevinsen/seatd/archive/$pkgver.tar.gz")
b2sums=(SKIP)

build() {
  cd "$_pkgbase-$pkgver"
  arch-meson -Dlibseat-logind=disabled -Dlibseat-seatd=enabled -Dserver=enabled build
  meson compile -C build
}

check() {
  cd "$_pkgbase-$pkgver"
  meson test -C build --print-errorlogs
}

package() {
  cd "$_pkgbase-$pkgver"
  DESTDIR="$pkgdir" meson install -C build
  install -d "$pkgdir/usr/share/licenses/$pkgname"
  cp LICENSE "$pkgdir/usr/share/licenses/$pkgname/" 2>/dev/null || true
}
