# 2026-11-03：AUR 配方仍呼叫已從上游 master 移除的 autogen.sh；改用上游 Meson。
# 依賴全部指向本倉 Xfce 4.21 -git 鏈，避免產物混入穩定版 Xfce ABI。
# Adapted from the AUR recipe by xavery <dkk089@gmail.com>.

_pkgname=xfce4-cpufreq-plugin
pkgname=${_pkgname}-git
pkgver=1.3.0.r120.gca07046
pkgrel=1
epoch=1
pkgdesc="CPU frequency plugin for the Xfce panel (git checkout)"
arch=('x86_64')
url="https://docs.xfce.org/panel-plugins/xfce4-cpufreq-plugin/start"
license=('GPL-2.0-or-later')
groups=('xfce4-goodies-git')
depends=('xfce4-panel-git' 'libxfce4ui-git' 'libxfce4util-git' 'hicolor-icon-theme')
makedepends=('git' 'meson' 'glib2-devel')
provides=("${_pkgname}=${pkgver%%.r*}")
conflicts=("${_pkgname}")
replaces=("${_pkgname}")
source=("${_pkgname}::git+https://gitlab.xfce.org/panel-plugins/${_pkgname}")
sha256sums=('SKIP')

pkgver() {
  cd "${_pkgname}"
  git describe --long --tags | sed 's/^xfce4.cpufreq.plugin-//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
  meson setup "${_pkgname}" build \
    --prefix=/usr \
    --libexecdir=lib \
    --sbindir=bin \
    --buildtype=release \
    --auto-features=enabled \
    --wrap-mode=nodownload \
    -D python.bytecompile=1
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
}
