# 六最納管 2026-11-25（任務#37，鐵律25）：LFS 同源版本源碼構建，pacman 接管所有權。
# 系統現有同名無主命令（LFS 自建），本包版本釘系統現版本，裝即接管非升級。
pkgname=binutils
pkgver=2.47
pkgrel=1
pkgdesc='binutils (LFS 同源構建，六最納管)'
arch=(x86_64)
url='https://sourceware.org/pub/binutils/releases/binutils-2.47.tar.xz'
license=(GPL-3.0-or-later)

source=("https://sourceware.org/pub/binutils/releases/binutils-2.47.tar.xz")
sha256sums=('SKIP')

build() {
  cd "binutils-2.47"
  # 2026-11-26 shard3 #94：configure 自動帶 -Wstack-usage=262144 -Werror，
  # LTO 下 lto1 重編 ltrans 時 back-end 報 stack usage unbounded → -Werror 打成
  # error（make as-new Error 1 → lto-wrapper fatal）。關掉上游的 -Werror 即可，
  # 六最旗標（-O3/LTO/PGO/znver3）一根不動。
  ./configure --prefix=/usr --disable-werror
  make
}

package() {
  cd "binutils-2.47"
  make DESTDIR="$pkgdir" install
}
