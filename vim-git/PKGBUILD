# Lily 組合包：Vim master 與 lilydjwg/vim all 合併，避免 fork 落後上游時降級。
# 合併使用來源提交時間與固定身分，版本探測和實際構建得到相同內容與版本。
# split 出 gvim-git／vim-runtime-git／vim-git；GVim 同時提供圖形與命令列 Vim。
# Maintainer: lilydjwg <lilydjwg@gmail.com>

pkgbase=vim-git
pkgname=(gvim-git vim-runtime-git vim-git)
pkgver=9.2.1276.r24815.g546f6f4
pkgrel=2
arch=('i686' 'x86_64')
license=('VIM')
url="http://www.vim.org"
makedepends=('gpm' 'gtk3' 'python' 'ruby' 'gettext' 'wayland'
             'pkg-config' 'sed' 'luajit' 'git' 'tar' 'desktop-file-utils' 'libxt')
_gitname=vim-repo
source=('vimdoc.hook'
        "${_gitname}::git+https://github.com/vim/vim.git#branch=master"
        "vim-lily::git+https://github.com/lilydjwg/vim.git#branch=all")
sha1sums=('963e8413dd067f1fcd5c500ab4c42f6e33b4e6b3'
          'SKIP'
          'SKIP')
options=('debug' 'strip')

_merge_lily_source() {
  local _lily_tip _stamp _lily_stamp
  _lily_tip=$(git -C "$srcdir/vim-lily" rev-parse HEAD) || return
  _stamp=$(git -C "$srcdir/$_gitname" show -s --format=%ct HEAD) || return
  _lily_stamp=$(git -C "$srcdir/vim-lily" show -s --format=%ct HEAD) || return
  if (( _lily_stamp > _stamp )); then _stamp=$_lily_stamp; fi
  git -C "$srcdir/$_gitname" -c protocol.file.allow=always fetch --quiet --no-tags \
    "$srcdir/vim-lily" "$_lily_tip" || return
  GIT_AUTHOR_DATE="@$_stamp +0000" GIT_COMMITTER_DATE="@$_stamp +0000" \
    git -C "$srcdir/$_gitname" -c commit.gpgsign=false \
      -c user.name='Package Builder' -c user.email='builder@localhost' \
      merge --quiet --no-ff -m 'Merge Lily changes into Vim development' "$_lily_tip"
}

prepare() {
  _merge_lily_source
}

pkgver() {
  cd "$srcdir/$_gitname"
  local _version
  _version="$(awk '/^#define VIM_VERSION_(MAJOR|MINOR)\>/ {print $3}' src/version.h | tr '\n' '.')$(sed -n '/ included_patches\[\]/,+3p' src/version.c | sed '/[^,]$/d;s/\s*\|,//g')"
  printf '%s.r%s.g%s\n' "$_version" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
  cd "$srcdir/$_gitname"


  local vim_options='--without-x --with-wayland=no --disable-canberra --disable-gui --disable-xsmp --disable-pixman'
  local gvim_options='--enable-xsmp --enable-gui=gtk3'

  for name in vim gvim; do
    local _dir="${srcdir}"/$pkgbase
    rm -rf "$_dir" "$srcdir/$name-build"
    mkdir -p "$_dir"
    git archive HEAD | tar x -C "$_dir"

    pushd $_dir
    # 修改實際構建副本；在 git archive 之前改來源會被 archive 忽略。
    sed -i 's|^.*\(#define SYS_.*VIMRC_FILE.*"\) .*$|\1|' src/feature.h
    sed -i 's|^.*\(#define VIMRC_FILE.*"\) .*$|\1|' src/feature.h
    STRIP=true ./configure \
      --prefix=/usr \
      --localstatedir=/var/lib/vim \
      --mandir=/usr/share/man \
      --enable-acl \
      --enable-cscope \
      --enable-luainterp=dynamic \
      --enable-multibyte \
      --enable-python3interp=dynamic \
      --enable-rubyinterp=dynamic \
      --enable-terminal \
      --with-features=huge \
      --with-luajit \
      --disable-icon-cache-update --disable-desktop-database-update \
      $(eval "echo \$${name}_options") --enable-fail-if-missing \
      --with-compiledby=百合仙子 --with-modified-by=百合仙子

    msg2 "Building $name..."
    make -C src auto/pathdef.c
    sed -i 's/compiled_sys.*/compiled_sys = (char_u *)"次美好的百合森林";/' src/auto/pathdef.c
    make

    popd
    mv $_dir "${srcdir}"/$name-build
  done

}

package_vim-git() {
  pkgdesc='Vi Improved, a highly configurable, improved version of the vi text editor with additional scripting support'
  depends=('gpm' 'vim-runtime-git' 'acl')
  optdepends=('luajit' 'ruby' 'python')
  conflicts=('vim' 'gvim' 'vim-minimal')
  provides=(vim xxd vim-minimal vim-plugin-runtime)

  rm -f "${srcdir}"/$pkgbase
  ln -sr "${srcdir}"/vim-build "${srcdir}"/$pkgbase
  cd "${srcdir}"/vim-build
  make -j1 VIMRCLOC=/etc DESTDIR="${pkgdir}" install

  # provided by (n)vi in core
  rm ${pkgdir}/usr/bin/{ex,view}

  # delete some manpages
  find ${pkgdir}/usr/share/man -type d -name 'man1' 2>/dev/null | \
    while read _mandir; do
    cd ${_mandir}
    rm -f ex.1 view.1 # provided by (n)vi
  done

  # Runtime provided by runtime package
  rm -r "${pkgdir}"/usr/share/vim

  # license
  install -Dm644 "${srcdir}"/vim-repo/runtime/doc/uganda.txt \
    "${pkgdir}"/usr/share/licenses/${pkgname}/license.txt
}

package_gvim-git() {
  pkgdesc='Vi Improved, a highly configurable, improved version of the vi text editor (with advanced features, such as a GUI) with additional scripting support'
  depends=('gpm' 'gtk3' 'vim-runtime-git' 'desktop-file-utils' 'libxt' 'wayland' 'libwayland-client.so')
  optdepends=('luajit' 'ruby' 'python')
  conflicts=('vim' 'gvim' 'vim-minimal')
  provides=(vim xxd vim-minimal vim-plugin-runtime)

  rm -f "${srcdir}"/$pkgbase
  ln -sr "${srcdir}"/gvim-build "${srcdir}"/$pkgbase
  cd "${srcdir}"/gvim-build
  make -j1 VIMRCLOC=/etc DESTDIR="${pkgdir}" install

  # provided by (n)vi in core
  rm ${pkgdir}/usr/bin/{ex,view}

  mv ${pkgdir}/usr/bin/{vim,gvim}
  ln -s gvim ${pkgdir}/usr/bin/vim

  # delete some manpages
  find ${pkgdir}/usr/share/man -type d -name 'man1' 2>/dev/null | \
    while read _mandir; do
    cd ${_mandir}
    rm -f ex.1 view.1 # provided by (n)vi
  done

  # Move the runtime for later packaging
  mv "${pkgdir}"/usr/share/vim "${srcdir}"/runtime-install

  # freedesktop links
  install -Dm644 "${srcdir}"/vim-repo/runtime/vim.desktop "${pkgdir}"/usr/share/applications/vim.desktop
  install -Dm644 "${srcdir}"/vim-repo/runtime/gvim.desktop "${pkgdir}"/usr/share/applications/gvim.desktop
  install -Dm644 "${srcdir}"/vim-repo/runtime/vim48x48.png "${pkgdir}"/usr/share/pixmaps/gvim.png

  # license
  install -Dm644 "${srcdir}"/vim-repo/runtime/doc/uganda.txt \
    "${pkgdir}"/usr/share/licenses/${pkgname}/license.txt
}

package_vim-runtime-git() {
  _versiondir="vim$(echo "$pkgver" | awk -F. '{print $1$2}')"
  if [ ! -d "${srcdir}"/runtime-install ]; then
    package_gvim-git
    rm -rf "$pkgdir"
  fi

  # set variables late
  pkgdesc='Runtime for vim and gvim'
  arch=('any')
  conflicts=('vim-runtime')
  provides=("vim-runtime=${pkgver}-${pkgrel}")
  # reset
  depends=()
  optdepends=()

  # Install the runtime split from gvim
  install -dm755 "${pkgdir}"/usr/share
  mv "${srcdir}"/runtime-install "${pkgdir}"/usr/share/vim

  # Don't forget logtalk.dict
  install -Dm644 "${srcdir}"/gvim-build/runtime/ftplugin/logtalk.dict \
    "${pkgdir}"/usr/share/vim/${_versiondir}/ftplugin/logtalk.dict

  # fix FS#17216
  sed -i 's|messages,/var|messages,/var/log/messages.log,/var|' \
    "${pkgdir}"/usr/share/vim/${_versiondir}/filetype.vim

  # license
  install -dm755 "${pkgdir}"/usr/share/licenses/vim-runtime
  ln -s /usr/share/vim/${_versiondir}/doc/uganda.txt \
    "${pkgdir}"/usr/share/licenses/vim-runtime/license.txt

  # The official package puts it in vim-runtime so we have to do the same to avoid conflicts
  install -Dm644 "${srcdir}"/vimdoc.hook "${pkgdir}"/usr/share/libalpm/hooks/vimdoc.hook

  # why there are two versions of them??
  cp -lf "${pkgdir}"/usr/share/vim/vim*/lang/zh_CN.UTF-8/LC_MESSAGES/vim.mo "${pkgdir}"/usr/share/vim/vim*/lang/zh_CN/LC_MESSAGES/vim.mo
}

