pkgname=kbreakout-git
pkgver=0.0.0
pkgrel=1
provides=("kbreakout=${pkgver}")
conflicts=("kbreakout")
pkgdesc='A Breakout-like game'
url='https://apps.kde.org/kbreakout/'
arch=(x86_64)
license=(GPL-2.0-or-later LGPL-2.0-or-later)
depends=(glibc
         kconfig
         kconfigwidgets
         kcoreaddons
         kcrash
         kdbusaddons
         ki18n
         kiconthemes
         kwidgetsaddons
         kxmlgui
         libkdegames
         libstdc++
         qt6-base
         qt6-declarative)
makedepends=(extra-cmake-modules
             kdoctools)
groups=(kde-applications
        kde-games)
source=("kbreakout::git+https://invent.kde.org/games/kbreakout.git")
sha256sums=('SKIP')
validpgpkeys=(CA262C6C83DE4D2FB28A332A3A6A4DB839EAA6D7  # Albert Astals Cid <aacid@kde.org>
              F23275E4BF10AFC1DF6914A6DBD2CE893E2D1C87  # Christoph Feck <cfeck@kde.org>
              D81C0CB38EB725EF6691C385BB463350D6EF31EF) # Heiko Becker <heiko.becker@kde.org>


pkgver() {
  cd "$srcdir/kbreakout"
  git tag --sort=-v:refname --list | grep '^v[0-9.]*$' | head -n1 | cut -c2-
}

build() {
  export CFLAGS="${CFLAGS:-} -march=znver3 -mtune=znver3 -O3 -pipe -fno-plt"
  export CXXFLAGS="${CFLAGS}"
  cmake -B build -S kbreakout \
    -DBUILD_TESTING=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
