# 2026-11-02：復活自 2f00ff2 的剔除清單。
# 原 AUR 版依賴 systemd-libs/systemd；Artix+OpenRC 沒有 libsystemd.so.0。
# 這裡用 -Dsystemd=false 關掉 systemd 整合，改用 udev；不跑上游測試。
_pkgbase=colord
pkgbase="$_pkgbase-git"
pkgname=(colord-git colord-sane-git libcolord-git)
pkgver=1.4.6.r16.d735245
pkgrel=2
pkgdesc="System daemon for managing color devices"
arch=(x86_64)
url="https://www.freedesktop.org/software/$_pkgbase"
license=(GPL2)
depends=(
	dbus
	dconf
	lcms2
	libgudev
	libgusb
	polkit
	shared-mime-info
	sqlite
	udev
)
makedepends=(
	argyllcms
	bash-completion
	docbook-xsl
	git
	gobject-introspection
	gtk-doc
	meson
	sane
	vala
)
provides=(colord colord-sane libcolord)
conflicts=(colord colord-sane libcolord)
# 2026-11-02：補 replaces（同 conflicts 三顆），裝機時直接頂替。
replaces=(colord colord-sane libcolord)
options=(!emptydirs)
source=("git+https://github.com/hughsie/colord")
b2sums=('SKIP')

pkgver() {
	git -C $_pkgbase describe --long --tags | sed 's/^v//;s/\([^-]*-\)g/r\1/;s/-/./g'
}

build() {
	meson setup $_pkgbase build \
		--prefix=/usr --libdir=lib --buildtype=plain --auto-features=enabled \
		-D libcolordcompat=true \
		-D sane=true \
		-D vapi=true \
		-D print_profiles=true \
		-D systemd=false \
		-D daemon_user=colord
	meson compile -C build
}

_pick() {
	local p="$1" f d; shift
	for f; do
		d="$srcdir/$p/${f#$pkgdir/}"
		mkdir -p "$(dirname "$d")"
		mv "$f" "$d"
		rmdir -p --ignore-fail-on-non-empty "$(dirname "$f")"
	done
}

package_colord-git() {
	depends+=("libcolord=$pkgver")
	optdepends=('argyllcms: color profiling'
	            'colord-sane: SANE support')
	# 2026-11-02：provides 必須帶 =$pkgver。colord-sane-git 的 depends 是
	# "colord=$pkgver"（帶版本），而不帶版本的 provides 滿足不了版本化依賴
	# → 實測 pacman 直接「無法滿足 colord-git 需要的依賴關係 libcolord=…」，
	# 也就是 CI 綠但這包根本裝不上。
	provides=("colord=$pkgver" libcolorhug.so)
	conflicts=(colord)

	DESTDIR="$pkgdir" meson install -C build

	echo 'u colord - "Color management daemon" /var/lib/colord' |
		install -Dm644 /dev/stdin "$pkgdir/usr/lib/sysusers.d/colord.conf"

	cd "$pkgdir"

	_pick sane usr/libexec/colord-sane
	_pick sane usr/lib/colord-plugins/libcolord_sensor_sane.so

	_pick lib usr/include/colord-1/colord{,.h}
	_pick lib usr/lib/libcolord{,compat}.so*
	_pick lib usr/lib/girepository-1.0/Colord-1.0.typelib
	_pick lib usr/lib/pkgconfig/colord.pc
	_pick lib usr/share/gir-1.0/Colord-1.0.gir
}

package_colord-sane-git() {
	pkgdesc+=" (SANE support)"
	depends=("colord=$pkgver" sane)
	provides=(colord-sane)
	conflicts=(colord-sane)

	mv sane/* "$pkgdir"
}

package_libcolord-git() {
	pkgdesc+=" (client library)"
	depends=(glib2 lcms2 udev)
	# 同上：colord-git 依賴 "libcolord=$pkgver"，這裡必須給版本。
	provides=("libcolord=$pkgver" libcolord.so)
	mv lib/* "$pkgdir"
}
