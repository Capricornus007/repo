# 六最納管 2026-11-25（任務#37，鐵律25）：LFS 同源版本源碼構建，pacman 接管所有權。
# 系統現有同名無主命令（LFS 自建），本包版本釘系統現版本，裝即接管非升級。
pkgname=pkgconf
pkgver=3.0.10
pkgrel=1
pkgdesc='pkgconf (LFS 同源構建，六最納管)'
arch=(x86_64)
url='https://distfiles.amperecomputing.com/blfs/pkgconf-3.0.10.tar.gz'
license=(GPL-3.0-or-later)

source=("https://github.com/pkgconf/pkgconf/releases/download/pkgconf-3.0.10/pkgconf-3.0.10.tar.gz")
sha256sums=('SKIP')

build() {
  cd "pkgconf-3.0.10"
  ./configure --prefix=/usr
  make
}

package() {
  cd "pkgconf-3.0.10"
  make DESTDIR="$pkgdir" install
}
