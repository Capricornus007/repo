# Maintainer: Capricornus007 <Capricornus007 at gmail dot com>
# 基準：Arch 打包倉 gitlab.archlinux.org/archlinux/packaging/packages/openvpn
#       （main 分支，pkgver=2.7.8 pkgrel=2，2026-10-27 實取），以下只改 systemd 那半邊
#       與 makedepends 的完整性，其餘逐字照上游。

pkgname=openvpn
pkgver=2.7.8
pkgrel=2
pkgdesc='An easy-to-use, robust and highly configurable VPN (Virtual Private Network)'
arch=('x86_64')
url='https://openvpn.net/index.php/open-source.html'
license=('GPL-2.0-only')
# ⚠️ 這裡的 `.so` 依賴一律**不帶版本**（寫成 libcrypto.so，不是 libcrypto.so=3-64），
#    而且本包在 CI 裡要關掉 makepkg 的 autodeps（見 build-packages.yml 的
#    「對 openssl-4 相容的三顆關閉 autodeps」步驟）。兩件事是一體的，理由：
#    目標機（Artix）的 openssl 已從 [system-goblins] 抬到 4.1.0-1，它 provides 的是
#    `libcrypto.so=4-64`／`libssl.so=4-64`；官方 world 那顆 openvpn 2.7.8-1 的依賴是
#    `libcrypto.so=3-64`／`libssl.so=3-64`（實拆 world.db 查證），在本機只能靠過渡包
#    `openssl-3` 頂著才裝得上去。寫成不帶版本的形，openssl 3 與 4 兩邊都成立——
#    這也是 Artix 自己的慣例（docs/in-tree-packages.md 記過：world.db 全部 %DEPENDS%
#    裡 `-64` 結尾的條目數 = 0）。
depends=('libcap-ng' 'libcap-ng.so'
         'libnl' 'libnl-genl-3.so' 'libnl-3.so'
         'lz4'
         'lzo' 'liblzo2.so'
         'openssl' 'libcrypto.so' 'libssl.so'
         'pkcs11-helper' 'libpkcs11-helper.so')
optdepends=('easy-rsa: easy CA and certificate handling'
            'pam: authenticate via PAM')
# 上游有 'systemd'：拿掉（Artix 沒有 systemd，留著就是 `target not found: systemd`）。
# 另補 autoconf/automake/libtool/pkgconf/file：上游不列是因為 Arch 的建置鏡像預設就裝，
# 而 prepare() 的 `autoreconf --force --install` 與 package() 裡的 `file --mime-type`
# 在只裝 base-devel＋本清單的 Artix 容器裡是實打實的相依（本倉 in-tree 包一律寫全）。
makedepends=('git' 'python-docutils'
             'autoconf' 'automake' 'libtool' 'pkgconf' 'file')
install=openvpn.install
validpgpkeys=('F554A3687412CFFEBDEFE0A312F5F7B42F2B01E7'  # OpenVPN - Security Mailing List <security@openvpn.net>
              'B62E6A2B4E56570B7BDC6BE01D829EFECA562812') # Gert Doering <gert@v6.de>
source=("git+https://github.com/OpenVPN/openvpn.git?signed#tag=v${pkgver}"
        'openvpn.sysusers'
        'openvpn.tmpfiles')
sha256sums=('SKIP'
            '15669f82ac8b412eb3840ba9b39de20ca9b04bf082516c229577a5cb4e1a9610'
            'b1436f953a4f1be7083711d11928a9924993f940ff56ff92d288d6100df673fc')

# ── 為什麼收進本倉 in-tree（2026-10-27）────────────────────────────────────
# 1. 這顆包**不是**「官方倉已有、只是本機 DB 過舊」那一類。實查（抓現行 DB 逐條拆
#    %DEPENDS%）：
#      · Artix [world] openvpn 2.7.8-1 → depends libcrypto.so=3-64 / libssl.so=3-64
#      · Arch  [extra] openvpn 2.7.8-1 → 同上，另外還 depends systemd-libs
#      · Arch  [extra-staging] openvpn 2.7.8-2 → depends libcrypto.so=4-64（配 Arch 的
#        core-staging openssl 4），但同一清單裡有 systemd-libs／libsystemd.so=0-64，
#        Artix 機上沒有 libsystemd.so.0 → 裝了就是 run 時 "error while loading shared
#        libraries"（本倉 fcitx5-git 那場就是同一個病灶）。
#      · Artix [world-goblins]／[world-gremlins] 目前**根本還沒有** openvpn 的 openssl-4
#        重建（實查 2026-10-27 現值：查無此包）。
#    ⇒ 目標態（ openssl 4、無 systemd、soname 依賴不帶版本）在任何已啟用的倉裡都不存在，
#      只能自己出。
# 2. 版本取捨：吃上游最新的 2.7.8-**2**（＝Arch staging 那一版的 pkgrel，也是本機臨時倉
#    已裝的那一版），不是退回 [world] 的 2.7.8-1。
# 3. 構建基座：矩陣走 `kind: artix`＋`artixlinux/artixlinux:base-devel` 容器，讓容器裡的
#    openssl 與目標機同一顆（[system-goblins] 的 4.1.0-1）。用 Arch 容器會鏈出
#    NEEDED libcrypto.so.3，裝在這臺上就等於把「必須留著 openssl-3 過渡包」這件事又釘回去
#    一輪——與本包存在的目的相反。
# 4. 沒帶過來的東西：只有 systemd（depends 的 systemd-libs／libsystemd.so、makedepends 的
#    systemd、configure 的 --enable-systemd → 改成 --disable-systemd）。實拆本機臨時倉那顆
#    2.7.8-2 查證：usr/bin/openvpn 的 NEEDED 裡沒有 libsystemd，而 .INSTALL 與 Arch 的
#    openvpn.install 逐字相同（diff 空）、sysusers／tmpfiles 兩個檔的 sha256 也與上游宣告
#    一致 ⇒ 除 systemd 外與上游同構。
# 5. 逐包理由與驗證證據記 docs/in-tree-packages.md。

prepare() {
  cd "${srcdir}"/${pkgname}

  autoreconf --force --install
}

build() {
  mkdir "${srcdir}"/build
  cd "${srcdir}"/build

  "${srcdir}"/openvpn/configure \
    --prefix=/usr \
    --sbindir=/usr/bin \
    --libexec=/usr/lib \
    --enable-dco \
    --enable-pkcs11 \
    --enable-plugins \
    --disable-systemd \
    --enable-x509-alt-username
  make
}

check() {
  cd "${srcdir}"/build

  make check
}

package() {
  cd "${srcdir}"/build

  # Install openvpn
  make DESTDIR="${pkgdir}" install

  # Install sysusers and tmpfiles files
  install -D -m0644 ../openvpn.sysusers "${pkgdir}"/usr/lib/sysusers.d/openvpn.conf
  install -D -m0644 ../openvpn.tmpfiles "${pkgdir}"/usr/lib/tmpfiles.d/openvpn.conf

  # Install license
  install -d -m0755 "${pkgdir}"/usr/share/licenses/openvpn/
  ln -sf /usr/share/doc/openvpn/{COPYING,COPYRIGHT.GPL} "${pkgdir}"/usr/share/licenses/openvpn/

  cd "${srcdir}"/${pkgname}

  # Install examples
  install -d -m0755 "${pkgdir}"/usr/share/openvpn
  cp -r sample/sample-config-files "${pkgdir}"/usr/share/openvpn/examples

  # Install contrib
  for FILE in $(find contrib -type f); do
    case "$(file --brief --mime-type --no-sandbox "${FILE}")" in
      "text/x-shellscript")
        install -D -m0755 "${FILE}" "${pkgdir}/usr/share/openvpn/${FILE}" ;;
      *)
        install -D -m0644 "${FILE}" "${pkgdir}/usr/share/openvpn/${FILE}" ;;
    esac
  done
}
