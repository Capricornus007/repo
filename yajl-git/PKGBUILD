# 倉內 override（2026-11-01）：yajl 的 CMakeLists.txt 還寫著 cmake_minimum_required(2.x)，
# 新版 CMake（≥4）已移除 <3.5 兼容 → configure 直接紅。AUR 原版沒帶這個出口，
# 這裡在 build() 導出 CMAKE_POLICY_VERSION_MINIMUM=3.5 讓它照樣配置（上游不動）。

# Maintainer: Chocobo1 <chocobo1 AT archlinux DOT net>

pkgname=yajl-git
pkgver=2.1.0.r5.g5e3a785
pkgrel=3
pkgdesc="A fast streaming JSON parsing library in C"
arch=('i686' 'x86_64')
url="https://lloyd.github.io/yajl/"
license=('ISC')
depends=('glibc')
makedepends=('git' 'cmake')
provides=("yajl=$pkgver" 'libyajl.so')
conflicts=('yajl')
options=('staticlibs')
source=("git+https://github.com/lloyd/yajl.git")
sha256sums=('SKIP')


pkgver() {
  cd "yajl"

  git describe --long --tags | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
  export CMAKE_POLICY_VERSION_MINIMUM=3.5
  cd "yajl"

  cmake \
    -B "_build" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX="/usr" \
    ./
  cmake --build "_build"
}

check() {
  cd "yajl"

  #cmake --build "_build" --target test test-api
}

package() {
  cd "yajl"

  DESTDIR="$pkgdir" cmake --install "_build"
  install -Dm644 "COPYING" -t "$pkgdir/usr/share/licenses/yajl"
}
