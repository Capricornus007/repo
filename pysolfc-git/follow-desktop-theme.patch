@@ -123,6 +123,26 @@ class PysolMenubarTk(PysolMenubarTkCommon):
         if self.app.refreshToolbarImages():
             self.top.update_idletasks()
 
+    def mOptFollowDesktopTheme(self, *event):
+        on = bool(self.tkopt.follow_desktop_theme.get())
+        self.app.opt.follow_desktop_theme = int(on)
+        try:
+            from ttkthemes import themed_style
+            style = themed_style.ThemedStyle(self.top)
+        except ImportError:
+            style = ttk.Style(self.top)
+        from pysollib import systemtheme
+        try:
+            style.theme_use(self.app.opt.tile_theme)
+        except Exception:
+            pass
+        if on:
+            systemtheme.apply(self.top, style)
+        else:
+            systemtheme.reset(self.top, style)
+        if self.app.refreshToolbarImages():
+            self.top.update_idletasks()
+
     def createThemesMenu(self, menu):
