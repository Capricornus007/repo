diff --git a/pysollib/tile/selectcardset.py b/pysollib/tile/selectcardset.py
index d93d19da..bb3a3ee8 100644
--- a/pysollib/tile/selectcardset.py
+++ b/pysollib/tile/selectcardset.py
@@ -49,13 +49,29 @@ class SelectCardsetLeaf(SelectDialogTreeLeaf):
     pass
 
 
+def _cardset_leaf_text(obj, by_type):
+    """樹上每列的文字。型別名本來就在 CSI.TYPE_NAME 裡且走 gettext，
+    直接掛在牌面名後面，省得使用者到「按類型」那棵樹來回比對
+    （實測反應：「我看不懂它哪個適用於具體哪個遊戲」）。
+    名字本身已含型別時不再掛第二遍（Hex A Deck（Hex A Deck）那種）。"""
+    if by_type:
+        return obj.name
+    text = obj.name
+    type_name = CSI.TYPE_NAME.get(obj.si.type)
+    if type_name and type_name.lower() not in obj.name.lower():
+        text = '%s（%s）' % (obj.name, type_name)
+    return text
+
+
 class SelectCardsetNode(SelectDialogTreeNode):
     def _getContents(self):
         contents = []
+        by_type = isinstance(self.tree.data, SelectCardsetByTypeData)
         for obj in self.tree.data.all_objects:
             if self.select_func(obj):
                 node = SelectCardsetLeaf(
-                    self.tree, self, text=obj.name, key=obj.index)
+                    self.tree, self,
+                    text=_cardset_leaf_text(obj, by_type), key=obj.index)
                 contents.append(node)
         return contents or self.tree.data.no_contents
 
@@ -258,6 +274,14 @@ class SelectCardsetDialogWithPreview(MfxDialog):
 
         # Tree
         font = app.getFont("default")
+        # 每列掛上型別標註後標籤變長，寫死的 275px 會把「Hanafuda 200 Years
+        # Small（花札）」這種截斷；照最長標籤的實測寬度放寬，上限仍是對話框的 1/2.5。
+        if font:
+            widest = max(
+                [int(self.top.tk.call('font', 'measure', font,
+                                      _cardset_leaf_text(obj, False)))
+                 for obj in self.TreeDataHolder_Class.data.all_objects] + [0])
+            w1 = int(max(w1, min(pw / 2.5, widest + 78)))
         self.tree = self.Tree_Class(self, tree_frame, key=key,
                                     default=kw.default,
                                     font=font, width=w1)
