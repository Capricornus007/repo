# Maintainer: Capricornus007 (auto-build via Capricornus007/repo)
# Based on the Arch extra 'pysolfc' PKGBUILD by Jaroslav Lichtblau,
# Carl Smedstad and Eric Bélanger; switched to the upstream git tree.
pkgname=pysolfc-git
pkgver=3.6.1.r23.g7a3d146
pkgrel=1
pkgdesc="PySol (Fan Club edition) is an exciting collection of more than 1000 solitaire games (git version)"
arch=('any')
url="https://github.com/shlomif/PySolFC"
license=('GPL-3.0-or-later')
depends=(
  'pysolfc-cardsets'
  'python'
  'python-attrs'
  'python-configobj'
  'python-pillow'
  'python-pygame'
  'python-pysol_cards'
  'tk'
)
makedepends=(
  'git'
  'gettext'
  'python-build'
  'python-installer'
  'python-setuptools'
  'python-wheel'
)
optdepends=(
  'python-kivy: Kivy based interface'
)
provides=('pysolfc')
conflicts=('pysolfc')
# 我方語系（上游 po/ 裡沒有中文）。新增語言＝丟一個 <lang>_pysol.po 進本目錄並列進 source，
# prepare()/build() 是用萬用字元掃的，不用改腳本。
# follow-desktop-theme.patch + systemtheme.py：讓 Tk 元件跟隨桌面調色盤（見檔內說明）。
source=(
  "git+https://github.com/shlomif/PySolFC.git"
  'zh_TW_pysol.po'
  'zh_CN_pysol.po'
  'systemtheme.py'
  'follow-desktop-theme.patch'
)
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

pkgver() {
  cd PySolFC
  # Only match release tags (pysolfc-<version>) so Android CI tags are ignored.
  git describe --tags --long --abbrev=7 --match 'pysolfc-[0-9]*' \
    | sed 's/^pysolfc-//; s/\([^-]*-g\)/r\1/; s/-/./g'
}

prepare() {
  cd PySolFC
  mv pysol.py pysol
  sed -i 's/pysol\.py/pysol/' \
    MANIFEST.in \
    data/pysol.desktop \
    setup.py \
    tests/lib/pysol_tests/test_version_flag.py

  # 官方 release tarball 自带 data/html（约1100个帮助页），但 git tree 没有：
  # DataLoader 启动时强制读取 <datadir>/html/license.html，缺了直接
  # "OSError: DataLoader could not find" 起不来。上游 Makefile 的
  # `make rules` 会用 html-src/gen-html.py 现场生成整棵 data/html。
  if [ ! -f data/html/license.html ]; then
    make rules
  fi

  # 帶入我方語系（見上方 source 註解）
  for _po in "$srcdir"/*_pysol.po; do
    [ -e "$_po" ] || continue
    install -Dm644 "$_po" "po/$(basename "$_po")"
  done

  # in-tree 補丁：讓 Tk 元件跟隨桌面調色盤（KDE/Qt/Kvantum 的 kdeglobals，或 GTK 主題的 css）。
  # 上游 pysollib/winsystems/x11.py 把 Listbox/Text 寫死成白底、選取色寫死 #0a5f89，
  # 所以深色桌面下整個視窗框架還是 90 年代的灰。零新依賴——ttkthemes 在 Arch 與 AUR
  # 都不存在（只有 PyPI 有），這裡只用 Tk 內建的 clam 主題自己上色。
  install -Dm644 "$srcdir/systemtheme.py" pysollib/systemtheme.py
  if ! patch -p1 -N -i "$srcdir/follow-desktop-theme.patch"; then
    # 打不上＝上游動過 options.py / winsystems/common.py / winsystems/x11.py /
    # ui/tktile/menubar.py / tile/menubar.py 其中之一。靜默跳過會發出一個
    # 「看起來正常、其實沒跟隨主題」的包，所以寧可紅，別偷跑。
    echo "ERROR: follow-desktop-theme.patch 套用失敗——照 pysollib/systemtheme.py 的文件重做補丁"
    exit 1
  fi
}

build() {
  cd PySolFC
  # 上游 `make mo` 的語言清單是寫死的（de fr pl it ru pt_BR），中文不在內，
  # 所以照同一條公式（msgcat 合併 games+pysol → msgfmt）單獨編我方語系。
  # 產物落 locale/<lang>/LC_MESSAGES/pysol.mo，由 setup.py 的
  # get_data_files('locale', 'share/locale') 進 wheel → 裝到 /usr/share/locale。
  for _po in po/zh_*_pysol.po; do
    [ -e "$_po" ] || continue
    _lng=${_po##*/}
    _lng=${_lng%_pysol.po}
    if [ -f "po/${_lng}_games.po" ]; then
      msgcat --use-first "po/${_lng}_games.po" "$_po" > "po/${_lng}.po"
    else
      cp "$_po" "po/${_lng}.po"
    fi
    install -d "locale/${_lng}/LC_MESSAGES"
    msgfmt --check -o "locale/${_lng}/LC_MESSAGES/pysol.mo" "po/${_lng}.po"
  done
  python -m build --wheel --no-isolation
}

check() {
  cd PySolFC
  python -m unittest discover -v
}

package() {
  cd PySolFC
  python -m installer --destdir="$pkgdir" dist/*.whl
}
