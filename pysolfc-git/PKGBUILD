# Maintainer: Capricornus007 (auto-build via Capricornus007/repo)
# Based on the Arch extra 'pysolfc' PKGBUILD by Jaroslav Lichtblau,
# Carl Smedstad and Eric Bélanger; switched to the upstream git tree.
pkgname=pysolfc-git
pkgver=3.6.1.r23.g7a3d146
# epoch 是這包唯一的換代開關，別用 pkgrel：本包有 pkgver()，只要它算出的版本與這裡的
# 靜態 pkgver 不同，makepkg 就會把 pkgrel 重置為 1（CI 的 plan 步也照這個預測比對，
# 日誌原話「pkgver() 會改版本 → makepkg 必把 pkgrel 重置為 1」）。實測 10-07：
# 抬 pkgrel=2 之後仍「跳过构建：pysolfc-git-3.6.1.r37.gc39976f-1 已在 release 里」，
# feed 那顆停在 13:48 的純上游版（無語系／無主題補丁）。改完補丁或語系就 +1 epoch。
epoch=2
pkgrel=1
pkgdesc="PySol (Fan Club edition) is an exciting collection of more than 1000 solitaire games (git version)"
arch=('any')
url="https://github.com/shlomif/PySolFC"
license=('GPL-3.0-or-later')
depends=(
  'pysolfc-cardsets'
  'python'
  'python-attrs'
  'python-configobj'
  'python-pillow'
  'python-pygame'
  'python-pysol_cards'
  'tk'
)
makedepends=(
  'git'
  'gettext'
  'python-build'
  'python-installer'
  'python-setuptools'
  'python-wheel'
)
optdepends=(
  'python-kivy: Kivy based interface'
)
provides=('pysolfc')
conflicts=('pysolfc')
# 我方語系（上游 po/ 裡沒有中文）。每個語系有三份目錄：
#   <lang>_pysol.po  ＝ 介面字串（對應 po/pysol.pot，1324 條）
#   <lang>_games.po  ＝ 遊戲名稱（對應 po/games.pot，1848 條）
#   <lang>_help.po   ＝ 說明頁文字節點（localize-help.py 用，6572 段）
# 新增語言＝把這三個檔丟進本目錄並列進 source，腳本用萬用字元掃，不用改邏輯。
# build() 會 msgcat 把 pysol+games 合併成 po/<lang>.po 再 msgfmt（與上游 `make mo` 同一條公式）；
# help 那份不進 locale，是打包時拿来改寫 data/html 的。
# follow-desktop-theme.patch + systemtheme.py：讓 Tk 元件跟隨桌面調色盤（見檔內說明）。
# localized-help.patch：讓 DataLoader 優先取 html/<語系>/ 下的翻譯說明頁。
source=(
  "git+https://github.com/shlomif/PySolFC.git"
  'zh_TW_pysol.po'
  'zh_TW_games.po'
  'zh_TW_help.po'
  'zh_CN_pysol.po'
  'zh_CN_games.po'
  'zh_CN_help.po'
  'systemtheme.py'
  'localize-help.py'
  'follow-desktop-theme.patch'
  'localized-help.patch'
)
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

pkgver() {
  cd PySolFC
  # Only match release tags (pysolfc-<version>) so Android CI tags are ignored.
  git describe --tags --long --abbrev=7 --match 'pysolfc-[0-9]*' \
    | sed 's/^pysolfc-//; s/\([^-]*-g\)/r\1/; s/-/./g'
}

prepare() {
  cd PySolFC
  mv pysol.py pysol
  sed -i 's/pysol\.py/pysol/' \
    MANIFEST.in \
    data/pysol.desktop \
    setup.py \
    tests/lib/pysol_tests/test_version_flag.py

  # 官方 release tarball 自带 data/html（约1100个帮助页），但 git tree 没有：
  # DataLoader 启动时强制读取 <datadir>/html/license.html，缺了直接
  # "OSError: DataLoader could not find" 起不来。上游 Makefile 的
  # `make rules` 会用 html-src/gen-html.py 现场生成整棵 data/html。
  if [ ! -f data/html/license.html ]; then
    make rules
  fi

  # 帶入我方語系（見上方 source 註解）。缺檔要紅：CI 的「拉取对应的套件仓库」步驟
  # 過去對本包只 curl 了 PKGBUILD，語系檔根本沒下來，結果徽章全綠、包裡一個中文
  # 字都沒有（10-07 實測）。靜默跳過等于騙人，所以逐檔點名。
  for _po in "$srcdir"/zh_*_pysol.po "$srcdir"/zh_*_games.po; do
    [ -e "$_po" ] || continue
    install -Dm644 "$_po" "po/$(basename "$_po")"
  done
  for _need in zh_TW_pysol.po zh_TW_games.po zh_CN_pysol.po zh_CN_games.po; do
    if [ ! -f "po/$_need" ]; then
      echo "ERROR: 缺 po/$_need —— 語系檔沒被抓進 build 目錄，別發沒中文的包"
      exit 1
    fi
  done
  for _need in zh_TW_help.po zh_CN_help.po localize-help.py; do
    if [ ! -f "$srcdir/$_need" ]; then
      echo "ERROR: 缺 $_need —— 說明頁語系檔沒下來，包裝完會是純英文說明頁"
      exit 1
    fi
  done

  # in-tree 補丁：讓 Tk 元件跟隨桌面調色盤（KDE/Qt/Kvantum 的 kdeglobals，或 GTK 主題的 css）。
  # 上游 pysollib/winsystems/x11.py 把 Listbox/Text 寫死成白底、選取色寫死 #0a5f89，
  # 所以深色桌面下整個視窗框架還是 90 年代的灰。零新依賴——ttkthemes 在 Arch 與 AUR
  # 都不存在（只有 PyPI 有），這裡只用 Tk 內建的 clam 主題自己上色。
  install -Dm644 "$srcdir/systemtheme.py" pysollib/systemtheme.py
  if ! patch -p1 -N -i "$srcdir/follow-desktop-theme.patch"; then
    # 打不上＝上游動過 options.py / winsystems/common.py / winsystems/x11.py /
    # ui/tktile/menubar.py / tile/menubar.py 其中之一。靜默跳過會發出一個
    # 「看起來正常、其實沒跟隨主題」的包，所以寧可紅，別偷跑。
    echo "ERROR: follow-desktop-theme.patch 套用失敗——照 pysollib/systemtheme.py 的文件重做補丁"
    exit 1
  fi

  # 說明頁語系化：DataLoader.__findFile 優先試 html/<語系>/，缺檔退回英文。
  # 只這一處收口（help_html／mHelpRules／getGameRulesFilename 全走 findFile）。
  if ! patch -p1 -N -i "$srcdir/localized-help.patch"; then
    echo "ERROR: localized-help.patch 套用失敗——上游動過 pysollib/util.py 的 DataLoader"
    exit 1
  fi
}

build() {
  cd PySolFC
  # 上游 `make mo` 的語言清單是寫死的（de fr pl it ru pt_BR），中文不在內，
  # 所以照同一條公式（msgcat 合併 games+pysol → msgfmt）單獨編我方語系。
  # 產物落 locale/<lang>/LC_MESSAGES/pysol.mo，由 setup.py 的
  # get_data_files('locale', 'share/locale') 進 wheel → 裝到 /usr/share/locale。
  for _po in po/zh_*_pysol.po; do
    [ -e "$_po" ] || continue
    _lng=${_po##*/}
    _lng=${_lng%_pysol.po}
    if [ -f "po/${_lng}_games.po" ]; then
      msgcat --use-first "po/${_lng}_games.po" "$_po" > "po/${_lng}.po"
    else
      cp "$_po" "po/${_lng}.po"
    fi
    install -d "locale/${_lng}/LC_MESSAGES"
    msgfmt --check -o "locale/${_lng}/LC_MESSAGES/pysol.mo" "po/${_lng}.po"
  done
  # 說明頁的對照表：編到 helpmo/ 給 package() 的 localize-help.py 用。
  # 不進 /usr/share/locale——它不是 runtime gettext 目錄，是打包期改寫 HTML 的資料表。
  install -d "$srcdir/helpmo"
  for _po in "$srcdir"/zh_*_help.po; do
    _lng=${_po##*/}
    _lng=${_lng%_help.po}
    msgfmt --check -o "$srcdir/helpmo/${_lng}.mo" "$_po"
  done
  python -m build --wheel --no-isolation
}

check() {
  cd PySolFC
  python -m unittest discover -v
}

package() {
  cd PySolFC
  python -m installer --destdir="$pkgdir" dist/*.whl
  # 依 helpmo/*.mo 生出 html/<語系>/，localized-help.patch 讓 DataLoader 優先取它。
  _html=$(find "$pkgdir/usr/share" -maxdepth 2 -type d -name html | head -1)
  if [ -z "$_html" ] || [ ! -f "$_html/license.html" ]; then
    echo "ERROR: 找不到裝好的 data/html（上游改了安裝路徑？）——說明頁語系化做不了"
    exit 1
  fi
  for _mo in "$srcdir"/helpmo/*.mo; do
    _lng=${_mo##*/}
    _lng=${_lng%.mo}
    python "$srcdir/localize-help.py" "$_html" "$_lng" "$_mo"
  done
}
