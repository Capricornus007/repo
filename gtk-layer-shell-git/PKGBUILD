# 本倉 in-tree 維護版（2026-11-04）。
# 為什麼不直接用 AUR那份：AUR gtk-layer-shell-git 的 makedepends 漏了
#   'wayland-protocols'——上游 meson.build:24 `dependency('wayland-protocols')`
#   是硬依賴，pkg-config 找不到就 `ERROR: Dependency "wayland-protocols" not
#   found`（run 41750761615 實測）。上游自 2024 起還用 wayland-scanner private-code，
#   wayland 包 Provides wayland-protocols 沒有那個 .pc，必須單獨列。
# 其餘與 AUR 版逐字一致。

pkgname=gtk-layer-shell-git
_pkgname=gtk-layer-shell
pkgver=r583.577b2f0
pkgrel=1
provides=(gtk-layer-shell)
conflicts=(gtk-layer-shell)
pkgdesc="A library to create desktop components for Wayland using the Layer Shell protocol"
arch=(x86_64)
url="https://github.com/wmww/gtk-layer-shell"
makedepends=(meson wayland wayland-protocols gtk3 gobject-introspection vala)
source=("git+https://github.com/wmww/gtk-layer-shell.git")

pkgver() {
  cd "$_pkgname"
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd $_pkgname
}

build() {
  arch-meson $_pkgname build --prefix=/usr
  ninja -C build
}

package() {
  DESTDIR="$pkgdir" meson install -C build
}

# vim:set sw=2 et:
md5sums=('SKIP')
