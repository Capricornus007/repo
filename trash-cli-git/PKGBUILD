# trash-cli 的開發版（上游 master）。基準對照物是 Arch 官方 trash-cli
# （pkgver 0.24.5.26-3）：https://gitlab.archlinux.org/archlinux/packaging/packages/trash-cli/-/raw/main/PKGBUILD
# 本機實測 Artix 來源全部抓不到（api.artixlinux.org／code.artixlinux.org 連 DNS 都解析不出來），
# 故 depends/makedepends/checkdepends/打包方式全部以 Arch 為準逐條搬。
#
# 為什麼不沿用 AUR 現成的 trash-cli-git（本倉 CI 矩陣目前正是 kind:aur 抓它）：
#   1. 它用 `python setup.py build` / `python setup.py install --skip-build` 這條舊路，
#      Arch 官方早已改走 PEP 517（python -m build --wheel + python -m installer），
#      AUR 那份的 makedepends 也少了 python-build/python-installer/python-wheel。
#   2. 它的 depends 只有 python-psutil／python-six，漏了 python 本體（靠間接依賴撐著）。
#   3. 它只替 5 個指令產生補全，而上游 master 的 setup.cfg scripts 清單是 6 個
#      （多了 trash-rm）。本輪在實測裡確認 master 的 trash-rm --print-completion bash／zsh
#      都回 0，所以這裡補全 6 個，比 AUR 與穩定版都齊。
#   → 要啟用這份 in-tree 檔，必須把 build-git-packages.yml 裡
#     {"key": "trash-cli-git", ..., "kind": "aur"} 的 "kind": "aur" 拿掉（改矩陣由維護者做，
#     本檔不動 .github/）。
#
# ⚠️ 換上 in-tree 的已知代價：CI 對 in-tree 包**會跑 check()**（--nocheck 只給 kind:aur），
#   而本倉 run #230 實測過 trash-cli 的 pytest 有 3 條紅（產品碼其實編好了）。改 in-tree
#   之後若紅在 check()，那是測試追不上環境、不是包壞——但 workflow 會紅。
#
# 值得做的實據：上游最新 tag 0.26.9.14 已比 Arch 的 0.24.5.26 先進 79 個 commit，master 再領先
# 10 個（最新一顆 2026-09-27）。HISTORY.txt 記載 0.26.9.14 含多項安全修正：
# trash-restore 對 .trashinfo 的 Path= 路徑穿越做攔截、trash-list 印檔名前先過濾控制字元
# （阻擋 ANSI escape injection）、trash-put 對寫不進去的 trash 目錄不再無限重試。

_name=trash-cli
pkgname=$_name-git
# 佔位值，僅供人讀：實際由 pkgver() 從 origin/master 現算覆寫。
# 實測 origin/master = 0.26.9.14-10-gb80b00c。
pkgver=0.26.9.14.r10.gb80b00c
pkgrel=1
# epoch=1：上游 tag 是日期式（0.24.5.26、0.26.9.14、還有 0.23.2.13.2 這種五段的），
# describe 錨點一旦被挪動就會算出比庫裡舊的值，repo-add 拒收是本倉最陰的一類故障。
epoch=1
pkgdesc='Command line trashcan (recycle bin) interface'
arch=('any')
url='https://github.com/andreafrancia/trash-cli'
license=('GPL-2.0-only')
# 依賴取自官方 + 上游 master 的 setup.cfg install_requires（psutil、six），
# python 本體照官方明列。
depends=('python' 'python-psutil' 'python-six')
makedepends=('python-setuptools' 'python-shtab' 'python-build' 'python-installer' 'python-wheel' 'git')
checkdepends=('python-pytest' 'python-flexmock' 'python-parameterized')
provides=("$_name")
conflicts=("$_name")
source=("git+https://github.com/andreafrancia/${_name}.git#branch=master")
sha256sums=('SKIP')

pkgver() {
  # 目錄名必須是 ${pkgname%-git}=trash-cli；上游倉目錄名也是 trash-cli，克隆結果對得上，
  # 不需要「目錄名::git+URL」那種釘法。CI 的泛用版本探測照這個名字克隆，對不上會恆 skip。
  # 只看 origin/master 這個 ref，不看 HEAD（探測輪與實建輪必須同值，否則每輪白編）。
  # --match '[0-9]*'：實測上游 tag 全是數字開頭（含 0.22.10.20 這種多段式），加這道是防止
  # 日後有人掛 latest／test 之類的非版號 tag 搶走錨點（本倉 dae-git 踩過 lastst）。
  cd "${pkgname%-git}"
  git describe --tags --long --match '[0-9]*' origin/master \
    | sed 's/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd "${_name}"

  # 官方同款：不要依賴第三方複製的 stdlib（把 tests 裡的 mock 換成 unittest.mock）。
  # 這段是 check() 能在本機 Python 版本下跑起來的前提，不能因為「只是測試」就拿掉。
  find tests -type f -name '*.py' -exec \
    sed -i 's/^import mock$/from unittest import mock/;s/from mock /from unittest.mock /;s/from mock.mock /from unittest.mock /' {} +
}

build() {
  cd "${_name}"

  # 官方同款 PEP 517 打包（AUR 那份的 setup.py 路線已在 setuptools 新版的棄用警告邊緣，
  # 跟著官方走才不會哪天直接紅）。
  python -m build --wheel --no-isolation
  # 補全清單：官方是 5 個指令，這裡按 master 的 setup.cfg scripts 補成 6 個（加 trash-rm）。
  # 實測（本輪拿 master 工作目錄逐條跑 --print-completion bash）6 個全部可用。
  for cmd in trash trash-put trash-list trash-restore trash-empty trash-rm; do
    ./$cmd --print-completion bash > ./$cmd-completion
    ./$cmd --print-completion zsh > ./_$cmd-completion
  done
}

check() {
  cd "${_name}"
  python -m pytest
}

package() {
  cd "${_name}"

  python -m installer --destdir="$pkgdir" dist/*.whl
  for cmd in trash trash-put trash-list trash-restore trash-empty trash-rm; do
    install -vDm 644 ./$cmd-completion "$pkgdir/usr/share/bash-completion/completions/$cmd"
    install -vDm 644 ./_$cmd-completion "$pkgdir/usr/share/zsh/site-functions/_$cmd"
  done
}
