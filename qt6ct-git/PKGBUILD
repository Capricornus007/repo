# Maintainer: junlin03 (Capricornus007)
#
# 與 AUR/qt6ct-git 的差異（為什麼不能照抄它）：
#   1. 來源改成官方上游 opencode.net。AUR 那顆追的是 github 鏡像
#      trialuser02/qt6ct，master 凍在 0.9+6 筆（55dba87）；官方已發到 0.11。
#   2. 0.9 的代碼在 Qt 6.10+ 根本編不過：Qt 把 private/qgenericunixthemes_p.h
#      改名成 private/qgenericunixtheme_p.h（單數），0.11 才有版本分支與
#      Qt6::GuiPrivate 依賴 → 照抄 AUR 的 qmake 流程必然失敗（實測 MAKEPKG_EXIT=4）。
#   3. 建構改走 CMake（上游維護的那條；.pro 只剩附帶）。
#   4. depends 釘死 qt6-base=<建置時的 Qt 版本>：Qt6 的 platform theme 插件有
#      minor 版本硬閘（6.12 拒載 6.11 編的 .so），釘版本讓 yay 在 Qt 換代時
#      立刻把這顆列為過期並重編，不會再出現「主題靜默失靈好幾天」。
_pkgname=qt6ct
pkgname="$_pkgname-git"
# 不帶 epoch：本倉的 pkgver() 產出 0.11.rN.gHASH，段數多於倉庫的 0.11，
# rpmvercmp 本來就比較大；加 epoch 反而會在上游真的出 0.12 時擋住正常換代。
pkgver=0.11.r0.g00823e4   # 佔位值，實際由下方 pkgver() 覆寫（pacman 7.1 解析階段就要求存在）
pkgrel=1
pkgdesc='Qt6 Configuration Tool (official upstream git)'
arch=('x86_64')
url="https://www.opencode.net/trialuser/$_pkgname"
license=('BSD-3-Clause')
_qtver=$(/usr/lib/qt6/bin/qmake -query QT_VERSION 2>/dev/null)
if [[ -n $_qtver ]]; then
	depends=('qt6-base'"=$_qtver" 'qt6-svg' 'hicolor-icon-theme')
else
	depends=('qt6-base' 'qt6-svg' 'hicolor-icon-theme')
fi
makedepends=('git' 'cmake' 'qt6-tools')
provides=("$_pkgname")
conflicts=("$_pkgname")
source=("git+https://www.opencode.net/trialuser/$_pkgname.git")
sha256sums=('SKIP')

pkgver() {
	cd "$srcdir/$_pkgname"
	git describe --tags --long \
		| sed -e 's/^v//' -e 's/\([^-]*-g\)/r\1/' -e 's/-/./g'
}

build() {
	cd "$_pkgname"
	cmake -S . -B build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
	cmake --build build --parallel 4
}

package() {
	cd "$_pkgname"
	DESTDIR="$pkgdir" cmake --install build
	install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
