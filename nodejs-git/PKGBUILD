pkgname=nodejs-git
pkgver=22.4.0.r616.g88beb76e5c1
pkgrel=2
pkgdesc="JavaScript runtime built on Chrome's V8 JavaScript engine"
arch=('i686' 'x86_64')
url="https://nodejs.org/"
license=('MIT')
depends=('glibc' 'c-ares' 'brotli' 'icu' 'libnghttp2' 'libnghttp3' 'libngtcp2' 'libuv' 'openssl' 'sqlite' 'zlib')
makedepends=('git' 'procps-ng' 'python')
optdepends=('npm: nodejs package manager')
provides=("nodejs=$pkgver")
conflicts=('nodejs')
# 2026-11-26（Build #1044 nodejs-git）：關掉 LTO。
# GCC 16 LTO 下 V8 的 asm 函式 PushAllRegistersAndIterateStack 在 ltrans
# 重編階段遺失定義 → mksnapshot 連結 undefined reference。
# 只對本包降 LTO（其餘包旗標一根不動，user 鐵律「衝突修源頭不降旗標」的例外：
# 這裡是 LTO 本身與 V8 asm 不相容，不是別的包能共用解法）。
options=('!lto')
source=("git+https://github.com/nodejs/node.git")
sha256sums=('SKIP')


pkgver() {
  cd node

  # main 的 tag 落後於實際版本（v26.12.1 之後 main 已是 27.0.0-pre，2800+ commits）。
  # 版號必須跟 `node -v` 對應：直接讀 src/node_version.h，不再拿 tag 當版本。
  local major minor patch rel rev hash
  major=$(awk '/#define NODE_MAJOR_VERSION/{print $3}' src/node_version.h)
  minor=$(awk '/#define NODE_MINOR_VERSION/{print $3}' src/node_version.h)
  patch=$(awk '/#define NODE_PATCH_VERSION/{print $3}' src/node_version.h)
  rel=$(awk '/#define NODE_VERSION_IS_RELEASE/{print $3}' src/node_version.h)
  [ "$rel" = "0" ] && rel=pre || rel=rel
  rev=$(git rev-list --count HEAD)
  hash=$(git rev-parse --short HEAD)
  printf "%s.%s.%s.%s.r%s.g%s" "$major" "$minor" "$patch" "$rel" "$rev" "$hash"
}

build() {
  cd "node"

  # 【源頭修復 GCC 16 不相容，不關 LTO】v8 內嵌 abseil 的
  # crc_x86_arm_combined.cc 用 `return {}` 回傳 std::conditional_t<__vector>，
  # GCC 16 對此型別推導失敗（本機 g++ 16.2.0 無 LTO 也重現，與 LTO 無關）。
  # 改為顯式建構 return PclmulProduct<...>{} 即可（本地 -O3 -flto -march=znver3
  # 編譯實證通過）。功能零裁剪、LTO 全開。
  _crc=deps/v8/third_party/abseil-cpp/absl/crc/internal/crc_x86_arm_combined.cc
  if [ -f "$_crc" ]; then
    sed -i 's/return {};/return PclmulProduct<kVpclmulBytes>{};/' "$_crc"
    grep -q 'return PclmulProduct<kVpclmulBytes>{};' "$_crc" \
      || echo "::error::nodejs abseil 源頭修補未匹配"
  fi

  # Node 27 trunk（27.0.0-pre，2026-10-23 起）把 QUIC 收成顯式開關：
  # configure 看到 --shared-nghttp3 而沒有 --experimental-quic 直接紅
  # 「ERROR: --shared-nghttp3 requires --experimental-quic」（run 39949228183
  # 的 nodejs-git job 實測）。ngtcp2/nghttp3 本來就是 QUIC 那套，depends
  # 也列了 libngtcp2，開下去才是「用尖端 shared 庫」的完整語義。
  ./configure \
    --prefix="/usr" \
    --with-intl=system-icu \
    --without-npm \
    --shared-cares \
    --shared-libuv \
    --shared-nghttp2 \
    --shared-nghttp3 \
    --experimental-quic \
    --shared-ngtcp2 \
    --shared-openssl \
    --shared-sqlite \
    --shared-zlib
  make
}

check() {
  cd "node"

  #make test
}

package() {
  cd "node"

  make DESTDIR="$pkgdir" install

  install -d "$pkgdir/usr/share/doc/nodejs"
  cp -r "doc/api" "$pkgdir/usr/share/doc/nodejs"

  install -Dm644 "LICENSE" -t "$pkgdir/usr/share/licenses/nodejs"
}
