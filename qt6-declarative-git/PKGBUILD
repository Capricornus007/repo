# 2026-11-22 in-tree（MLFS 装 kdeconnect-git/kpat-git/kbreakout-git 的 Qt6 栈）。
# dev 分支（5最）。QML/Quick 全家在這，kirigami 也靠它。
pkgname=qt6-declarative-git
pkgver=6.12.0.dev
pkgrel=1
pkgdesc='Classes for QML and JavaScript (Qt6 dev branch)'
arch=(x86_64)
url='https://www.qt.io'
license=(GPL-2.0-only LGPL-3.0-only)
depends=(gcc-libs
         glibc
         glib2
         qt6-base
         qt6-shadertools)
makedepends=(git
             cmake
             ninja
             vulkan-headers)
provides=('qt6-declarative')
conflicts=('qt6-declarative')
source=(git+https://github.com/qt/qtdeclarative.git#branch=dev)
sha256sums=('SKIP')

pkgver() {
  cd qtdeclarative
  _v=$(git describe --tags --match 'v*' --abbrev=0 2>/dev/null | sed 's/^v//;s/-.*//')
  echo "${_v:-6.12.0}.dev"
}

build() {
  cmake -B build -S qtdeclarative -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DINSTALL_ARCHDATADIR=lib/qt6 \
    -DINSTALL_BINDIR=lib/qt6/bin \
    -DINSTALL_LIBEXECDIR=lib/qt6 \
    -DINSTALL_PLUGINSDIR=lib/qt6/plugins \
    -DINSTALL_QMLDIR=lib/qt6/qml \
    -DQT_BUILD_TESTS=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build

  install -d "$pkgdir"/usr/share/licenses
  ln -s /usr/share/licenses/qt6-declarative "$pkgdir"/usr/share/licenses/$pkgname
}
