pkgname=kpat-git
pkgver=0.0.0
pkgrel=1
provides=("kpat=${pkgver}")
conflicts=("kpat")
pkgdesc='Offers a selection of solitaire card games'
url='https://apps.kde.org/kpat/'
arch=(x86_64)
license=(GPL-2.0-or-later LGPL-2.0-or-later)
depends=(black-hole-solver
         freecell-solver
         glibc
         kcompletion
         kconfig
         kconfigwidgets
         kcoreaddons
         kcrash
         kdbusaddons
         kguiaddons
         ki18n
         kio
         knewstuff
         kwidgetsaddons
         kxmlgui
         libkdegames
         libstdc++
         qt6-base
         qt6-svg)
makedepends=(extra-cmake-modules
             kdoctools)
groups=(kde-applications
        kde-games)
source=("kpat::git+https://invent.kde.org/games/kpat.git")
sha256sums=('SKIP')
validpgpkeys=(CA262C6C83DE4D2FB28A332A3A6A4DB839EAA6D7  # Albert Astals Cid <aacid@kde.org>
              F23275E4BF10AFC1DF6914A6DBD2CE893E2D1C87  # Christoph Feck <cfeck@kde.org>
              D81C0CB38EB725EF6691C385BB463350D6EF31EF) # Heiko Becker <heiko.becker@kde.org>


pkgver() {
  cd "$srcdir/kpat"
  git describe --long --tags | sed -E 's/^v//;s/([^-]*-g)/r\1/;s/-/./g'
}

build() {
  export CFLAGS="${CFLAGS:-} -march=znver3 -mtune=znver3 -O3 -pipe -fno-plt"
  export CXXFLAGS="${CFLAGS}"
  cmake -B build -S kpat \
    -DBUILD_TESTING=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
