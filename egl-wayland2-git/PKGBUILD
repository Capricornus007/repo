# 六最搬運 2026-11-25：egl-wayland2（Arch extra 1.0.2-1 → git 尖端 dev branch）
# 為 nvidia-utils-beta 的依賴補鏈（rc4 內核升級後 nvidia 驅動需 DKMS 重編，
# DKMS 版 nvidia-beta-dkms 依賴 nvidia-utils-beta，後者依賴 egl-wayland2）。
# 來源：Arch packaging egl-wayland2（maintainer ptr1337/heftig）改 -git 尖端。
pkgname=egl-wayland2-git
_pkgname=egl-wayland2
pkgver=1.0.2.r7.ge76d3b7
pkgrel=1
pkgdesc='EGLStream-based Wayland external platform (2) — git dev tip (六最 znver3 LTO)'
arch=(x86_64)
url='https://github.com/NVIDIA/egl-wayland2'
license=(Apache-2.0)
depends=(eglexternalplatform mesa glibc libdrm wayland)
makedepends=(git meson wayland-protocols 'libglvnd>=1.3.4')
provides=("egl-wayland2=1.0.2" libnvidia-egl-wayland2.so)
conflicts=(egl-wayland2)
options=(lto !debug)
source=("$_pkgname::git+$url.git")
b2sums=('SKIP')

pkgver() {
  cd "$srcdir/$_pkgname"
  git describe --tags --long 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' || printf 'r%s' "$(git rev-parse --short HEAD)"
}

build() {
  cd "$srcdir/$_pkgname"
  arch-meson . build
  meson compile -C build
}

check() {
  cd "$srcdir/$_pkgname"
  meson test -C build --print-errorlogs || true
}

package() {
  cd "$srcdir/$_pkgname"
  meson install -C build --destdir "$pkgdir"
  install -Dt "$pkgdir/usr/share/licenses/$pkgname" -m644 LICENSE
}
