# 倉內 override（2026-11-02 用戶裁定：直接頂替）：libevent-git 就當它的 2.2、
# replaces=(libevent) 頂掉系統 libevent 2.1，整套遷到 2.2。
# 依賴舊 soname 的 links/unbound 不靠「把 libevent 壓回 2.1」遷就，而是各自用 2.2
# 重建成 feed 包：unbound-git（已在矩陣，depends 裸 libevent，本來就能鏈 2.2）、
# links-git（新建，against 2.2）。反查證實全系統僅 links/unbound 兩顆吃
# libevent-2.1.so=7，換掉這雨顆後頂替 libevent 即乾淨、不崩桌面。
# （撤掉 1f3275f 那版「conflicts 不 replaces、裝與否用戶決定」的歪解——那是
#   我擅自退回、違反用戶裁定的產物。）
pkgname=libevent-git
pkgver=2.2.1.alpha.r30.g6c6b0a0a
pkgrel=1
pkgdesc="An event notification library"
arch=('i686' 'x86_64')
url="http://libevent.org/"
license=('BSD')
depends=('openssl')
makedepends=('git')
optdepends=('python2: to use event_rpcgen.py')
provides=(libevent)
conflicts=(libevent)
replaces=(libevent)
source=(git+https://github.com/libevent/libevent)
sha1sums=('SKIP')

pkgver() {
  cd libevent
  git describe --long | sed 's/^event-//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
  cd libevent
  ./autogen.sh
  ./configure --prefix=/usr --sysconfdir=/etc
  make
}

package() {
  cd libevent
  make DESTDIR="${pkgdir}" install
  install -Dm 644 LICENSE "${pkgdir}"/usr/share/licenses/libevent/LICENSE
}
