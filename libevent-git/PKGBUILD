# 追上游 master（2.2），完整頂替系統 libevent 2.1；消費者須同步重建。
# strip release-，否則 pkgver 變成 release.2.2…，repo-add -p 判為降級而拒收，
# 部署清理接著刪掉未入庫產物。links/unbound/fstrm/libverto 明確依賴本包，
# 不讓同步庫的 libevent 2.1 冒充建置依賴。
pkgname=libevent-git
pkgver=2.2.2.alpha.r11.gd82464a2
pkgrel=1
pkgdesc="An event notification library"
arch=('i686' 'x86_64')
url="http://libevent.org/"
license=('BSD')
depends=('glibc' 'openssl')
makedepends=('git' 'autoconf' 'automake' 'libtool')
optdepends=('python2: to use event_rpcgen.py')
# 上游 2.2 的 SONAME major 為 1；精確提供 ABI，不冒充 2.1。
_libevent_bits=$(getconf LONG_BIT)
provides=('libevent' "libevent-2.2.so=1-${_libevent_bits}"
          "libevent_core-2.2.so=1-${_libevent_bits}" "libevent_extra-2.2.so=1-${_libevent_bits}"
          "libevent_openssl-2.2.so=1-${_libevent_bits}" "libevent_pthreads-2.2.so=1-${_libevent_bits}")
conflicts=(libevent)
replaces=(libevent)
source=(git+https://github.com/libevent/libevent)
sha1sums=('SKIP')

pkgver() {
  cd libevent
  git describe --long | sed 's/^release-//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
  cd libevent
  ./autogen.sh
  ./configure --prefix=/usr --sysconfdir=/etc
  make
}

package() {
  cd libevent
  make DESTDIR="${pkgdir}" install
  install -Dm 644 LICENSE "${pkgdir}"/usr/share/licenses/libevent/LICENSE
}
