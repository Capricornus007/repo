# 用戶 2026-10-06 指令「所有跟 go 有關的項目全去最尖端」：Artix 官方那顆是用
# Go 1.27.1（最新**正式**版）編的穩定版，這顆改吃上游分支尖端、並由本倉 CI 用
# 自有 go-git（1.28-devel）建置。取代穩定版靠 provides/conflicts/replaces 三件套
# （與 lmdb-git、qt6ct-git 同一手法），用戶 `pacman -Syu` 即平順換檔。
# ⚠️ 這是 in-tree 包：必須同時列進 build-packages.yml 的 in-tree 攔截分支，
#    否則通用規則見 '-git$' 會去 clone AUR（這幾個 AUR 全查無對應 -git 包）。

pkgname=glab-git
pkgver=1.120.0.r0.g0000000
pkgrel=1
pkgdesc="A GitLab CLI tool bringing GitLab to your command line"
arch=('x86_64')
url="https://gitlab.com/gitlab-org/cli"
license=('MIT')
depends=('glibc')
makedepends=('go' 'git')
provides=('glab')
conflicts=('glab')
replaces=('glab' 'gitlab-glab')
options=(!lto)
# 上游倉叫 cli → 目錄名要寫成 glab 才與通用版本探測對得上。
source=("glab::git+${url}.git")
sha256sums=('SKIP')

pkgver() {
  cd glab
  git describe --tags --long | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
  cd glab
  local _ver
  _ver=$(git describe --tags)
  export CGO_CPPFLAGS="$CPPFLAGS" CGO_CFLAGS="$CFLAGS" CGO_CXXFLAGS="$CXXFLAGS" CGO_LDFLAGS="$LDFLAGS"
  _builddate=${SOURCE_DATE_EPOCH:+$(date -u -d "@$SOURCE_DATE_EPOCH" +%m/%d/%Y)}
  _builddate=${_builddate:-$(date -u +%m/%d/%Y)}
  go build \
    -trimpath \
    -buildmode=pie \
    -mod=readonly \
    -modcacherw \
    -ldflags "-linkmode=external -extldflags \"$LDFLAGS\" -X main.version=$_ver -X main.build=$_builddate -X main.usageMode=prod -s -w" \
    -o glab ./cmd/glab
  go run ./cmd/gen-docs/docs.go --manpage --path ./
  for s in bash fish zsh; do
    ./glab completion -s $s > $s.completions
  done
}

package() {
  cd glab
  install -Dm0755 -t "$pkgdir/usr/bin/" glab
  install -Dm0644 -t "$pkgdir/usr/share/licenses/glab/" LICENSE
  install -Dm0644 -t "$pkgdir/usr/share/man/man1/" glab*.1
  install -Dm0644 bash.completions "$pkgdir/usr/share/bash-completion/completions/glab"
  install -Dm0644 fish.completions "$pkgdir/usr/share/fish/vendor_completions.d/glab.fish"
  install -Dm0644 zsh.completions  "$pkgdir/usr/share/zsh/site-functions/_glab"
}
