# JBR 25 —— 與 jbr21 同一套接法，差別只在版號與「建議／必須」的角色：
#   jbr21 是 nashira 執行期的**必須**項（`jvmTarget=JVM_21` → class 65）；
#   jbr25 是往後的相容性驗證用（JBR 25 跑得動 Java 21 位元碼，反之不然）。
# 兩者可共裝：都裝到 /opt/jbrNN，且**都不宣告 provides/conflicts=('jbr')**。
# 其餘設計理由（來源用官方 CDN、變體取 jbrsdk_jcef 才有 jmods、校驗和 SKIP、!strip、
# 命名不參考 AUR、為何不出 17）全部同 jbr21，見該目錄檔頭，此處不重複。
#
# ⚠️ 版號由 CI 的專屬探測算（build-packages.yml 的 `jbr21|jbr25)` 共用 case），
#    改寫步動的是本檔的 _pkgver／_build 兩行。本檔 pkgver 是佔位值、別當成上游現況。

_pkgver=25.0.4.1
_build=b623.69
_variant=jbrsdk_jcef
pkgname=jbr25
pkgver=${_pkgver}.${_build#b}
pkgrel=2
pkgdesc="JetBrains Runtime (JBR) 25 SDK with JCEF — 含 jmods 可 jlink，分版本可與其它 jbrNN 共裝"
arch=('x86_64')
url='https://github.com/JetBrains/JetBrainsRuntime'
license=('custom')
options=('!strip' '!debug' '!emptydirs')
source=("https://cache-redirector.jetbrains.com/intellij-jbr/${_variant}-${_pkgver}-linux-x64-${_build}.tar.gz")
sha256sums=('SKIP')

package() {
  local d="${_variant}-${_pkgver}-linux-x64-${_build}"
  install -dm755 "${pkgdir}/opt"
  cp -a "${srcdir}/${d}" "${pkgdir}/opt/${pkgname}"
  [ -d "${pkgdir}/opt/${pkgname}/jmods" ] || { echo "錯誤：${d} 內沒有 jmods/，變體選錯了，jlink 用不了" >&2; return 1; }
  install -dm755 "${pkgdir}/usr/lib/jvm"
  ln -s "/opt/${pkgname}" "${pkgdir}/usr/lib/jvm/${pkgname}"
}
