# Maintainer: Capricornus007 <capricornus007@users.noreply.github.com>
# 來源：archlinuxcn/repo（lilac 打包）。本包進 feed 的目的：接管 ALHP（fcitx5 兩顆）與 archlinuxcn lilac
# （python-cu2qu）在本機的更高 pkgrel 版本——epoch=1 讓 feed 版穩定壓過它們，
# 消掉每次 -Syu 的「local is newer than repo」警告；之後版本跟官方源同步。
# （2026-10-27 用戶裁定「跟著把 epoch 往上加」；同時是第三方倉收編的第一批。）

# Maintainer: Caleb Maclennan <caleb@alerque.com>
# Maintainer: Maintainer: Guillaume Horel <guillaume.horel@gmail.com>

_pyname=cu2qu
pkgname=python-$_pyname
pkgver=1.6.7.post2
epoch=1
pkgrel=7
pkgdesc='Cubic-to-quadratic bezier curve conversion'
arch=(any)
url="https://github.com/googlefonts/$_pyname"
license=(Apache-2.0)
_pydeps=(defcon
         fonttools
         fs)
depends=(python
         "${_pydeps[@]/#/python-}")
makedepends=(cython
             python-{build,installer,wheel}
             python-setuptools-scm)
checkdepends=(python-coverage
              python-pytest)
_archive="$_pyname-$pkgver"
source=("https://files.pythonhosted.org/packages/source/${_pyname::1}/$_pyname/$_archive.zip")
sha256sums=('1df562d99bd6059226088f443702bf51cfdd8cc63623f23137459a78d7bf5808')

build() {
	cd "$_archive"
	python -m build -wn
}

check() {
	cd "$_archive"
	# Wants deprecated pytest-runner stuff
	# pytest
}

package() {
	cd "$_archive"
	python -m installer -d "$pkgdir" dist/*.whl
}

