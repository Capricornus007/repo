# Maintainer: Capricornus007 <Capricornus007 at gmail dot com>

_pybasever=2.7
pkgname=python2-git
_pkgname=cpython   # ⚠️ 給 CI plan 步的 pkgver() 探測用：它會照 $pkgname/${pkgname%-git}/$_pkgname 等名字軟鏈到克隆目錄，少了這行就 `cd cpython` 失敗 → 本輪被跳過（實測 run 39821657583）
pkgver=2.7.18.r0.g000000000
pkgrel=1
pkgdesc="A high-level scripting language (built from the upstream 2.7 branch)"
arch=('x86_64' 'aarch64')
url="https://www.python.org/"
license=('PSF-2.0')
depends=('bzip2' 'expat' 'gdbm' 'libffi' 'libnsl' 'libxcrypt' 'openssl-1.1' 'sqlite' 'zlib')
makedepends=('tk' 'bluez-libs' 'git')
optdepends=('tk: for IDLE'
            'python2-setuptools'
            'python2-pip')
provides=('python2')
conflicts=('python2' 'python<3')
_gentoo_patches="python-gentoo-patches-${_pybasever}.18_p16"
source=("cpython::git+https://github.com/python/cpython#tag=v2.7.18"
        'mtime-workaround.patch'
        "https://distfiles.gentoo.org/distfiles/2d/$_gentoo_patches.tar.xz")
noextract=("$_gentoo_patches.tar.xz")
sha256sums=('SKIP'
            'SKIP'
            'SKIP')

# ── 為什麼做 -git 並收進本倉（2026-10-23，使用者明確指示）───────────────────
# 本機那顆 python2 來自 andontie-aur。
# ⚠️ 分支實況（2026-10-23 實查，第一版我在這裡猜錯過一次）：cpython **已經沒有 `2.7`
#   分支**了——`git ls-remote --heads https://github.com/python/cpython` 只有 8 條 head
#   （main 與 3.x 系），`2.7` 只以 tag 存在（refs/tags/2.7、refs/tags/v2.7.18）。
#   後果分兩面，而且兩面行為不同，這是這次 CI 紅的真正原因：
#     · plan 步的探測用 `git clone --branch 2.7` → git-clone 的 --branch 也吃 tag，
#       所以探測**成功**、build=true；
#     · makepkg 的 /usr/share/makepkg/source/git.sh 第 120 行把 `branch=X` 解析成
#       `origin/X`（遠端追蹤分支），tag 不會出現在那裡 →
#       `fatal: invalid reference: origin/2.7` → 紅（run 39822659311 實測）。
#   正解是寫 `#tag=v2.7.18`：git.sh 對 `tag=` 走 `ref=${fragment##*=}` 直接 checkout，
#   探測端也有 `tag=*)` 分支。Python 2 的「尖端」本來就等於最終發佈狀態 v2.7.18，
#   所以這顆的版號會是定值 2.7.18.r0.g<sha>；收進本倉的價值在「補丁與构建自己掌控、
#   不再依賴 andontie-aur」，不是追一個不存在的移動分支——這點講清楚，不含糊。
# 改成直接吃 2.7 分支 HEAD 之後，prepare() 用 _apply 逐條**證明**每條補丁的狀態：
#   · 套得上 → 套（這是打包用的修正，源碼裡沒有）
#   · 反向套得上（-R --dry-run 通過）→ 代表該變更**已在源碼裡**，跳過並印出名字
#   · 兩者都不行 → 直接 fail，不吞錯（絕不用 `|| true` 蒙混過去）
# 這樣「哪些補丁是多餘的」會在建置日誌裡留下逐條清單，而不是靠註解猜。
# 代價講清楚：2.7 分支 HEAD 的版號是 2.7.18.rN，比 AUR 那顆（2.7.18-19）大，
# 換來源時是升級、不是降級。

_apply() {   # _apply <補丁檔> <patch 層級旗標>
  local _p="$1" _f="$2"
  if patch $_f -N --dry-run -i "$_p" >/dev/null 2>&1; then
    patch $_f -N -i "$_p" || { echo "::error:: 套不上：$_p"; return 1; }
    echo "  已套用 $(basename "$_p")"
  elif patch $_f -R --dry-run -i "$_p" >/dev/null 2>&1; then
    echo "  跳過（變更已在 2.7 分支源碼裡）$(basename "$_p")"
  else
    echo "::error:: 既套不上、也還沒在源碼裡：$_p"
    return 1
  fi
}

pkgver() {
  cd cpython
  _d=$(git describe --long --tags --match 'v2.7.*' 2>/dev/null) && {
    printf '%s' "${_d#v}" | sed 's/\([^-]*-g\)/r\1/;s/-/./g'; return 0; }
  # 同 qt4-git：探測失敗不能只讓 plan 跳過就好，退回總提交數保證有號
  printf '2.7.18.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=9 HEAD)"
}

prepare() {
  local _sd="$srcdir"
  bsdtar -xf "$_gentoo_patches.tar.xz" -s "/$_gentoo_patches//"

  cd cpython

  # makepkg 會把所有檔案 touch 到 SOURCE_DATE_EPOCH，這會弄壞 pyc 的 mtime 檢查；
  # 這條是 AUR 那顆就有的 workaround，不是上游東西。
  _apply "${srcdir}/mtime-workaround.patch" -p0 || return 1

  # 安全修正 backport（2.7 分支多半已含，交給 _apply 逐條判定）
  local _cve
  for _cve in \
    0001-bpo-39017-Avoid-infinite-loop-in-the-tarfile-module-.patch \
    0002-bpo-39503-CVE-2020-8492-Fix-AbstractBasicAuthHandler.patch \
    0003-bpo-39603-Prevent-header-injection-in-http-methods-G.patch \
    0004-bpo-42051-Reject-XML-entity-declarations-in-plist-fi.patch \
    0005-bpo-41944-No-longer-call-eval-on-content-received-vi.patch \
    0006-bpo-40791-Make-compare_digest-more-constant-time.-GH.patch \
    0007-3.6-closes-bpo-42938-Replace-snprintf-with-Python-un.patch \
    0008-3.6-bpo-42967-only-use-as-a-query-string-separator-G.patch \
    0009-py2-ize-the-CJK-codec-test.patch \
    0010-3.6-bpo-43285-Make-ftplib-not-trust-the-PASV-respons.patch \
    0011-bpo-43075-Fix-ReDoS-in-urllib-AbstractBasicAuthHandl.patch \
    0012-3.9-bpo-43882-urllib.parse-should-sanitize-urls-cont.patch \
    0013-Backport-bpo-44022-Fix-http-client-infinite-line-rea.patch \
    0014-bpo-43124-Fix-smtplib-multiple-CRLF-injection-GH-259.patch \
    0015-bpo-42278-Use-tempfile.TemporaryDirectory-rather-tha.patch \
    0016-Fix-accidentally-leaving-one-sub-test-commented-out.patch \
    0017-bpo-46811-Make-test-suite-support-Expat-2.4.5-GH-314.patch \
    0018-bpo-46756-Fix-authorization-check-in-urllib.request-.patch
  do
    _apply "$_sd/$_cve" -p1 || return 1
  done

  # 打包與建置修正（這些源碼裡沒有，必須套得上）
  local _pkg
  for _pkg in \
    0019-Install-libpythonX.Y.a-in-usr-lib-instead-of-usr-lib.patch \
    0020-Disable-modules-and-SSL.patch \
    0024-Regenerate-platform-specific-modules.patch \
    0026-Turkish-locale.patch \
    0027-ARM-OABI.patch \
    0028-use_pyxml.patch \
    0029-Disable-nis.patch \
    0031-Use-ncurses-to-find-pkg-config.patch \
    0032-Use-specific-Werror-for-cross-compile-tests.patch \
    0033-Force-using-system-libffi.patch \
    0034-test.support.unlink-ignore-EACCES.patch \
    0035-ssl-Hard-disable-SSLv3-to-avoid-automagic-deps.patch \
    0036-Fix-Wimplicit-int-Wimplicit-function-declaration.patch
  do
    _apply "$_sd/$_pkg" -p1 || return 1
  done

  # FS#22322 / FS#22122 / FS#23997（照 AUR 那份）
  sed -i "/progname =/s/python/python${_pybasever}/" Python/pythonrun.c
  sed -i "/SQLITE_OMIT_LOAD_EXTENSION/d" setup.py
  sed -i -e "s|^#.* /usr/local/bin/python|#!/usr/bin/python2|" Lib/cgi.py
  sed -i "s/python2.3/python2/g" Lib/distutils/tests/test_build_scripts.py \
    Lib/distutils/tests/test_install_scripts.py

  # 一律用系統的 expat/zlib/libffi，不用 tarball 內建的副本
  rm -rf Modules/expat Modules/zlib Modules/_ctypes/darwin* Modules/_ctypes/libffi*

  find . -name '*.py' | xargs sed -i "s|#[ ]*![ ]*/usr/bin/env python$|#!/usr/bin/env python2|"
  touch Include/Python-ast.h Python/Python-ast.c Python/opcode_targets.h
}

build() {
  cd cpython
  CFLAGS+=" -std=c17"
  CPPFLAGS+=" -I/usr/include/openssl-1.1"
  LDFLAGS+=" -L/usr/lib/openssl-1.1"
  export OPT="${CFLAGS}"
  ./configure --prefix=/usr \
              --enable-shared \
              --with-threads \
              --enable-optimizations \
              --with-lto \
              --enable-ipv6 \
              --enable-unicode=ucs4 \
              --with-system-expat \
              --with-system-ffi \
              --with-dbmliborder=gdbm:ndbm \
              --without-ensurepip

  make
}

package() {
  cd cpython

  # Hack to avoid building again
  sed -i 's/^all:.*$/all: build_all/' Makefile

  make DESTDIR="${pkgdir}" altinstall maninstall

  rm "${pkgdir}"/usr/share/man/man1/python.1

  ln -sf python${_pybasever}        "${pkgdir}"/usr/bin/python2
  ln -sf python${_pybasever}-config "${pkgdir}"/usr/bin/python2-config
  ln -sf python${_pybasever}.1      "${pkgdir}"/usr/share/man/man1/python2.1
  ln -sf python-${_pybasever}.pc    "${pkgdir}"/usr/lib/pkgconfig/python2.pc
  ln -sf ../../libpython${_pybasever}.so \
    "${pkgdir}"/usr/lib/python${_pybasever}/config/libpython${_pybasever}.so

  mv "${pkgdir}"/usr/bin/smtpd.py "${pkgdir}"/usr/lib/python${_pybasever}/

  install -dm755 "${pkgdir}"/usr/lib/python${_pybasever}/Tools/{i18n,scripts}
  install -m755 Tools/i18n/{msgfmt,pygettext}.py \
    "${pkgdir}"/usr/lib/python${_pybasever}/Tools/i18n/
  install -m755 Tools/scripts/{README,*py} \
    "${pkgdir}"/usr/lib/python${_pybasever}/Tools/scripts/

  # 避免跟 python3 打架
  mv "${pkgdir}"/usr/bin/idle{,2}
  mv "${pkgdir}"/usr/bin/pydoc{,2}
  mv "${pkgdir}"/usr/bin/2to3{,-2.7}

  sed -i "s#${srcdir}/cpython:##" "${pkgdir}"/usr/lib/python${_pybasever}/config/Makefile
}
