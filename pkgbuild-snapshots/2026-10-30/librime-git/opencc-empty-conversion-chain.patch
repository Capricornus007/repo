 namespace rime {
 
+namespace {
+// OpenCC 的 converter 在「沒有 conversion chain」的配置下會回空鏈或 nullptr，
+// 直接解引用就是崩潰（librime#1184 修的是舊檔位；8c5094fa 把 rime::Opencc 搬到
+// 本檔之後，那三處防護跟著消失了）。統一走這裡，空值一律回空清單。
+list<opencc::ConversionPtr> ConversionsOf(const opencc::ConverterPtr& converter) {
+  if (converter == nullptr)
+    return {};
+  opencc::ConversionChainPtr chain = converter->GetConversionChain();
+  if (chain == nullptr)
+    return {};
+  return chain->GetConversions();
+}
