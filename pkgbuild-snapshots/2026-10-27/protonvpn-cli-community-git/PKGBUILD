# Maintainer: Yurii Kolesnykov <root@yurikoles.com>
# Based on protonvpn-cli-ng by Nate Ijams ~ exprez135 <exprezdev at pm dot me>
# Modified: 上游换成 jonasjancarik 的续命 fork（原版已归档），且 fork 没有
# setup.py，构建改为 PEP 517（python -m build + installer）。

pkgname=protonvpn-cli-community-git
_oldpkgname=protonvpn-cli-ng-git
pkgver=3.2.2.r1.g7e1782c
pkgrel=1
pkgdesc="A Community Linux CLI for ProtonVPN"
arch=("any")
url="https://github.com/jonasjancarik/protonvpn-cli-community"
license=("GPL3")
depends=("openvpn" "dialog" "python-pythondialog" "python-docopt"
		 "python-requests" "python-jinja" "python-fastapi" "uvicorn"
		 "python-pydantic" "python-proton-core" "python-proton-vpn-api-core")
makedepends=("git" "python-build" "python-installer" "python-setuptools")
provides=("${pkgname%-git}=${pkgver}" "${_oldpkgname}")
conflicts=("protonvpn-cli" "protonvpn-gui" "${pkgname%-git}" "${_oldpkgname}")
replaces=("${_oldpkgname}")
source=("git+${url}")
sha256sums=('SKIP')
# makepkg 的 git source 目录取 URL 的 basename（protonvpn-cli-community），
# 不是上游原来的仓库名 linux-cli-community
_src_name=protonvpn-cli-community

pkgver() {
	cd "${_src_name}"
	# fork 自己额外打了个 latest tag（与 v3.2.2 同一个提交），不排除的话
	# describe 会锚定到它，版本号变成 latest.rN.gXXX 而不是 X.Y.Z.rN.gXXX
	git describe --long --tags --exclude 'latest' | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
	cd "${_src_name}"
	python -m build --wheel --no-isolation
}

package() {
	cd "${_src_name}"
	python -m installer -d "${pkgdir}" dist/*.whl
}
