# Maintainer: Capricornus007
# Fork 自 Artix openrc-world 的 nvidia-utils-openrc 20210505-2
# （原檔 https://gitea.artixlinux.org/artixlinux/packages-openrc ，內容一概保留），
# 只補一件事：nvidia-utils 的 elogind 睡眠鉤子只有 post、沒有 pre，
# 而 pre 在上游是 systemd unit 的活 → OpenRC 環境下 suspend 必然被 GPU 否決
# （nv_pmops_suspend returns -5）。見 90-nvidia-sleep。
#
# ✅ 2026-10-07 起正式進 CI（build-kernels.yml 的套件清單，kind=artix +
#    artixlinux/artixlinux:base-devel 容器）。舊註解寫「刻意不進矩陣，因為 Arch
#    容器沒有 openrc 鏡像必紅」——那個前提已經被 qt6ct-git 那輪換代打掉：
#    kind=artix 的 job 跑在同發行版容器裡，[system] 原生就有 openrc／elogind，
#    nvidia-utils 在 [world]，所以不需要再靠「本地 makepkg + pacman -U」手工發佈。
#    會留這條註解是因為實測到 feed 停在 20261005-1、本機已是 -2：沒有矩陣就沒人
#    重建 -2，重灌機器會拿到「沒有 pre 分支 → 睡眠被 GPU 否決」的舊版。
pkgname=nvidia-utils-openrc
pkgver=20261005
pkgrel=2
pkgdesc="OpenRC glue for NVIDIA: persistenced init script + the missing pre branch of the elogind sleep hook"
arch=('any')
url="https://gitea.artixlinux.org/artixlinux/packages-openrc"
license=('GPL2')
depends=('openrc' 'nvidia-utils' 'elogind')
provides=('init-nvidia-utils')
conflicts=('init-nvidia-utils')
backup=('etc/conf.d/nvidia-persistenced')
source=(
	'nvidia-persistenced.confd'
	'nvidia-persistenced.initd'
	'90-nvidia-sleep'
)
sha256sums=('347437868119e8ae12852a574597936e855f534a9ad290fef3f62b4083a38516'
            'b672a70260d1370f462d3f0f9e027708118bb46e087c2be63890e97260dd2686'
            '2b850e25d9bfe0f98a0cd188d58b78baba66e9e85f97e89e405e297b6d90a5dc')

package() {
	install -d "${pkgdir}/etc/conf.d"
	install -d "${pkgdir}/etc/init.d"
	install -d "${pkgdir}/usr/lib/elogind/system-sleep"

	install -m 644 "${srcdir}/nvidia-persistenced.confd" \
		"${pkgdir}/etc/conf.d/nvidia-persistenced"
	install -m 755 "${srcdir}/nvidia-persistenced.initd" \
		"${pkgdir}/etc/init.d/nvidia-persistenced"
	install -m 755 "${srcdir}/90-nvidia-sleep" \
		"${pkgdir}/usr/lib/elogind/system-sleep/90-nvidia-sleep"
}
