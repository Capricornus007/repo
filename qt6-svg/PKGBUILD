# 2026-11-22 in-tree（MLFS 系统装 flameshot-git 的依赖链）：官方 extra 6.12.0 原样转发。
# AUR 无 qt6-svg-git（官方静态版本包）。包名保持 qt6-svg，满足 flameshot depends 字面名。
# 依赖 qt6-base 由同批 in-tree 的 qt6-base-git 提供。
pkgname=qt6-svg
pkgver=6.12.0
pkgrel=1
pkgdesc='Classes for displaying and creating SVG content'
arch=(x86_64)
url='https://www.qt.io'
license=(GPL-2.0-only LGPL-3.0-only)
depends=(glibc
         gcc-libs
         qt6-base)
makedepends=(cmake
             ninja)
source=(https://download.qt.io/official_releases/qt/${pkgver%.*}/${pkgver}/submodules/qtsvg-everywhere-src-${pkgver}.tar.xz)
sha256sums=('e4ab39534ec97987b1b9b60ef7f4d3253d5912a69f8c713a01753174a4029331')

build() {
  cmake -B build -S qtsvg-everywhere-src-${pkgver} -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DQT_BUILD_TESTS=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
