# 2026-11-25 in-tree（AUR 刪包搶救）：AUR 的 nss-git 已刪除（RPC 查無、clone 空倉），
# 改由本倉構建。基於 Arch 官方 nss PKGBUILD 轉 -git，保留官方建置邏輯
# （certdata2pem.py 換內建信任、bundle.sh 出 ca-bundle、nss.pc/nss-config 手工生成）：
#  1. source 由 hg+hg.mozilla.org 改 git+https://github.com/nss-dev/nss.git（官方 GitHub mirror，
#     tag 命名同為 NSS_x_y_z_RTM）
#  2. 加 pkgver()（git describe，去 NSS_ 前綴與 _RTM 後綴）
#  3. makedepends 的 mercurial 換成 git
pkgbase=nss-git
pkgname=(
  nss-git
  ca-certificates-mozilla-git
)
pkgver=3.134
pkgrel=1
pkgdesc="Network Security Services"
url="https://firefox-source-docs.mozilla.org/security/nss/index.html"
arch=(x86_64)
license=(MPL-2.0)
depends=(
  glibc
  libgcc
  libstdc++
  nspr
  p11-kit
  sh
  sqlite
)
makedepends=(
  git
  gyp
  perl
  python
)
source=(
  "git+https://github.com/nss-dev/nss.git"
  bundle.sh
  certdata2pem.py
)
b2sums=('SKIP'
        '4be5dd836c844fdd7b63302a6994d62149082c3bc81eef70f373f416fed80a61a923960e4390d1c391b81ab01b409370d788818a30ffdd3a4ed467b670f990f6'
        '6bb59dcc9289916dcbf8fb6d73db0c0cd7582dc12a3aa4e8be19ec62c9ede65fdd9470a2d92ec5a114506b78d2d21b8ae0a1b45a17dc1f90f7d75434a93da510')

# 下游 depends 裸名 nss / ca-certificates-mozilla，沒這幾行 pacman 解析不到
provides=('nss' 'ca-certificates-mozilla')
conflicts=('nss' 'ca-certificates-mozilla')

pkgver() {
  cd nss
  git describe --long --tags | sed 's/^NSS_//;s/_RTM//;s/\([^-]*-g\)/r\1/;s/-/./g;s/_/./g'
}

prepare() {
  mkdir -p certs
  ln -srft certs nss/lib/ckfw/builtins/{certdata.txt,nssckbi.h}

  cd nss
}

build() {
  local buildsh_options=(
    --disable-tests
    --enable-libpkix
    --opt
    --system-nspr
    --system-sqlite
  )

  # 2026-11-25：in-tree 檔案經 Contents API（raw）下載會丟失執行位，
  # run 45683404559 實測「../certdata2pem.py: Permission denied」→ 補 chmod。
  chmod +x ../certdata2pem.py ../bundle.sh

  cd certs
  ../certdata2pem.py

  cd ..
  ./bundle.sh

  cd nss
  ./build.sh "${buildsh_options[@]}"
}

package_nss-git() {
  local nsprver="$(pkg-config --modversion nspr)"
  local libdir=/usr/lib includedir=/usr/include/nss

  sed nss/pkg/pkg-config/nss.pc.in \
    -e "s,%prefix%,/usr,g" \
    -e "s,%exec_prefix%,\${prefix},g" \
    -e "s,%libdir%,$libdir,g" \
    -e "s,%includedir%,$includedir,g" \
    -e "s,%NSPR_VERSION%,$nsprver,g" \
    -e "s,%NSS_VERSION%,$pkgver,g" |
    install -Dm644 /dev/stdin "$pkgdir$libdir/pkgconfig/nss.pc"

  ln -s nss.pc "$pkgdir$libdir/pkgconfig/mozilla-nss.pc"

  install -Dt "$pkgdir$libdir" dist/Release/lib/*.so

  local vmajor vminor vpatch
  { read vmajor; read vminor; read vpatch; } \
    < <(awk '/#define.*NSS_V(MAJOR|MINOR|PATCH)/ {print $3}' nss/lib/nss/nss.h)

  sed nss/pkg/pkg-config/nss-config.in \
    -e "s,@prefix@,/usr,g" \
    -e "s,@exec_prefix@,/usr,g" \
    -e "s,@libdir@,$libdir,g" \
    -e "s,@includedir@,$includedir,g" \
    -e "s,@MOD_MAJOR_VERSION@,$vmajor,g" \
    -e "s,@MOD_MINOR_VERSION@,$vminor,g" \
    -e "s,@MOD_PATCH_VERSION@,$vpatch,g" |
    install -D /dev/stdin "$pkgdir/usr/bin/nss-config"

  install -Dt "$pkgdir/usr/bin" \
    dist/Release/bin/{*util,nss,shlibsign,signver,ssltap}

  install -Dt "$pkgdir$includedir" -m644 dist/public/nss/*.h

  install -Dt "$pkgdir/usr/share/man/man1" -m644 \
    nss/doc/nroff/{*util,signver,ssltap}.1

  # Replace built-in trust with p11-kit connection
  ln -sf pkcs11/p11-kit-trust.so "$pkgdir$libdir/libnssckbi.so"
}

package_ca-certificates-mozilla-git() {
  pkgdesc="Mozilla's set of trusted CA certificates"
  depends=('ca-certificates-utils>=20181109-3')

  install -Dm644 ca-bundle.trust.p11-kit \
    "$pkgdir/usr/share/ca-certificates/trust-source/mozilla.trust.p11-kit"
}

