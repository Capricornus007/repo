# Maintainer: Capricornus007 <contact@capricornus007.com>
# Serein（ViceVerse-cz/Serein，非官方 Discord 桌面客戶端，Rust + GTK4 + webkitgtk）。
# 對照物是 AUR 的 `serein`（https://aur.archlinux.org/packages/serein，
# 維護者 Nguyen Ky）：依賴清單、build 流程（cargo xtask package --format dir）與
# `pre.nightly` 版號轉換全部照搬，本檔只改兩件事——
#   1. 版號不再寫死：`_upver` 由 CI plan 步從上游 release/tag 現算（取「發布時間最新」
#      那顆，不是字串排序最大——上游 tag 命名混了 `v1.0.0-nightly.10.1` 這種舊式與
#      `v1.0.0-nightly.20261001.53` 這種日期式，`sort -V` 會把兩者混在一起比大小），
#      算到新版就回推本檔（見 build-packages.yml 的 serein 分支）。
#   2. 把 systemd 相關的東西全部擋在門外。本機 Artix 啟用的倉裡 `systemd`／
#      `systemd-libs`／`libsystemd` 三顆**都查無**（實測 `pacman -Si` 三者皆
#      "package was not found"，替代是 `elogind`），依賴一旦沾上就裝不起來。
#
# 為什麼不走上游自己附的 `packaging/aur/PKGBUILD`（那是 `serein-bin`，prebuilt nightly）：
# 它的 depends 明列 `systemd-libs>=262-1`（第 135 行），在 Artix 直接無解 → 只能從源碼建。
# 從源碼建的這條線是乾淨的：AUR .SRCINFO 的 depends 裡沒有任何 systemd／elogind／
# sd_notify 條目，上游 Cargo.lock（9466 行）也搜不到 systemd 系 crate（Rust 側不經
# libsystemd 取 DBus），`packaging/` 下也沒有 systemd unit。
# package() 尾那道檢查是把上面這段「查證」變成**會紅的閘門**：哪天上游改版把
# usr/lib/systemd/** 塞進 dist/linux-root，構建立刻失敗，而不是靜默產出一顆裝不起來的包。

_upstream='ViceVerse-cz/Serein'
pkgname=serein
# 唯一版號來源：上游 nightly tag 拿掉前綴 v。pkgver 由這一行展開（jbr21／jbr25 同款
# 教訓：CI 只 sed ^pkgver= 會做出「新版號、舊 tag」的包，所以回推改的是這一行）。
_upver='1.0.0-nightly.20261001.53'
pkgver="${_upver/-/pre.}"
pkgrel=2
pkgdesc='Unofficial native Discord client'
arch=('x86_64')
url="https://github.com/${_upstream}"
license=('MIT' 'Apache-2.0')
depends=(
    'alsa-lib'
    'dbus'
    'glib2'
    'glibc'
    'gst-plugin-pipewire'
    'gst-plugins-base'
    'gst-plugins-base-libs'
    'gst-plugins-good'
    'gstreamer'
    'gtk4'
    'hicolor-icon-theme'
    'libgcc'
    'libpulse'
    'libsoup3'
    'libstdc++'
    'libxkbcommon-x11'
    'webkitgtk-6.0'
    'xdg-desktop-portal'
)
makedepends=('cmake' 'desktop-file-utils' 'git' 'pkgconf' 'python' 'rust')
optdepends=(
    'gnome-keyring: Secret Service credential provider'
    'gst-plugins-bad: hardware screen encoding'
    'gst-libav: inline video'
    'xdg-desktop-portal-gtk: screen sharing and global shortcuts on GTK desktops'
    'xdg-desktop-portal-kde: screen sharing and global shortcuts on KDE Plasma'
)
options=('!debug' '!lto')
source=("$pkgname::git+https://github.com/${_upstream}.git#tag=v$_upver")
sha256sums=('SKIP')

prepare() {
    cd "$srcdir/$pkgname"
    # 上游的版號燒錄腳本，要吃的就是去掉 v 的原始 tag（含 `-`，不是 pkgver 那個形）。
    python3 .github/release/version.py "$_upver"
}

build() {
    cd "$srcdir/$pkgname"
    rm -rf -- dist
    cargo xtask package --format dir
}

package() {
    cd "$srcdir/$pkgname"
    install -d "$pkgdir"
    cp -a -- dist/linux-root/usr "$pkgdir/"
    install -d "$pkgdir/usr/share/licenses/$pkgname"
    install -m644 LICENSE-MIT LICENSE-APACHE "$pkgdir/usr/share/licenses/$pkgname/"

    # Artix 閘門：產物裡出現任何 systemd 單檔就判失敗（詳見檔頭第 2 點）。
    # 注意 find 對不存在的目錄會回非零，而 makepkg 的 package() 跑在 errexit 下——
    # 直接 `find "$pkgdir/usr/lib/systemd" ...` 會在「沒有 systemd 檔」（正常情況）
    # 時讓整個 package() 靜默中止（CI 實測：日誌只有 "A failure occurred in package()"、
    # 一行錯誤都沒有）。所以先判目錄在不在，再把 find 的退出碼吃掉。
    local _unit=""
    if [ -d "$pkgdir/usr/lib/systemd" ]; then
      _unit="$(find "$pkgdir/usr/lib/systemd" -type f -print -quit 2>/dev/null || true)"
    fi
    if [ -n "$_unit" ]; then
        echo "錯誤：產物含 systemd 檔案（$_unit），本倉的 Artix 版不接受 systemd 依賴。" >&2
        echo "      處置：確認上游是否新增了 unit／依賴；必要時在 package() 裡移除該檔，" >&2
        echo "      而不是把 systemd-libs 加回 depends。" >&2
        return 1
    fi
    echo "systemd 閘門：產物內無 usr/lib/systemd/** 檔案（Artix 可裝）"
}
