# 來源：Arch 官方 python-brotli（gitlab.archlinux.org/archlinux/packaging/packages/python-brotli）
# 為基底轉 git 源；構建方式與本倉 brotli-git/ 分包的 python 子包一致（倉庫根目錄的
# setup.py 自帶 brotli C 源編譯，USE_SYSTEM_BROTLI 未設時不碰 pkgconfig，產出物自足）。
# 契約：provides/conflicts python-brotli，滿足依賴 python-brotli 的下游。
# 注意：本倉 brotli-git/（split）也會產出同名 python-brotli-git；兩者擇一安裝，
# 檔案同路徑，同時裝會檔案衝突（pacman 會擋，不會靜默覆蓋）。
# AUR 現況（2026-11-26 實查）：python-brotli-git 仍是 brotli-git 的分包、AUR 倉活著；
# 「ls-remote python-brotli-git.git 為空」同樣是 AUR 以 pkgbase 命名的常規現象。
# in-tree 化的價值：不依賴 AUR 與本倉 brotli-git 的建置狀態，獨立出包。

pkgname=python-brotli-git
pkgver=1.2.0.r25.g61af0e5
pkgrel=1
pkgdesc="Brotli compression library (Python bindings, git master)"
arch=('i686' 'x86_64')
url="https://github.com/google/brotli"
license=('MIT')
depends=('glibc' 'python')
makedepends=('git' 'python-build' 'python-installer' 'python-setuptools' 'python-wheel')
provides=("python-brotli=$pkgver")
conflicts=('python-brotli')
source=("git+https://github.com/google/brotli.git")
sha256sums=('SKIP')

pkgver() {
  cd "brotli"

  _tag=$(git tag -l --sort -v:refname | grep -E '^v?[0-9\.]+$' | head -n1)
  _rev=$(git rev-list --count "$_tag"..HEAD)
  _hash=$(git rev-parse --short HEAD)
  printf "%s.r%s.g%s" "$_tag" "$_rev" "$_hash" | sed 's/^v//'
}

build() {
  cd "brotli"

  python -m build --wheel --no-isolation
}

check() {
  # 模組要裝進 $pkgdir 才能驗；與 brotli-git 分包同款留空。
  cd "brotli"
}

package() {
  cd "brotli"

  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 "LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname"
}
# vim:set ts=2 sw=2 et:
