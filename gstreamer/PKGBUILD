    "gst-plugins-bad-libs=$pkgver-$pkgrel"
    "gst-plugins-base-libs=$pkgver-$pkgrel"
    "gstreamer=$pkgver-$pkgrel"
    glib2
    glibc
    libgudev
    libva
  )
  replaces=('gstreamer-vaapi<=1.26.10-5')

  cd root; local files=(
    usr/lib/gstreamer-1.0/libgstva.so
  ); _install
}

