prepare() {
  cd gstreamer

  local src
  for src in "${source[@]}"; do
    src="${src%%::*}"
    src="${src##*/}"
    src="${src%.zst}"
    [[ $src = *.patch ]] || continue
    echo "Applying patch $src..."
    git apply -3 < "../$src"
  done

  cargo fetch --locked --target host-tuple \
    --manifest-path subprojects/gst-devtools/dots-viewer/Cargo.toml
}

build() {
  local meson_options=(
    -D benchmarks=disabled
    -D examples=disabled
    -D glib_debug=disabled
    -D gpl=enabled
    -D gst-devtools:debug_viewer=enabled
    -D gst-examples=disabled
    -D gst-plugins-bad:aja=disabled
    -D gst-plugins-bad:amfcodec=disabled
    -D gst-plugins-bad:androidmedia=disabled
    -D gst-plugins-bad:cuda-nvmm=disabled
    -D gst-plugins-bad:directfb=disabled
    -D gst-plugins-bad:directshow=disabled
    -D gst-plugins-bad:flite=disabled
    -D gst-plugins-bad:gs=disabled
    -D gst-plugins-bad:iqa=disabled
    -D gst-plugins-bad:isac=disabled
    -D gst-plugins-bad:lcevcdecoder=disabled
    -D gst-plugins-bad:lcevcencoder=disabled
    -D gst-plugins-bad:magicleap=disabled
    -D gst-plugins-bad:mfx_api=oneVPL
    -D gst-plugins-bad:mpeghdec=disabled
    -D gst-plugins-bad:nvcomp=disabled
    -D gst-plugins-bad:nvdswrapper=disabled
    -D gst-plugins-bad:openni2=disabled
    -D gst-plugins-bad:opensles=disabled
    -D gst-plugins-bad:qt6d3d11=disabled
    -D gst-plugins-bad:svtjpegxs=disabled
    -D gst-plugins-bad:tflite=disabled
    -D gst-plugins-bad:tinyalsa=disabled
    -D gst-plugins-bad:voaacenc=disabled
    -D gst-plugins-bad:voamrwbenc=disabled
    -D gst-plugins-bad:wasapi2=disabled
    -D gst-plugins-bad:wasapi=disabled
    -D gst-plugins-bad:wpe=disabled
    -D gst-plugins-base:libvisual=disabled
    -D gst-plugins-base:tremor=disabled
    -D gst-plugins-good:rpicamsrc=disabled
    -D gst-plugins-ugly:sidplay=disabled
    -D gstreamer:dbghelp=disabled
    -D gstreamer:ptp-helper-permissions=capabilities
    -D libnice=disabled
    -D orc-source=system
    -D package-name="Arch Linux GStreamer ${epoch:+$epoch:}$pkgver-$pkgrel"
    -D package-origin="https://www.archlinux.org/"
  )

  if [[ ${CARCH} != x86_64* ]]; then
    meson_options+=(-D gst-plugins-bad:svthevcenc=disabled)
  fi

  arch-meson gstreamer build "${meson_options[@]}"
  meson compile -C build
}

check() (
  export XDG_RUNTIME_DIR="$PWD/runtime-dir"
  mkdir -p -m 700 "$XDG_RUNTIME_DIR"

  export CK_TIMEOUT_MULTIPLIER=5
  export NO_AT_BRIDGE=1 GTK_A11Y=none

  # ── elements_gdkpixbufoverlay 的真因（2026-10-09 #408 定案，取代上一輪的觀測塊）
  # Arch 的 gdk-pixbuf 2.44 已把 jpg/png 等解碼全部交給 glycin——本機實物：
  # /usr/lib/gdk-pixbuf-2.0/2.10.0/loaders/ 只剩 io-wmf.so（屬 libwmf）、loaders.cache 空。
  # 而 glycin 的設計就是「一定要在 bwrap 沙箱裡跑解碼器」，#408 日誌裡那串
  # `bwrap --unshare-all ... --seccomp 13 /usr/lib/glycin-loaders/2+/glycin-image-rs`
  # 回 `Loader process exited early with status '1'` 就是沙箱起不來，不是載不到圖。
  # 對照實測：同一張圖（上游 tests/files/image.jpg，3017 bytes）在本機
  # `glycin-thumbnailer -i file://… -s 24` 解碼成功、產出 513 bytes PNG、rc=0。
  # → 這條測試實際測的是「建置環境能不能起 bwrap」，所以修法是補環境前提
  #   （checkdepends 已顯式列出 glycin + bubblewrap），不是跳測試。
  # 下面這三行永久保留：以後這條再紅，先看它印什麼，就能立刻分清是環境又掉了
  # 還是真的退回代碼問題，不必再燒一輪 50 分鐘的構建去猜。
  echo ">> 沙箱前提：bwrap=$(command -v bwrap || echo '缺')  glycin-loader=$([ -x /usr/lib/glycin-loaders/2+/glycin-image-rs ] && echo 有 || echo 缺)"
  # ⚠️ 探針的綁法必須照 glycin 實際那串來，否則會報假紅：本機實測
  # `--ro-bind /usr /usr` 不加 `--symlink /usr/lib /lib64` 時，連 /usr/bin/true 都
  # execvp 不成功（缺動態連結器），看起來像「沙箱壞了」其實是探針自己少綁東西。
  # #409 實測：套件齊（bubblewrap 0.13.0-1、glycin 2.2.2-1 都裝上了）、執行檔在
  # （/usr/sbin/bwrap），但探針仍 rc=1 → 缺的不是套件，是容器起不了 namespace。
  # 所以這裡把 bwrap 的 stderr 與三個內核能力一起印出來，一次定案是哪一層擋的。
  # ⚠️ errexit：bwrap 這行一定要用 `&& x || y` 兜住，否則它回非零會讓整個 check()
  # 在幾毫秒內中止、一行都不印（#407 實測過同一個坑）。用 `|| true` 則會把 $? 吃掉，
  # 所以把返回碼先接進變數再印。
  local brw=0
  bwrap --unshare-all --ro-bind /usr /usr --symlink /usr/lib /lib64 --dev /dev --proc /proc /usr/bin/true 2>/tmp/gst-bwrap-err.txt || brw=$?
  echo ">> 沙箱前提：bwrap rc=$brw  stderr=$(tail -3 /tmp/gst-bwrap-err.txt 2>/dev/null | tr '\n' '|')"
  echo ">> 內核能力：max_user_ns=$(cat /proc/sys/user/max_user_namespaces 2>/dev/null || echo 查無)  unprivileged_userns_clone=$(cat /proc/sys/kernel/unprivileged_userns_clone 2>/dev/null || echo '此核心無此檔')  CapEff=$(awk '/CapEff/{print $2}' /proc/self/status 2>/dev/null)"

  # ── 沙箱起不來時，本次 check 改走上游自己的「無沙箱」路徑（#413 定案）
  # 實測：bwrap 0.13 在容器裡能建 namespace、但拿到的是沒有 CAP_NET_ADMIN 的 netns，
  # 死在設定 loopback：`bwrap: loopback: Failed RTM_NEWADDR: Operation not permitted`。
  # glycin 的可用性偵測只認這幾個字串：Creating new namespace failed／
  # No permissions to create (a new) namespace／setting up uid map: Permission denied／
  # SIGSYS／Blocked syscall used——RTM_NEWADDR 那串不在裡面，所以它以為沙箱能用，
  # 直接去跑解碼器，測試就紅在「載不进圖」。
  # 給 bwrap 上 file capabilities 也走不通（#413 實測 setcap 成功後 bwrap 自己拒斥：
  # `Unexpected capabilities but not setuid, old file caps config?`），容器又不能
  # 改 cap_add／掛載選項，所以這裡用 glycin 官方留的環境變數 GLYCIN_DISABLE_SANDBOX
  # 明確降級，而且只在探針實際失敗時才設——本機 bwrap rc=0，一樣跑沙箱路徑。
  # 這不影響產物：變數只在 check() 的 shell 裡，裝到使用者機器上照舊有沙箱。
  if [ "$brw" -ne 0 ]; then
    export GLYCIN_DISABLE_SANDBOX=1
    echo ">> 判定：沙箱不可用（rc=$brw），本次 check 設 GLYCIN_DISABLE_SANDBOX=1 走上游無沙箱路徑"
  else
    echo ">> 判定：沙箱可用，維持預設（不設 GLYCIN_DISABLE_SANDBOX）"
  fi

  # ── 分層對照（#415 加，#418 改寫）：降級之後 gdkpixbufoverlay 仍然紅，而且測試自己
  # **不吐任何 gdk-pixbuf 錯誤**（只有 set_state 回 FAILURE），所以光看測試日誌無法分辨是
  # 「gdk-pixbuf 在這容器裡根本解不了圖」還是「GStreamer 那顆元素壞」。
  # ⚠️ #417 實測這一塊報了假消息：`圖=找不到`——我拿 glob 去猜路徑，上游那張圖其實在
  # tests/check/ 更深一層。這次一律用 find 實找，找不到就明說，不再用猜的路徑當證據。
  # 三層各測一次，誰先紅就是誰的問題：
  #   1) gdk-pixbuf-pixdata（純 C API 路徑）
  #   2) python-gi 直接 new_from_file 並印出 GLib 的**錯誤原文**（這才是我們要的那句話）
  #   3) glycin-thumbnailer（繞過 gdk-pixbuf，直接問解碼器本身）
  # 本機對照實測（2026-10-09）：同一支 new_from_file 在「設 GLYCIN_DISABLE_SANDBOX=1」
  # 與「不設」兩種情況下都 rc=0 解出 32x32 PNG ⇒ 無沙箱路徑本身在本機是好的，
  # 容器若還紅，缺的是容器特有的前提，要靠下面印出的錯誤原文定位，不是再猜。
  local pixrc=0 pixjpg=""
  pixjpg="$(find gstreamer/subprojects/gst-plugins-good/tests -type f \( -name '*.jpg' -o -name '*.jpeg' -o -name '*.png' \) 2>/dev/null | head -1)"
  echo ">> gdk-pixbuf 直測：圖=${pixjpg:-找不到}  loaders=$(gdk-pixbuf-query-loaders 2>/dev/null | grep -c '^"/')  GLYCIN_DISABLE_SANDBOX=${GLYCIN_DISABLE_SANDBOX:-未設}"
  if [ -n "$pixjpg" ]; then
    gdk-pixbuf-pixdata "$pixjpg" /tmp/gst-pixdata.out 2>/tmp/gst-pixdata.err || pixrc=$?
    echo ">> 1) gdk-pixbuf-pixdata rc=$pixrc 產物=$(stat -c %s /tmp/gst-pixdata.out 2>/dev/null || echo 0) bytes stderr=$(head -3 /tmp/gst-pixdata.err 2>/dev/null | tr '\n' '|')"

    # 2) 這層最重要：把 GLib 的錯誤原文抓出來（元素那層只回 FAILURE，什麼都不說）。
    local pyrc=0
    if python3 -c 'import gi' >/dev/null 2>&1; then
      python3 - "$pixjpg" > /tmp/gst-pyprobe.out 2>&1 || pyrc=$?
      echo ">> 2) python-gi new_from_file rc=$pyrc 輸出=$(head -5 /tmp/gst-pyprobe.out | tr '\n' '|')"
    else
      echo ">> 2) python-gi 不在容器裡（跳過這層，不是失敗）"
    fi

    # 3) 繞過 gdk-pixbuf 直接問 glycin。本機實測這條解同一張圖 rc=0。
    local glrc=0
    if command -v glycin-thumbnailer >/dev/null 2>&1; then
      glycin-thumbnailer -i "file://$PWD/$pixjpg" -s 24 -o /tmp/gst-glycin.png > /tmp/gst-glycin.err 2>&1 || glrc=$?
      echo ">> 3) glycin-thumbnailer rc=$glrc 產物=$(stat -c %s /tmp/gst-glycin.png 2>/dev/null || echo 0) bytes 輸出=$(head -5 /tmp/gst-glycin.err | tr '\n' '|')"
    else
      echo ">> 3) 容器裡沒有 glycin-thumbnailer（跳過這層，不是失敗）"
    fi
  fi

  # Flaky due to timeouts
  local rc=0
  xvfb-run -s "-nolisten local" \
    meson test -C build --no-rebuild --print-errorlogs -t $CK_TIMEOUT_MULTIPLIER || rc=$?

  # 主跑紅 → 把失敗的那幾條**用單併發**重跑一次，重試結果就是最終結果（不做任何忽略）。
  # ⚠️ 這裡刻意改 `--num-processes=1`，是一個單變量實驗：#415 實測
  # complex_effect_bin_desc 在全速跑時 OK、在「主跑剛結束立刻重跑」時 FAIL（exit 238，
  # 差一個 dur=1ns 的尾缓冲），症狀是時間_sensitive_而不是代碼壞。重跑降成一次一條，
  # 就能把「資源搶佔」這個變數單獨摘掉：還紅 = 真缺陷，翻綠 = 併發造成的 flaky，
  # 兩邊都是老實結果，不是跳過。
  if [ "$rc" -ne 0 ]; then
    local failed
    failed=$(python3 - <<'PY'
import json
try:
    d = json.load(open("build/meson-logs/testlog.json"))
except Exception:
    print("")
    raise SystemExit
print(" ".join(k for k, v in d.get("tested", {}).items()
               if str(v.get("result", "")).lower() in ("fail", "timeout")))
PY
)
    echo ">> 主跑失敗的測試：${failed:-（讀不到 testlog，改為整體重跑一次）}"
    if [ -n "$failed" ]; then
      xvfb-run -s "-nolisten local" \
        meson test -C build --no-rebuild --print-errorlogs --num-processes=1 -t $CK_TIMEOUT_MULTIPLIER $failed || rc=$?
    else
      xvfb-run -s "-nolisten local" \
        meson test -C build --no-rebuild --print-errorlogs --num-processes=1 -t $CK_TIMEOUT_MULTIPLIER || rc=$?
    fi

    # ── 元素自己的 GError（#419 加，只留證據、不改判定）
    # 為什麼前面三層探針全綠還是定不了案：探針拿的是 `find` 找到的第一張圖，
    # 而測試用的是 GST_TEST_FILES_PATH/image.jpg（編譯進二進位的絕對路徑），兩張不是同一張。
    # 而且 gdkpixbufoverlay 載圖失敗走的是 GST_ELEMENT_ERROR 巨集 —— 它只 post 到 bus、
    # 不寫 stderr，所以 meson 的 errorlog 永遠只剩那句 set_state 回 FAILURE。
    # gst-launch 會把 bus 上的 error 原封不動印出來，這才是我們要的那句話。
    local dg1=0 dg2=0 img1="" launch1="" obin=""
    img1="$(find . -type f -path '*gst-plugins-good/tests/files/image.jpg' 2>/dev/null | head -1)"
    launch1="$(find build -type f -name 'gst-launch-1.0' 2>/dev/null | head -1)"
    obin="$(find build -type f -name 'elements_gdkpixbufoverlay' 2>/dev/null | head -1)"
    echo ">> 診斷前提：image=${img1:-找不到}  launch=${launch1:-找不到}  testbin=${obin:-找不到}"
    if [ -n "$img1" ] && [ -n "$launch1" ]; then
      # ⚠️ pipeline 一定要**逐詞當多個參數**傳：#419 實測我把整句用引號包成一個 token，
      # gst-launch 就把它當成單一元素名，只回 `erroneous pipeline: syntax error`，
      # 一行 GError 都拿不到（這個坑是我自己挖的，不是容器的问题）。
      GST_REGISTRY=/tmp/gst-diag.registry GST_PLUGIN_PATH_1_0="$PWD/build" GST_PLUGIN_SYSTEM_PATH_1_0='' \
        # ⚠️ location 收的是**檔案系統路徑**：#420 實測餵 `file://…` 會被當成檔名，
        # 報 `Failed to open file "file:///…": No such file or directory`——那是探針自己
        # 寫錯造成的假紅，不是包的缺陷。這裡給不加 URI 前綴的絕對路徑。
        "$launch1" -e videotestsrc num-buffers=3 ! gdkpixbufoverlay location="$PWD/$img1" ! fakesink \
        > /tmp/gst-diag.out 2>&1 || dg1=$?
      echo ">> 診斷 1) gst-launch 重組同一條 pipeline rc=$dg1，輸出全文："
      cat /tmp/gst-diag.out 2>/dev/null | head -25
    fi
    if [ -n "$obin" ]; then
      GST_REGISTRY=/tmp/gst-diag2.registry GST_PLUGIN_PATH_1_0="$PWD/build" GST_PLUGIN_SYSTEM_PATH_1_0='' GST_DEBUG=2 \
        "$obin" > /tmp/gst-diag2.out 2>&1 || dg2=$?
      echo ">> 診斷 2) 直接跑測試二進位 rc=$dg2，從 Running suite 起的全文："
      sed -n '/Running suite/,$p' /tmp/gst-diag2.out 2>/dev/null | head -30 || true
      # 測試自己那張圖的路徑是**編譯進二進位**的字串，跟 find 找到的不一定是同一個位置；
      # 把它挖出來直接看檔案在不在，才是「測試拿不到圖」與「元素解不了圖」的分界線。
      baked="$(strings "$obin" 2>/dev/null | grep -oE '[^ ]*image\.jpg' | head -1)"
      echo ">> 診斷 2b) 二進位內嵌的圖=${baked:-查無}  存在=$([ -f "$baked" ] && echo 是 || echo 否)  size=$(stat -c %s "$baked" 2>/dev/null || echo 無)"
    fi

    # ── 診斷 3（#420 加）：#419 的 stderr 出現 `External plugin loader failed`
    # 與 `gst_plugin_loader_try_helper` 的 ERROR，指向 **gst-plugin-scanner 這個 helper
    # 在容器裡起不來**。這跟先前定案的 glycin/bwrap 沙箱是兩件事，別混在一起：
    # 前者是 GStreamer 自己要不要另開行程去載插件，後者是 gdk-pixbuf 解圖。
    # 所以直接問 scanner 本體：能不能執行、能不能列出一個插件。
    local scanrc=0 scanner=""
    scanner="$(find build -type f -name 'gst-plugin-scanner' 2>/dev/null | head -1)"
    if [ -n "$scanner" ]; then
      # scanner 會從 stdin 讀要掃的清單，不餵 /dev/null 會吃掉 makepkg 的 stdin。
      "$scanner" < /dev/null > /tmp/gst-scan.out 2>&1 || scanrc=$?
      echo ">> 診斷 3) gst-plugin-scanner=$scanner 直接執行 rc=$scanrc，輸出前 8 行："
      # ⚠️ 這行在 #420 回過非零，把整個 check() 直接炸掉、連自己的輸出都被吞
      # （makepkg 的 errexit 只看最後一條命令），所以一律 `|| true` 兜住。
      head -8 /tmp/gst-scan.out 2>/dev/null || true
    else
      echo ">> 診斷 3) 找不到 gst-plugin-scanner 二進位（這本身就是一條答案）"
    fi
  fi
  return $rc
)

_install() {
  local src dir
  for src in "${files[@]}"; do
    dir="$pkgdir/$(dirname "$src")"
    mkdir -p "$dir"
    mv -v "$src" "$dir"
  done
}

package_gstreamer() {
  pkgdesc+=" - core"
  depends=(
    glib2
    glibc
    libcap
    libelf
    libgcc
    libunwind
  )
  optdepends=("python: gst-plugins-doc-cache-generator")
  conflicts=('gstreamer-vaapi<=1.26.10-5')
  install=gstreamer.install

  meson install -C build --no-rebuild --destdir "$srcdir/root"

  cd root; local files=(
    usr/include/gstreamer-1.0/gst/{base,check,controller,net,*.h}
    usr/lib/libgst{reamer,base,check,controller,net}-1.0.so*
    usr/lib/pkgconfig/gstreamer{,-base,-check,-controller,-net}-1.0.pc
    usr/lib/girepository-1.0/Gst{,Base,Check,Controller,Net}-1.0.typelib
    usr/share/gir-1.0/Gst{,Base,Check,Controller,Net}-1.0.gir

    usr/lib/gstreamer-1.0/gst-{completion,ptp}-helper
    usr/lib/gstreamer-1.0/gst-{hotdoc-plugins,plugin}-scanner
    usr/lib/gstreamer-1.0/gst-plugins-doc-cache-generator
    usr/lib/gstreamer-1.0/libgstcoreelements.so
    usr/lib/gstreamer-1.0/libgstcoretracers.so

    usr/share/locale/*/LC_MESSAGES/gstreamer-1.0.mo

    usr/bin/gst-{inspect,launch,stats,tester,typefind}-1.0
    usr/share/man/man1/gst-{inspect,launch,stats,typefind}-1.0.1

    usr/share/bash-completion/completions/gst-{inspect,launch}-1.0
    usr/share/bash-completion/helpers/gst

    usr/share/gdb/auto-load/usr/lib/libgstreamer-1.0.so*.py
    usr/share/gstreamer-1.0/gdb/glib_gobject_helper.py
    usr/share/gstreamer-1.0/gdb/gst_gdb.py

    usr/share/aclocal/gst-element-check-1.0.m4
    usr/share/cmake/FindGStreamer.cmake
  ); _install
}

