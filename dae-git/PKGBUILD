_name=dae
pkgname=$_name-git
pkgver=2.1.1.r576.gd43924d1
pkgrel=3
# 這條 pkgver() 原本只寫 `git describe --tags --long`，會錨到「距離最近的祖先 tag」，
# 而上游在 main 上掛了一顆非版號的輕量 tag `lastst`（2026-08-08，指 1d52465d）。它離
# HEAD 只有 396 步，比正經的 v2.1.1（576 步）更近，所以 describe 寧可選它，產物會變成
# `lastst.r396.g…` 這種沒有任何排序意義的字串。修法＝加 --match 'v[0-9]*' 把錨點限死
# 在版號 tag 上。
# 另須記錄：2026-09-27 run #269 那輪產物是 2.0.0rc1.r593.g<hash>（同一個 HEAD），被
# repo-add 判比庫裡 2.0.1.r240 舊而拒收（日誌：WARNING: A newer version for 'dae-git'
# is already present in database），接著剛蓋好的包被「清理未引用資產」刪掉，用戶機上這包
# 就再也沒換過代。當時 v2.1.1／lastst 這兩顆 tag 還沒推進 fork，describe 才一路退到 rc1。
# epoch=1 保留：萬一上游再挪 tag、或 fork 的 tag 推送慢一拍，讓 describe 退回舊錨點時，
# 這包還能繼續餵養而不是永遠被拒收（不准用 --force 繞，拒收是唯一擋住全網降級的閘門）。
# 2026-10-06 抬到 2：Go 建置工具鏈換成自有 go-git（尖端 1.28-devel）。dae 上游一動
# （r690.gc5203f0）就停在原地不換代，而 -git 包的 pkgrel 會被 makepkg 重置為 1，
# 所以「用新編譯器重出一版」這件事只能靠 epoch 表達（用戶實測 `dae --version` 裡
# 鑲的是 go1.27.1，就是這一類卡代）。
epoch=2
pkgdesc="A Linux lightweight and high-performance transparent proxy solution based on eBPF."
arch=('x86_64' 'aarch64')
url="https://github.com/Capricornus007/dae"
license=('AGPL-3.0-or-later')
provides=("$_name")
conflicts=("$_name")
depends=('glibc')
# clang19/llvm19 而不是 clang：見 build() 的說明。llvm19 提供 llvm-strip-19
# （clang19 只依賴 llvm19-libs，不含 strip 工具）。
makedepends=('clang19' 'llvm19' 'go' 'git')
backup=("etc/dae/config.dae")
install="${_name}.install"
source=(
	"git+https://github.com/Capricornus007/dae.git"
	"geoip.dat::https://cdn.jsdelivr.net/gh/Loyalsoldier/v2ray-rules-dat@release/geoip.dat"
	"geosite.dat::https://cdn.jsdelivr.net/gh/Loyalsoldier/v2ray-rules-dat@release/geosite.dat"
)
sha256sums=(
	"SKIP"
	"SKIP"
	"SKIP"
)

pkgver() {
	cd "$_name"
	git describe --tags --long --match 'v[0-9]*' \
		| sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-\([^-]*\)-\([^-]*\)$/.\1.\2/;s/-//'
}

prepare() {
	cd "$srcdir/$_name"
	git submodule update --init --recursive
}

build() {
	cd "$srcdir/$_name"
	# 釘 clang19 是出於「產物可重現性」：進包的 eBPF 不該跟著 CI 容器（ubuntu runner）
	# 的預設 LLVM 漂移，同一份源碼每次都要能編出可對照的固定產物。
	# 事實已更新、舊前提作廢：原註解宣稱「不釘就會被驗證器拒收、用戶裝完 dae 直接斷網」——
	# clang 23.1.1 產出的 tproxy_wan_cg_connect4 曾報
	#   load program: invalid argument: invalid variable-offset read from stack R4 ...
	# 現已由 dae 源碼修復：commit d114e4e38 把程序名邊界檢查改用 barrier_var(idx) 界定索引
	# （見 control/kern/tproxy.c），修掉 LLVM 23 先做 <<32/>>32 零擴充而丟失 32 位邊界資訊的
	# 問題，最新 clang 的產物也能過載入閘門（clang 23.1.1 與 clang 19 實測皆可載入）。
	# 故「未釘＝用戶斷網」不再成立；但釘選本身保留，理由換成上面那條可重現性。
	# 防呆仍必須寫在 PKGBUILD 裡，技術細節照舊：llvm19 才提供 llvm-strip-19（clang19 只依賴
	# llvm19-libs、不含 strip 工具），而 dae 的 Makefile 是 `CLANG ?= clang` / `STRIP ?= llvm-strip`，
	# 找不到 STRIP 時會靜默改成 -no-strip；所以找不到 $_clang 就 return 1 中止、
	# 絕不退回未釘的 clang（靜默降級正是這道閘門要堵掉的）。
	local _clang=/usr/lib/llvm19/bin/clang
	if [ ! -x "$_clang" ]; then
		echo "ERROR: 找不到 $_clang（clang19 套件）。拒用未釘版本的 clang 編 eBPF。" >&2
		return 1
	fi
	export CLANG="$_clang"
	export STRIP=llvm-strip-19
	BUILD_ARGS="-buildmode=pie -modcacherw" CFLAGS="-fno-stack-protector" make VERSION="${pkgver}"
}

package() {
	cd "$srcdir/$_name"
	install -Dm755 "dae" -t "${pkgdir}/usr/bin/"
	install -Dm644 "install/${_name}.service" -t "${pkgdir}/usr/lib/systemd/system/"
	install -Dm640 "install/empty.dae" "${pkgdir}/etc/dae/config.dae"
	install -Dm644 "example.dae" "${pkgdir}/etc/dae/config.dae.example"

	mkdir -p "${pkgdir}/usr/share/dae/"
	cp ../geoip.dat "${pkgdir}/usr/share/dae/geoip.dat"
	cp ../geosite.dat "${pkgdir}/usr/share/dae/geosite.dat"
}
