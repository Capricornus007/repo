@@ -627,10 +627,13 @@ typedef struct _DeviceIntRec {
 
     /* XTest related master device id */
     int xtest_master_id;
-    DeviceSendEventsProc sendEventsProc;
 
     struct _SyncCounter *idle_counter;
 
+    /* 下面三個是 24.4 之後新增的（aaa8d5a95 / d038d2c08）。sendEventsProc 原本
