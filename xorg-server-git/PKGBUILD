# Maintainer: Capricornus007 <Capricornus007 at proton dot me>
#
# 本倉 in-tree 維護（2026-10-21，使用者指示「xorg 系列 -git 也做」「鏈 libsystemd 你刪了
# 不就好了」）。在此之前 feed 只有 xorg-xwayland-git；xorg-server-git 一直吃 chaotic-aur，
# 而那份是 **Arch 的建法**：`-D systemd_logind=true` + depends 帶 `systemd-libs`，裝到
# Artix 上就是鏈 libsystemd。所以自己建一份 **Artix 口味**的：`-D systemd_logind=false`，
# depends 不帶 systemd-libs —— 這正是 Artix 官方 xorg-server 的作法（實查本機
# /usr/lib/Xorg 的 NEEDED：只有 libudev.so.1／libdbus-1.so.3，**沒有** libsystemd、也沒有
# libelogind）。
#
# 只切三顆：server／common／xvfb。刻意不做 xephyr／xnest／devel／src：
#   · xephyr/xnest 對本機與 CI 都沒用到；
#   · devel 只有編 xorg 驅動才需要，而本倉目前沒有這類包；
#   · src 需要把整棵樹打包再解開，只是為了給人看原始碼，價值低。
#   （要的話照官方 PKGBUILD 補 package_ 函式即可。）
#
# 不套 Arch 那份的 0001-Revert_damage_*.patch：那是針對 21.1.x 穩定版的上游回退補丁，
# master 早就改過，硬套會打不上。
#
# ⚠️ 這顆**不是**給日常替換用的：本機跑的是 Artix 穩定版 xorg-server，-git 只是尖端選項。
#    真要裝之前先確認顯卡驅動的 ABI（provides 的 X-ABI-* 會隨 master 變）。

pkgbase=xorg-server-git
pkgname=('xorg-server-git' 'xorg-server-common-git' 'xorg-server-xvfb-git')
pkgver=21.1.25.r0.g0000000
pkgrel=1
arch=('x86_64')
license=('LicenseRef-Adobe-Display-PostScript' 'BSD-3-Clause' 'LicenseRef-DEC-3-Clause'
         'HPND' 'LicenseRef-HPND-sell-MIT-disclaimer-xserver' 'HPND-sell-variant'
         'ICU' 'ISC' 'MIT' 'MIT-open-group' 'NTP' 'SGI-B-2.0' 'SMLNJ' 'X11'
         'X11-distribute-modifications-variant')
groups=('xorg')
url="https://xorg.freedesktop.org"
makedepends=('xorgproto' 'pixman' 'libx11' 'mesa' 'mesa-libgl' 'xtrans'
             'libxkbfile' 'libxfont2' 'libpciaccess' 'libxv' 'libxcvt'
             'libxmu' 'libxrender' 'libxi' 'libxaw' 'libxtst' 'libxres'
             'xorg-xkbcomp' 'xorg-util-macros' 'xorg-font-util' 'libepoxy'
             'xcb-util' 'xcb-util-image' 'xcb-util-renderutil' 'xcb-util-wm'
             'xcb-util-keysyms' 'libxshmfence' 'libunwind' 'meson' 'git')
source=("${pkgbase}::git+https://gitlab.freedesktop.org/xorg/xserver.git")
sha256sums=('SKIP')

pkgver() {
  cd "${pkgbase}"
  # 版本要看**真正的版本字串**，不是 tag 名：上游 main 的 meson.build 是
  # `version: '26.1.99.1'`，編出來的二進位自己印 `X.Org X Server 1.26.1.99`
  # （實跑 `usr/lib/Xorg -version` 驗過）。用 tag 會得到
  # `server.26.1.branchpoint.r86`——那只是分支點標籤的名字，不是版本。
  # 讀 meson.build 也順帶免疫「tag 命名/分支改名」這種事。
  local ver
  ver=$(sed -n "s/^ *version: '\([0-9][^']*\)',*$/\1/p" meson.build | head -1)
  [ -n "$ver" ] || ver=0
  printf '%s.r%s.g%s\n' "$ver" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
  # Arch 的 makepkg.conf 會帶 -fno-plt / -Wl,-z,now，xorg 模組載入會 undefined symbol
  # （FS#55102、FS#54845）；跟官方 PKGBUILD 一樣拿掉。
  export CFLAGS=${CFLAGS/-fno-plt}
  export CXXFLAGS=${CXXFLAGS/-fno-plt}
  export LDFLAGS=${LDFLAGS/-Wl,-z,now}

  arch-meson "${pkgbase}" build \
    -D ipv6=true \
    -D xvfb=true \
    -D xnest=false \
    -D xcsecurity=true \
    -D xorg=true \
    -D xephyr=false \
    -D glamor=true \
    -D udev=true \
    -D dtrace=false \
    -D systemd_logind=false \
    -D suid_wrapper=true \
    -D linux_acpi=false \
    -D xkb_dir=/usr/share/X11/xkb \
    -D xkb_output_dir=/var/lib/xkb \
    -D libunwind=true
  meson configure build
  ninja -C build
  DESTDIR="${srcdir}/fakeinstall" ninja -C build install
}

_install() {
  local src f dir
  for src; do
    f="${src#fakeinstall/}"
    dir="${pkgdir}/${f%/*}"
    install -m755 -d "${dir}"
    cp -av "${src}" "${dir}/"
    rm -rf "${src}"
  done
}

package_xorg-server-common-git() {
  pkgdesc="Xorg server common files (git master)"
  depends=(xkeyboard-config xorg-xkbcomp xorg-setxkbmap)
  provides=("xorg-server-common=${pkgver}")
  conflicts=('xorg-server-common')

  _install fakeinstall/usr/lib/xorg/protocol.txt
  _install fakeinstall/usr/share/man/man1/Xserver.1
  install -m644 -Dt "${pkgdir}/var/lib/xkb/" "${pkgbase}"/xkb/README.compiled
  install -m644 -Dt "${pkgdir}/usr/share/licenses/${pkgname}" "${pkgbase}"/COPYING
}

package_xorg-server-git() {
  pkgdesc="Xorg X server (git master, systemd-free build)"
  depends=(libepoxy libxfont2 pixman xorg-server-common-git libunwind
           dbus libgl xf86-input-libinput nettle
           libxdmcp sh glibc libxau libtirpc
           libpciaccess libdrm libxshmfence libxcvt)
  # ⚠️ ABI 宣告必須是**上游真值**，不能沿用穩定版的 25.2／24.4（2026-11-01 查明）。
  # 實查 git master 的 hw/xfree86/common/xf86Module.h：
  #   ABI_VIDEODRV_VERSION   = SET_ABI_VERSION(27, 0)   （第 77 行）
  #   ABI_XINPUT_VERSION     = SET_ABI_VERSION(25, 0)   （第 78 行）
  #   ABI_EXTENSION_VERSION  = SET_ABI_VERSION(10, 0)   （第 79 行）
  # 舊宣告 25.2／24.4 是從 xorg-server 21.1.x 抄來的假值：那等於對 pacman 說
  # 「本機模組 ABI 仍是 25.2」，於是所有照 25.2 建的驅動（nvidia 615、
  # xf86-input-libinput、modesetting、vesa）會被當成相容而留著，實際開機時
  # Xorg 一律拒載（"module ABI major version (25) doesn't match the server's (28)"）
  # → 沒影像是小事，**鍵盤滑鼠全滅**才是代價。
  #
  # 2026-11-01 對 master HEAD eae2c2107（gitlab xorg/xserver）的
  # hw/xfree86/common/xf86Module.h 逐行讀過的實值：
  #   ABI_VIDEODRV_VERSION   = SET_ABI_VERSION(28, 0)   ← ecb6644fd 2026-08-09 抬的
  #   ABI_XINPUT_VERSION     = SET_ABI_VERSION(26, 0)
  #   ABI_EXTENSION_VERSION  = SET_ABI_VERSION(11, 0)   ← bbe30db5c 同日抬的
  # （先前那筆「27.0／25.0／10.0」也是抄的、不是讀的，一樣是錯的，這裡一併改對。）
  #
  # 為什麼不能靠 IgnoreABI 或改戳記混過去：21.1.24→master 之間動到
  # include/scrnintstr.h 的提交只有三筆，其中 3cb3024fe「dix: Remove
  # pScratchPixmap」把 `PixmapPtr pScratchPixmap;` 這個**欄位整個刪掉**（結構體
  # 中間少一個指標 → 它後面所有欄位的偏移全部位移 8 bytes）。二進位驅動是照
  # 舊偏移去取 pScreen-> 的東西，標籤對不對根本不重要，IgnoreABI 只關掉比對、
  # 不會把欄位還回來。另兩筆（6ee937b3b 只改註解、7e7d1f027 只改 typedef 名字
  # Curser→Cursor、欄位名與函式指標型別都不變）不影響佈局。
  # → 真要「新舊通吃」，可行方向是在新 server 裡於同一偏移補一個 padding 欄位，
  #   把 25.2 的佈局還原；但符號層（nvidia_drv.so 未定義符號 vs 新 server 導出）
  #   還沒驗，得先建出這顆再拿 Xvfb 離線載一次才算數。
  provides=('X-ABI-VIDEODRV_VERSION=28.0' 'X-ABI-XINPUT_VERSION=26.0'
            'X-ABI-EXTENSION_VERSION=11.0' 'x-server' "xorg-server=${pkgver}")
  conflicts=('xorg-server' 'nvidia-utils<=331.20' 'glamor-egl' 'xf86-video-modesetting')
  replaces=('glamor-egl' 'xf86-video-modesetting')

  _install fakeinstall/usr/bin/{X,Xorg,gtf}
  _install fakeinstall/usr/lib/Xorg{,.wrap}
  _install fakeinstall/usr/lib/xorg/modules/*
  _install fakeinstall/usr/share/X11/xorg.conf.d/10-quirks.conf
  _install fakeinstall/usr/share/man/man1/{Xorg,Xorg.wrap,gtf}.1
  _install fakeinstall/usr/share/man/man4/{exa,fbdevhw,inputtestdrv,modesetting}.4
  _install fakeinstall/usr/share/man/man5/{Xwrapper.config,xorg.conf,xorg.conf.d}.5

  install -m755 -d "${pkgdir}/etc/X11/xorg.conf.d"
  install -m644 -Dt "${pkgdir}/usr/share/licenses/${pkgname}" "${pkgbase}"/COPYING
}

package_xorg-server-xvfb-git() {
  pkgdesc="Virtual framebuffer X server (git master)"
  depends=(libxfont2 libunwind pixman xorg-server-common-git xorg-xauth
           libgl nettle libtirpc libxdmcp sh glibc libxau)
  provides=("xorg-server-xvfb=${pkgver}")
  conflicts=('xorg-server-xvfb')

  _install fakeinstall/usr/bin/Xvfb
  _install fakeinstall/usr/share/man/man1/Xvfb.1
  install -m644 -Dt "${pkgdir}/usr/share/licenses/${pkgname}" "${pkgbase}"/COPYING
}
