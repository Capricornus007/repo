# 2026-11-02：復活自 953a4e5 的剔除清單（Xfce 4.21 鏈）。
# 原條目用 AUR 的裸名依賴（libxfce4ui/garcon/xfconf…），但 feed 只發 -git 包，
# 容器裡 target not found。這裡把 Xfce 家族依賴改成對應 -git 包，並把
# xfce4-dev-tools 改成 xfce4-dev-tools-git；plan 的 -git 依賴門檻會按 DAG
# 自動跳過尚未發布的層，等前一層進 feed 後下一輪再建。
# Maintainer: Jefferson Gonzalez <jgmdev@gmail.com>
# Contributor: ponsfoot <cabezon dot hashimoto at gmail dot com>
# Contributor: Jan Jezek <honzin.jezek@gmail.com>

_pkgname=xfce4-dev-tools
_gitname=$_pkgname
pkgname=${_pkgname}-git
pkgver=4.21.2.r9.ge97b04c
pkgrel=1
pkgdesc="The Xfce development tools"
arch=('i686' 'x86_64')
url="https://gitlab.xfce.org/xfce/xfce4-dev-tools"
license=('GPL-2.0-or-later')
depends=('glib2' 'gtk-doc' 'pkg-config' 'make' 'intltool')
makedepends=('git' 'meson')
optdepends=('docker: xfce-build helper script')
conflicts=($_pkgname)
replaces=($_pkgname)
provides=("${_pkgname}=4.21")
source=("git+https://gitlab.xfce.org/xfce/${_pkgname}.git")
sha256sums=('SKIP')

pkgver() {
	cd "${srcdir}/${_gitname}"

	if GITTAG="$(git describe --abbrev=0 --tags 2>/dev/null)"; then
		echo "$(sed -e "s/^${pkgname%%-git}//" -e 's/^[-_/a-zA-Z]\+//' -e 's/[-_+]/./g' <<< ${GITTAG}).r$(git rev-list --count ${GITTAG}..).g$(git log -1 --format="%h")"
	else
		echo "0.r$(git rev-list --count master).g$(git log -1 --format="%h")"
	fi
}

# 2026-11-22：上游 master 已刪除 autogen.sh（Xfce 全線遷移 meson，
# autotools 支援移除），run #86 的 prepare() 紅在
#   ./autogen.sh: No such file or directory
# 改走 meson（makedepends 的 meson 本來就列著）。
build() {
  cd "${srcdir}/${_gitname}"

  meson setup build \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --buildtype=plain
  meson compile -C build
}

package() {
  cd "${srcdir}/${_gitname}"
  meson install -C build --destdir "${pkgdir}"
}
