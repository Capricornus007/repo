# 六最納管 2026-11-25（任務#37，鐵律25）：LFS 同源版本源碼構建，pacman 接管所有權。
# 系統現有同名無主命令（LFS 自建），本包版本釘系統現版本，裝即接管非升級。
pkgname=make
pkgver=4.4.1
pkgrel=1
pkgdesc='make (LFS 同源構建，六最納管)'
arch=(x86_64)
url='https://ftp.gnu.org/gnu/make/make-4.4.1.tar.gz'
license=(GPL-3.0-or-later)

source=("make-4.4.1.tar.gz")
sha256sums=('SKIP')

build() {
  cd "make-4.4.1"
  ./configure --prefix=/usr
  make
}

package() {
  cd "make-4.4.1"
  make DESTDIR="$pkgdir" install
}
