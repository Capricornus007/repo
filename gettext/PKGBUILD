# 六最納管 2026-11-25（任務#37，鐵律25）：LFS 同源版本源碼構建，pacman 接管所有權。
# 系統現有同名無主命令（LFS 自建），本包版本釘系統現版本，裝即接管非升級。
pkgname=gettext
pkgver=1.0
pkgrel=1
pkgdesc='gettext (LFS 同源構建，六最納管)'
arch=(x86_64)
url='https://ftp.gnu.org/gnu/gettext/gettext-1.0.tar.xz'
license=(GPL-3.0-or-later)

source=("https://ftp.gnu.org/gnu/gettext/gettext-1.0.tar.xz")
sha256sums=('SKIP')

build() {
  cd "gettext-1.0"
  ./configure --prefix=/usr
  make
}

package() {
  cd "gettext-1.0"
  make DESTDIR="$pkgdir" install
}
