# Maintainer: Capricornus007 <capricornus007@users.noreply.github.com>
#
# Qoder CLI（国际版，非 -cn 变体）。
#
# AUR 上的 qoder-cli(pakrohk) 是坏的：它在 prepare() 里跑
# `curl https://qoder.com/install | bash`，而官方脚本把二进制装进
# ~/.qoder/bin/qodercli/qodercli-<ver>、只在 ~/.local/bin 建入口，$srcdir 里
# 永远等不到 qoder/qodercli，于是固定以
#   ERROR: Expected binary (qoder or qodercli) not found after script execution
# 收场（2026-09-18 实测）。本包不跑安装脚本，直接按官方 manifest 的 release
# 直链取 tarball——版本与校验和都有权威来源，CI 可全自动跟随上游。
#
# 源清单：https://qoder-ide.oss-accelerate.aliyuncs.com/qodercli/channels/manifest.json
#   {"latest":"1.1.55",
#    "files":[{"os":"linux","arch":"amd64",
#              "url":".../releases/1.1.55/qodercli-linux-x64.tar.gz",
#              "sha256":"..."}, ...]}
# manifest 另有 amd64-baseline（无 AVX2 的老 CPU）与 *-musl 变体；这里取 glibc
# 优化版——官方安装脚本在 CPU 支持 sse4_2/popcnt/avx/avx2/bmi1/bmi2/fma 时选的
# 也是它（见其 BUN_OPTIMIZED_X64_REQUIRED_CPU_FLAGS）。
pkgname=qoder-cli
pkgver=1.1.60
pkgrel=1
pkgdesc="Qoder Agentic CLI - agentic AI coding tool from Alibaba (international build)"
url="https://qoder.com/cli"
arch=('x86_64' 'aarch64')
license=('custom:Qoder Product Service Terms')
options=('!strip' '!debug')
provides=('qodercli')
# 刻意**不** provides=('qoder')：pacman 的 conflicts 單向命中對手的 provides（libalpm
# conflict.c 的 check_conflict→_alpm_depcmp，實查 6.0.2 與 master 均無「反向衝突豁免」），
# 而國際 GUI 包 qoder-gui-bin 已宣告 conflicts=('qoder')——CLI 一提供 qoder 就會跟自家
# GUI 包互斥死鎖，兩包文件其實零重疊、設計上並存。/usr/bin/qoder 的所有權靠下面
# 逐條實包名 conflicts 來守，不靠虛擬名。
# 對面清單（2026-09-18 實查各 AUR PKGBUILD）：
#   qodercli-bin (Huipeng)       裝 /usr/bin/qodercli——與本包主檔對撞
#   qoder-bin    (zxp19821005)   裝 /usr/bin/qoder——與本包 symlink 對撞
#   qoder        (arch-lsf)      cp -a 舊滾動 RPM 整棵 /usr（含 /usr/bin/qoder）對撞
#   qoder-ide-bin (zxp19821005)  實查只裝 /usr/bin/qoder-ide 與 qoder-ide.desktop 等，
#                                與本包無任何共同路徑，不列；它與 GUI 包的文件重疊
#                                已由 qoder-gui-bin 的 conflicts 擋下。
conflicts=('qodercli-bin' 'qoder-bin' 'qoder')

_case_arch() {
  case "$1" in
    x86_64)  printf 'x64' ;;
    aarch64) printf 'arm64' ;;
  esac
}

_qarch=$( _case_arch "$CARCH" )

source=("LICENSE.html::https://qoder.com/product-service")
sha256sums=('SKIP')

source_x86_64=("qodercli-${pkgver}-linux-x64.tar.gz::https://qoder-ide.oss-accelerate.aliyuncs.com/qodercli/releases/${pkgver}/qodercli-linux-x64.tar.gz")
source_aarch64=("qodercli-${pkgver}-linux-arm64.tar.gz::https://qoder-ide.oss-accelerate.aliyuncs.com/qodercli/releases/${pkgver}/qodercli-linux-arm64.tar.gz")

# 以下两行校验和取自官方 manifest.json 对应 arch 的 sha256 字段；
# CI 的「改写 PKGBUILD」步骤升版时会同步更新（源 URL 是 ${pkgver} 模板，自动跟随）。
sha256sums_x86_64=('094ac652383b9284c7319a5c66ea9d4d8e65888942679ef0030dfead85bb5178')
sha256sums_aarch64=('5c85c7bddfed88b0f806a3eec5b86377476698478f1d747d4f83274d9ae6f670')

package() {
  # tarball 里除主程序外只有 sites-build.json / sites-verification.json 两个
  # 建置期中继档（主程序零引用），不随包。
  local bin
  bin="$(find "$srcdir" -type f -name qodercli -print -quit)"
  [ -n "$bin" ] || { echo "错误：解包后找不到 qodercli 二进制" >&2; return 1; }
  install -Dm755 "$bin" "$pkgdir/usr/bin/qodercli"

  # 官方安装脚本建的入口名是 qodercli；官网/文档里也用 `qoder` 呼它，
  # 一并给出，免得用户照文档敲 qoder 找不到命令。
  ln -sfn qodercli "$pkgdir/usr/bin/qoder"

  install -Dm644 "$srcdir/LICENSE.html" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.html"
}
