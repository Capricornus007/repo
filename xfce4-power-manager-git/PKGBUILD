# 2026-11-02：復活自 953a4e5 的剔除清單（Xfce 4.21 鏈）。
# 原條目用 AUR 的裸名依賴（libxfce4ui/garcon/xfconf…），但 feed 只發 -git 包，
# 容器裡 target not found。這裡把 Xfce 家族依賴改成對應 -git 包，並把
# xfce4-dev-tools 改成 xfce4-dev-tools-git；plan 的 -git 依賴門檻會按 DAG
# 自動跳過尚未發布的層，等前一層進 feed 後下一輪再建。
# Maintainer:  twa022 <twa022 at gmail dot com>

_pkgname=xfce4-power-manager
pkgname=${_pkgname}-git
pkgver=4.21.1+355+ga824bfe3
pkgrel=1
pkgdesc="Power manager for Xfce desktop"
arch=('x86_64' 'i686' 'armv7h' 'aarch64')
url="https://docs.xfce.org/xfce/xfce4-power-manager/start"
license=('GPL-2.0-or-later')
groups=('xfce4-git')
depends=('libxfce4ui-git' 'upower' 'libnotify' 'hicolor-icon-theme')
# networkmanager 從 depends 移到 makedepends：本機 Artix 不跑 NM（pacman.conf 的
# IgnorePkg 裡有 networkmanager 與 wpa_supplicant，兩顆都沒裝），寫成執行期依賴
# 會讓這顆包在用戶機器上永遠裝不上（實測 makepkg 紅在「無法解決 wpa_supplicant」）。
# NM 集成照常編譯進去，只是沒裝 NM 時那段功能不啟用——跟 unbound 去 libsystemd 同理。
makedepends=('xfce4-panel-git' 'wayland-protocols' 'wayland' 'git' 'xfce4-dev-tools-git' 'glib2-devel' 'wlr-protocols' 'meson' 'gobject-introspection' 'networkmanager')
optdepends=('xfce4-panel-git: Xfce panel plugin support'
            'xfce4-notifyd-git: 顯示電源狀態通知'
            'networkmanager: 休眠／喚醒時協調網路連線（NM 集成）')
provides=("${_pkgname}=${pkgver%%+*}")
conflicts=("${_pkgname}")
replaces=("${_pkgname}")
source=("${_pkgname}::git+https://gitlab.xfce.org/xfce/${_pkgname}")
sha256sums=('SKIP')

pkgver() {
  cd "${_pkgname}"
  git describe --long --tags | sed -r "s:^${_pkgname}.::;s/^v//;s/^xfce-//;s/([^-]*-g)/r\1/;s/-/./g"
}

build() {
  local meson_options=(
    -D x11=enabled
    -D wayland=enabled
  )

  # arch-meson 是 Arch devtools 的殼子、Artix 容器裡查無（同 garcon-git 在
  # run 41387684219 #12 的「arch-meson: command not found」）。原樣展開本倉
  # meson-git/arch-meson 的旗標，只換呼叫方式、不改語意。
  meson setup "${_pkgname}" build \
    --prefix=/usr --libexecdir=lib --sbindir=bin \
    --buildtype=release --auto-features=enabled --wrap-mode=nodownload \
    -D python.bytecompile=1 \
    "${meson_options[@]}"
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
}
