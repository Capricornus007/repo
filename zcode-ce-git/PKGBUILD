# Maintainer: Capricornus007 <[REDACTED]>
#
# zcode-ce-git 4.0.0 —— 官方閉源 AppImage 拆包 + 遙測出口手術（CE 等價去遙測）重組包。
#
# 為什麼從源碼構建改成拆包重組（2026-11-24，使用者明確裁定）：
#   舊的源碼構建（pnpm bundle:desktop）長期因 ssh2 `v8::Context has no member
#   GetIsolate` + electron 44.7.0 node-abi 不認識而在 electron-rebuild 階段失敗
#   （BuildGitPkgs #980 等）。使用者裁定：以官方閉源版最新 v4.0.0 為準，直接拆
#   官方 AppImage 重組，包形態與已發布的 zcode-ce-git 3.17.2-ce 完全一致。
#
# 權威源（可複核）：
#   · 官方閉源 v4.0.0 Linux x64 AppImage（GitHub release 資產頁無 Linux 版，僅官方 CDN）：
#     https://cdn-zcode.z.ai/zcode/electron/releases/4.0.0/linux-x64/ZCode-4.0.0-linux-x64.AppImage
#     SHA256 = 2cedc5fceee1ffcc74b00cca292bfa86522cf7201ba8bc93d0c5500b6fefcc47
#   · 包形態模板 = 已發布 zcode-ce-git 3.17.2-ce 包（取 .INSTALL/desktop/圖示/license/apparmor）：
#     https://github.com/Capricornus007/repo/releases/download/current-repo/zcode-ce-git-3.17.2.ce.1.r459.gbefcd087-1-x86_64.pkg.tar.zst
#     SHA256 = 1d51cfc4288884af0fcf8d87ba8e7dc0977476b0d7af2f00fbc36115970275c7
#   · 遙測出口手術腳本 = 本倉 fork Capricornus007/Zcode-CE 的 aur/zcode-ce-rebuild/surgery_400.py
#     （commit 8f7f4dd，遵循 CE 政策 docs/development/telemetry.md；等價 CE 提交 be778822）
#
# 隱私（關鍵，不可跳過）：官方 app.asar 內含 ARMS/RUM + OTLP 遙測 SDK 與出口端點，
#   prepare() 用 surgery_400.py 清空 endpoint/license key/event report URL/開關，
#   8 項出口驗證全 0 才允许打包。宿主 retain 的 SDK 檔無出口、不初始化（與 CE 做法一致）。
#   零 systemd 鐵律：產物不得有任何 systemd/sysusers 路徑。

pkgname=zcode-ce-git
pkgver=4.0.0
pkgrel=1
pkgdesc="ZCode 官方閉源版 v4.0.0（官方 AppImage 拆包 + 遙測出口手術 CE 等價去遙測，保持 zcode-ce-git 包形態）"
arch=('x86_64')
url="https://github.com/Capricornus007/Zcode-CE"
license=('Apache-2.0')
depends=('gtk3' 'nss' 'libxss' 'libxtst' 'libnotify' 'alsa-lib' 'mesa' 'xdg-utils')
provides=('zcode-ce')
conflicts=('zcode-ce' 'zcode-ce-bin')
options=('!strip')
# .INSTALL 由 makepkg 從此腳本自動生成（chrome-sandbox setuid + desktop 快取刷新）
install=zcode-ce-git.install

# npx 屬於 npm 包（nodejs 不提供），@electron/asar 用 npx 安裝；
# python 跑手術腳本；libarchive 提供 bsdtar；zstd 壓縮。
makedepends=('nodejs' 'npm' 'python' 'libarchive' 'zstd')

source=(
  "ZCode-4.0.0-linux-x64.AppImage::https://cdn-zcode.z.ai/zcode/electron/releases/4.0.0/linux-x64/ZCode-4.0.0-linux-x64.AppImage"
  "template-3.17.2.pkg.tar.zst::https://github.com/Capricornus007/repo/releases/download/current-repo/zcode-ce-git-3.17.2.ce.1.r459.gbefcd087-1-x86_64.pkg.tar.zst"
  "surgery_400.py::https://raw.githubusercontent.com/Capricornus007/Zcode-CE/8f7f4dd145e2a8472ab9a1fa96ef0adcaaba554e/aur/zcode-ce-rebuild/surgery_400.py"
)
sha256sums=(
  '2cedc5fceee1ffcc74b00cca292bfa86522cf7201ba8bc93d0c5500b6fefcc47'
  '1d51cfc4288884af0fcf8d87ba8e7dc0977476b0d7af2f00fbc36115970275c7'
  'f8150e0730e0e0fa3b7605957630e6072711c9bc90564a6a7c7e494f542d2936'
)

prepare() {
  set -euo pipefail
  cd "$srcdir"

  # npx 拉 @electron/asar 走 npm 鏡像（registry.npmjs.org 在部分網路不可達，
  # 2026-11-24 本機試構建實測 ENOTFOUND；npmmirror 實測正常）。
  export npm_config_registry=https://registry.npmmirror.com

  # 1) 解官方 AppImage -> squashfs-root/
  rm -rf squashfs-root
  chmod +x ZCode-4.0.0-linux-x64.AppImage
  ./ZCode-4.0.0-linux-x64.AppImage --appimage-extract >/dev/null

  # 2) 解官方 app.asar -> asar-src/
  rm -rf asar-src
  npx --yes @electron/asar@4.3.2 extract squashfs-root/resources/app.asar asar-src

  # 3) 遙測出口手術（8 項出口驗證全 0 才继续）
  python surgery_400.py "$srcdir/asar-src"

  # 4) 重打包 asar（native 邊界與官方一致：ssh2/node-pty/keyring/sharp）
  rm -rf asar-patched
  npx --yes @electron/asar@4.3.2 pack asar-src asar-patched/app.asar \
    --unpack '*.{node,dll,dylib,exe}' \
    --unpack-dir node_modules/node-pty/prebuilds/linux-x64

  # 完整性：檔案數與 unpacked 邊界必須與官方一致（官方 4.0.0 = 31939 檔 / 4 native）
  local _count
  _count=$(npx --yes @electron/asar@4.3.2 list asar-patched/app.asar | wc -l)
  echo ">> 手術後 asar 檔案數: $_count"
  [ "$_count" -ge 31900 ] || { echo "::error::asar 檔案數異常（$_count），手術/重打包有誤"; return 1; }
}

package() {
  set -euo pipefail
  cd "$srcdir"

  local _stage="$srcdir/pkgstage"
  rm -rf "$_stage"
  mkdir -p "$_stage"

  # 1) 從模板包取外殼（desktop/圖示/license/apparmor）
  #    注意：.PKGINFO/.INSTALL/.MTREE/.BUILDINFO 绝不能手動放進 pkgdir——
  #    makepkg 會從 PKGBUILD 自動生成這四個點檔案，手動放會觸發
  #    「在軟體包根目錄找到點檔案」錯誤（2026-11-24 本機試構建 rc=5 實測）。
  bsdtar -xf template-3.17.2.pkg.tar.zst -C "$_stage" \
    usr/share/applications/zcode-ce.desktop \
    usr/share/icons usr/share/licenses/zcode-ce-git/LICENSE \
    opt/ZCode-CE/resources/apparmor-profile

  # 2) 從解包 AppImage 取 Electron runtime + resources（跳過 app-update.yml：CE 形態無此檔）
  cd squashfs-root
  for f in LICENSE.electron.txt LICENSES.chromium.html chrome-sandbox \
           chrome_100_percent.pak chrome_200_percent.pak chrome_crashpad_handler \
           icudtl.dat libffmpeg.so libvk_swiftshader.so libvulkan.so.1 resources.pak \
           snapshot_blob.bin v8_context_snapshot.bin vk_swiftshader_icd.json; do
    [ -e "$f" ] && install -Dm644 "$f" "$_stage/opt/ZCode-CE/$f"
  done
  install -Dm755 zcode "$_stage/opt/ZCode-CE/zcode-ce"   # 官方主二進位 zcode -> zcode-ce
  for f in locales/*.pak; do install -Dm644 "$f" "$_stage/opt/ZCode-CE/$f"; done
  # resources 內容（官方 4.0.0）
  for item in resources/*; do
    case "$item" in
      */app-update.yml) continue ;;
    esac
    if [ -d "$item" ]; then
      cp -a "$item" "$_stage/opt/ZCode-CE/resources/"
    else
      install -Dm644 "$item" "$_stage/opt/ZCode-CE/resources/${item##*/}"
    fi
  done
  cd "$srcdir"

  # 3) 用遙測手術後的 asar 替換原始 asar（關鍵：禁止跳過）
  install -Dm644 asar-patched/app.asar "$_stage/opt/ZCode-CE/resources/app.asar"
  cp -a asar-patched/app.asar.unpacked "$_stage/opt/ZCode-CE/resources/"

  # 4) /usr/bin 連結
  mkdir -p "$_stage/usr/bin"
  ln -sf /opt/ZCode-CE/zcode-ce "$_stage/usr/bin/zcode-ce"

  # 5) 零 systemd 鐵律自檢（點檔案由 makepkg 自動生成，此處只放真實檔案）
  if find "$_stage" -iname '*systemd*' -o -iname '*sysusers*' | grep -q .; then
    echo "::error::產物違反零 systemd 鐵律"
    find "$_stage" -iname '*systemd*' -o -iname '*sysusers*'
    return 1
  fi

  # 6) 把 stage 的檔案樹放進 $pkgdir（makepkg 會把 $pkgdir 本身封裝成包）
  cp -a "$_stage"/. "$pkgdir"/
}
