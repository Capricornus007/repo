# Maintainer: Capricornus007 <capricornus007@users.noreply.github.com>
#
# 本包從 ZCode-CE fork 源碼構建「官方最新基線＋CE 政策」，不是把閉源 AppImage 改名重發。
# 3.17.2 更新的可複核輸入：
#   · 官方開源基線 zai-org/ZCode v3.17.1 = a60ba6a7；
#   · 官方 3.17.2 Linux x64 AppImage 由官方安裝頁連到
#     https://cdn-zcode.z.ai/zcode/electron/releases/3.17.2/linux-x64/ZCode-3.17.2-linux-x64.AppImage
#     SHA-256 = 4a522d45727454188c56833275ae5b4d588ac3b2b87eedee5f7d98f8553a12e1；
#   · 閉源包只用於核對 version、ASAR/native 邊界與 Electron 合同，不會被本包混入或重新分發。
#     完整 URL/雙雜湊/空 AppImage 簽章區段/3.16.3 差量見 CE 的 upstream-sync 台帳。
#
# CE 3.17.2-ce.1 把開源 v3.17.1 整版合併後，保留 fork 的遙測移除、自託管遠控、
# Source Server 自癒與快取、終端 owner、引導確認及 ToolSearch 完整鏈；根版本對齊閉源 3.17.2。
# 桌面 dependency、electron-builder 的 electronVersion 與鎖檔都指向 Electron 44.7.0；產物
# 自帶該 runtime，所以本包不依賴、也不另裝系統 electron41/electron42/electron44。
#
# 為什麼只建 pacman target（prepare() 裡 sed）：
#   · bundle 預設一次建 AppImage+deb+rpm+pacman；AUR 只需要 pacman，rpm 又要求 rpmbuild。
#   · bundle.mjs 的產物驗證接受任一目標副檔名，所以縮成 pacman 不降低產物門禁。
#
# 構建環境對齊 CE release workflow：production、社區 runtime CDN、GitHub Electron/runtime
# binaries mirror；`pnpm install --frozen-lockfile` 釘住 Electron 44 與 native staging 輸入。
# `_giturl` 沿用使用者 fork（內容與 CE 上游 main 逐字同源，2026-11-11 實測兩邊
# HEAD 都是 df5e6ab7、package.json 3.17.2-ce.1），差別只在不會因上游重寫而失聯。
# 版本由 pkgver() 從 package.json＋git 現算，因此本檔維持矩陣 kind:aur 的回推校驗和排除。
# 2026-11-11 修正：原本 `_branch='sync/v3162-pr5'` 停在 7cadb3fd 的 3.16.3 WIP，
# 建出來的包版本會退回 3.16.x（issue：3.17.2 更新後版號不動）。CE 上游 main 已吸收
# 3.17.2，故改跟 main；pkgver 同步重算為 r457.gdf5e6ab7。

_giturl='https://github.com/Capricornus007/Zcode-CE'
_branch='main'

pkgname=zcode-ce-git
pkgver=3.17.2.ce.1.r457.gdf5e6ab7
pkgrel=1
pkgdesc="ZCode 的開源社區版（官方 zai-org/ZCode 開源上游＋CE 修補），從源碼構建"
arch=('x86_64')
url="https://github.com/Capricornus007/Zcode-CE"
license=('Apache-2.0')
# 與 electron-builder.config.js 的 PACMAN_RUNTIME_DEPENDENCIES 逐字一致（Arch 官方
# 倉庫可解析的 Electron 運行時閉包；內層產物的 .PKGINFO 被剝掉，依賴由本檔宣告）。
depends=('gtk3' 'nss' 'libxss' 'libxtst' 'libnotify' 'alsa-lib' 'mesa' 'xdg-utils')
# libxcrypt-compat：electron-builder 自帶的 fpm 是 ruby 打包（fpm@2.1.4-fpm-1.17.0-
# ruby-3.4.3-linux-amd64），其 ruby 要 libcrypt.so.1——首建 run 39984189532 實測
# `ruby: error while loading shared libraries: libcrypt.so.1`，fpm process failed 127。
# 本機實查該檔由 libxcrypt-compat 提供（pacman -Qo）。
makedepends=('git' 'nodejs' 'pnpm' 'libarchive' 'libxcrypt-compat')
provides=('zcode-ce')
conflicts=('zcode-ce' 'zcode-ce-bin')
options=('!strip')
install=zcode-ce-git.install
source=("$pkgname::git+${_giturl}.git#branch=${_branch}")
sha256sums=('SKIP')

pkgver() {
  cd "$pkgname"
  # package.json 的 version 形如 3.17.2-ce.1；pacman 的 pkgver 不準連字號，換點號。
  # ⚠️ 不能用 node -p：plan 步在 base-devel 容器裡跑，那時 makedepends 還沒裝
  #   （nodejs 是 makepkg 裝的）→ command not found → 每輪 skip、永遠不出包。
  #   sed 取第一個 "version" 欄（root package.json 的頂層 version 在最前面，
  #   dependencies 是 "pkg": "^x.y.z" 形，不會誤中）。
  local _v
  _v=$(sed -n 's/^[[:space:]]*"version": *"\([^"]*\)".*/\1/p' package.json | head -n1 | tr '-' '.')
  [ -n "$_v" ] || { echo "::error::package.json 解不出 version"; return 1; }
  printf '%s.r%s.g%s' "$_v" "$(git rev-list --count HEAD)" "$(git rev-parse --short=8 HEAD)"
}

prepare() {
  cd "$pkgname"
  # 只留 pacman target（理由見檔頭）。sed 後 grep 回證，改不動就紅——上游重排了
  # target 陣列的寫法時，寧可紅也不要悄悄建出四份沒用的。
  sed -i 's|target: \["AppImage", "deb", "rpm", "pacman"\]|target: ["pacman"]|' \
    packages/desktop/electron-builder.config.js
  grep -q 'target: \["pacman"\]' packages/desktop/electron-builder.config.js || {
    echo "::error::electron-builder 的 linux target 改寫沒落地（上游改了 config 寫法？）"
    return 1
  }
  # 打包完畢後 electron-builder 會照 publish 配置往 GitHub Release 上傳，
  # 容器沒有（也不該有）GH_TOKEN → 「GitHub Personal Access Token is not set」
  # 直接紅（run 39984189532/40044092974 實測；產物其實已經建好）。本包只產包
  # 不發佈（發佈是 feed repo-add 的事），publish 拔成 null。app-update.yml 在
  # packaging 階段就寫進資源目錄，不依賴 publish 步驟，更新配置不受影響。
  sed -i '/^  publish: {$/,/^  },$/c\  publish: null,' \
    packages/desktop/electron-builder.config.js
  grep -q 'publish: null' packages/desktop/electron-builder.config.js || {
    echo "::error::publish 配置沒拔掉（上游改了 config 佈局？）——沒 token 的容器必然死在發佈步驟"
    return 1
  }
}

build() {
  cd "$pkgname"
  export ZCODE_ENV=production
  export ZCODE_CDN_BASE_URL='https://cdn.eidolonmachine.xyz'
  export ELECTRON_MIRROR='https://github.com/electron/electron/releases/download/'
  export ELECTRON_BUILDER_BINARIES_MIRROR='https://github.com/electron-userland/electron-builder-binaries/releases/download/'
  # --frozen-lockfile 與 CE release.yml 一致；鎖檔與源碼同倉，不會漂。
  pnpm install --frozen-lockfile
  # bundle:desktop 內部依次跑 prepare:runtime-assets → build → electron-builder →
  # 產物校驗 → 體積審計（別在它前面單獨再跑 build，會重複做十分鐘的資產準備）。
  pnpm bundle:desktop --os linux --arch x64
}

package() {
  cd "$pkgname"
  # 取最新的 pacman 產物（dist 下可能有重試留下的多份，按 mtime 取新）。
  local _artifact
  _artifact=$(ls -t packages/desktop/dist/*.pkg.tar.zst | head -n1)
  [ -n "$_artifact" ] || { echo "::error::dist 下沒有 .pkg.tar.zst 產物"; return 1; }
  echo ">> 打包進 pkgdir 的產物：$_artifact"

  tar -xf "$_artifact" -C "$pkgdir" \
    --exclude=.PKGINFO --exclude=.INSTALL --exclude=.MTREE --exclude=.BUILDINFO

  # 內層包的 .INSTALL 不隨內容複製（它是元數據），可執行入口由本檔補：
  # CE 的安裝佈局是 /opt/ZCode-CE/zcode-ce（productName 目錄＋linuxExecutableName）。
  local _app_bin="$pkgdir/opt/ZCode-CE/zcode-ce"
  [ -e "$_app_bin" ] || { echo "::error::沒找到 /opt/ZCode-CE/zcode-ce（上游改佈局了？）"; return 1; }
  install -d "$pkgdir/usr/bin"
  ln -sf /opt/ZCode-CE/zcode-ce "$pkgdir/usr/bin/zcode-ce"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
