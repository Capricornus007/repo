# 2026-11-25 in-tree（AUR 刪包搶救）：AUR 的 lib32-libnghttp3-git 已刪除（RPC 查無、clone 空倉），
# 改由本倉構建。基於 Arch 官方 lib32-libnghttp3 PKGBUILD 轉 -git：
#  1. source 改 GitHub ngtcp2/nghttp3.git master（子模組 munit/sfparse 照官方 prepare 處理）
#  2. 加 pkgver()（git describe，去 v 前綴）
#  3. 拿掉 ?signed/validpgpkeys（CI 無簽章金鑰）
pkgname=lib32-libnghttp3-git
pkgver=1.19.0
pkgrel=1
pkgdesc='HTTP/3 library written in C (32-bit)'
url='https://github.com/ngtcp2/nghttp3'
arch=('x86_64')
license=('MIT')
depends=('lib32-glibc' 'libnghttp3')
makedepends=('git')
# 32 位元下游以裸名 lib32-libnghttp3 或 soname 契約依賴；64 位元本體由 libnghttp3-git 提供
provides=('lib32-libnghttp3' 'libnghttp3.so')
conflicts=('lib32-libnghttp3')
source=('git+https://github.com/ngtcp2/nghttp3.git'
        'git+https://github.com/ngtcp2/munit.git'
        'git+https://github.com/ngtcp2/sfparse.git')
sha256sums=('SKIP'
            'SKIP'
            'SKIP')

pkgver() {
  cd nghttp3
  git describe --long --tags | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd nghttp3/

  git config --file=.gitmodules submodule.tests/munit.url ../munit/
  git config --file=.gitmodules submodule.lib/sfparse.url ../sfparse/

  git submodule init
  git -c protocol.file.allow=always submodule update

  autoreconf -i
}

build() {
  cd nghttp3/

  export CC='gcc -m32'
  export CXX='g++ -m32'
  export PKG_CONFIG_PATH='/usr/lib32/pkgconfig'
  ./configure \
    --prefix=/usr \
    --libdir=/usr/lib32
  make
}

check() {
  cd nghttp3/

  make check
}

package() {
  cd nghttp3/

  make DESTDIR="${pkgdir}" install
  rm -r "${pkgdir}"/usr/{include,share}
  install -D -m0644 COPYING -t "${pkgdir}/usr/share/licenses/${pkgname}"
}
