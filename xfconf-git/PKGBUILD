# 2026-11-02：復活自 953a4e5 的剔除清單（Xfce 4.21 鏈）。
# 原條目用 AUR 的裸名依賴（libxfce4ui/garcon/xfconf…），但 feed 只發 -git 包，
# 容器裡 target not found。這裡把 Xfce 家族依賴改成對應 -git 包，並把
# xfce4-dev-tools 改成 xfce4-dev-tools-git；plan 的 -git 依賴門檻會按 DAG
# 自動跳過尚未發布的層，等前一層進 feed 後下一輪再建。
# shellcheck shell=bash
# Maintainer: Silvio Knizek <killermoehre@gmx.net>
# Contributor: Evangelos Foutras <foutrelis@archlinux.org>
# Contributor: Robin Candau <antiz@archlinux.org>
# Contributor: tobias <tobias funnychar archlinux.org>

_pkgname=xfconf
pkgname="${_pkgname}-git"
pkgver=4.21.2+195+g3aff21e
pkgrel=1
pkgdesc="D-Bus-based configuration storage system - git checkout"
arch=('i686' 'x86_64')
url="https://docs.xfce.org/xfce/${_pkgname}/start"
license=('GPL-2.0-or-later')
groups=('xfce4')
depends=('libxfce4util-git')
makedepends=('git' 'glib2-devel' 'intltool' 'gobject-introspection' 'vala' "xfce4-dev-tools>=${pkgver%.*}" 'meson')
provides=("${_pkgname}=${pkgver}")
conflicts=("${_pkgname}")
replaces=("${_pkgname}")
source=("git+https://gitlab.xfce.org/xfce/${_pkgname}.git")
sha256sums=('SKIP')

pkgver() {
  cd "${_pkgname}" || return 1
  git describe --long --tags | sed -r "s:^${_pkgname}.::;s/^v//;s/^xfce-//;s/([^-]*-g)/r\1/;s/-/./g"
}

prepare() {
  meson subprojects download --sourcedir="${_pkgname}"
}

build() {
  arch-meson "${_pkgname}" build
  meson compile -C build
}

check() {
  meson test -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
}

# vim:set ts=2 sw=2 et:
