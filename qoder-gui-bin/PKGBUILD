# Maintainer: Capricornus007 <capricornus007@users.noreply.github.com>
#
# Qoder IDE —— 圖形介面（GUI），國際版。與 CN 版 qoder-gui-cn 全程分開：
#   本版（國際）  source center.qoder.sh / qoder-ide.oss-accelerate.aliyuncs.com
#                 裝 /usr/share/qoder-ide/、qoder-ide.desktop、qoder-ide.png
#   qoder-gui-cn  source static.qoder.com.cn/qoder-app
#                 裝 "/opt/Qoder CN/"、qoder-cn.desktop、qoder-cn.png
# 套件名、發佈目錄、RPM 檔名、desktop 檔名、StartupWMClass 沒一項重疊，兩包可並存。
# 也與 qoder-cli / qoder-cli-cn（命令列）互不干擾。
#
# 版本與校驗來源（權威，就是 IDE 內建更新檢查打的端點）：
#   GET https://center.qoder.sh/algo/api/update/linux-x64/stable/latest
#     {"name":"1.31.0","productVersion":"1.31.0",
#      "url":"https://qoder-ide.oss-accelerate.aliyuncs.com/release/1.31.0/qoder-ide_x86_64.rpm",
#      "sha256hash":"72a55be6a9b3643286cbec15e33c5ada36c02eb769badc602daf0d6cad2e6441"}
#   實測（2026-09-18）：sha256hash 與該 RPM 實算 sha256 逐字元吻合，可直接當
#   sha256sums 用，CI 不需要自己下載再算。release/<ver>/<檔名> 路徑對舊版本
#   （1.29.0 / 1.30.0）也全部 200，寫成 ${pkgver} 模板安全。
#
#   刻意**不用** download.qoder.com/release/latest/…：那是滾動址，同一 URL
#   的內容天天變、檔名裡也沒有版本號（AUR pakrohk 的 qoder-gui-bin 就是用它 +
#   pkgver=latest + prepare() 裡 curl -O，CI 無法定位版本、校驗和也無從對齊）。
#
# 架構：只出 x86_64。center.qoder.sh 的 linux-arm64 通道是殭屍資料——實測回
#   name=0.2.7 且 url 指向 …/release/0.2.7/qoder_amd64.deb（amd64 的 deb！），
#   上游根本沒有 arm64 GUI 版，故 arch 如實只標 x86_64。
#
# 不碰 /usr/bin（用戶裁決的命名地雷）：上游 RPM 裡本就沒有任何 /usr/bin 條目，
#   主程式在 /usr/share/qoder-ide/qoder-ide，desktop 的 Exec 直接寫這個絕對路徑。
#   /usr/bin/qoder 已由 qoder-cli 佔用、/usr/bin/qoder-cn 已由 qoder-cli-cn 佔用，
#   本包一律不去建連結，只在 /usr/share/applications 放 .desktop。

pkgname=qoder-gui-bin
pkgver=1.31.0
pkgrel=1
pkgdesc="Qoder IDE - agentic coding platform for real software (GUI, international build)"
url="https://qoder.com"
arch=('x86_64')
license=('custom:Qoder Product Service Terms')
options=('!strip' '!debug')
# 依賴按實測 NEEDED 逐條對應：readelf -d /usr/share/qoder-ide/qoder-ide 得 34 條，
# 扣掉 glibc / gcc-libs 自帶的 6 條（libc、libm、libdl、libpthread、ld-linux、
# libgcc_s）與包內自帶的 libffmpeg.so，剩下 27 個外部 soname，一條不多一條不少。
# AUR 那份還多列 libxss、libdrm——實測 NEEDED 裡根本沒有 libXScrnSaver，libdrm 也由
# mesa 傳遞依賴帶入，跟著列只會憑空加寬依賴面。另外四條（desktop-file-utils、
# shared-mime-info、hicolor-icon-theme、gcc-libs/glibc）是打包側需要，不是 soname。
depends=(
  'alsa-lib'              # libasound.so.2
  'at-spi2-core'          # libatk-bridge-2.0.so.0 + libatspi.so.0
  'atk'                   # libatk-1.0.so.0
  'cairo'                 # libcairo.so.2
  'dbus'                  # libdbus-1.so.3
  'desktop-file-utils'    # /usr/share/applications 的 update-desktop-database 觸發器
  'expat'                 # libexpat.so.1
  'gcc-libs'              # libgcc_s.so.1
  'glibc'                 # libc.so.6 / libm.so.6 / libdl.so.2 / libpthread.so.0 / ld-linux
  'glib2'                 # libglib-2.0.so.0 + libgobject-2.0.so.0 + libgio-2.0.so.0
  'gtk3'                  # libgtk-3.so.0
  'hicolor-icon-theme'    # 圖示繼承目錄（pixmaps 之外，desktop 的 Icon 也走這兒找）
  'libcups'               # libcups.so.2
  'libx11'                # libX11.so.6
  'libxcomposite'         # libXcomposite.so.1
  'libxdamage'            # libXdamage.so.1
  'libxext'               # libXext.so.6
  'libxfixes'             # libXfixes.so.3
  'libxrandr'             # libXrandr.so.2
  'libxcb'                # libxcb.so.1
  'libxkbcommon'          # libxkbcommon.so.0
  'mesa'                  # libgbm.so.1（libEGL/libGLESv2 包內自帶，但底層驅動仍要 mesa）
  'nspr'                  # libnspr4.so
  'nss'                   # libnss3.so + libnssutil3.so + libsmime3.so
  'pango'                 # libpango-1.0.so.0
  'shared-mime-info'      # /usr/share/mime/packages/qoder-ide-workspace.xml 的觸發器
  'systemd-libs'          # libudev.so.1（Artix 也有獨立的 systemd-libs，不需要 systemd）
)
# AUR 上裝同一份 RPM 的其它命名：zxp19821005 的 qoder-ide-bin / qoder-bin 會把
# 應用搬到 /usr/share/qoder 並共用 qoder-ide.desktop；pakrohk 的 qoder-gui-bin
# 與本包同名（本包由自有倉直接提供，裝上即取代）。virtual 'qoder'/'qoder-ide'
# 是那些包提供的，一起擋掉，避免兩份 IDE 搶同一個 desktop/mime 檔。
conflicts=('qoder' 'qoder-ide' 'qoder-ide-bin' 'qoder-bin' 'qoder-gui')

source=("LICENSE.html::https://qoder.com/product-service")
sha256sums=('SKIP')

source_x86_64=("qoder-ide-${pkgver}-x86_64.rpm::https://qoder-ide.oss-accelerate.aliyuncs.com/release/${pkgver}/qoder-ide_x86_64.rpm")
# 校驗和取自上面 center.qoder.sh 端點的 sha256hash 欄位；CI 升版時與 pkgver 同步改寫。
sha256sums_x86_64=('72a55be6a9b3643286cbec15e33c5ada36c02eb769badc602daf0d6cad2e6441')

package() {
  local rpm="qoder-ide-${pkgver}-x86_64.rpm"
  # bsdtar 直接吃 RPM（libarchive 的 rpm reader 會解出 cpio payload），
  # 同 element-desktop-nightly-bin 用 bsdtar 解 .deb 一個路子。整棵樹原樣落地：
  #   ./usr/share/qoder-ide/{qoder-ide,chrome-sandbox,bin/,resources/,locales/…}
  #   ./usr/share/applications/qoder-ide{,-url-handler}.desktop
  #   ./usr/share/{appdata,mime,pixmaps,bash-completion,zsh}/…
  bsdtar -xf "$srcdir/$rpm" -C "$pkgdir" || return 1

  # chrome-sandbox 上游就是 setuid root 4755（實測 RPM 內 `-rwsr-xr-x`）。
  # 非 root 解包時這個位會被 bsdtar 悄悄抹掉，這裡顯式要回來，保持與上游一致；
  # CN 版那個包的上游檔是 0755 非 setuid，兩邊各照原樣、不統一成 setuid。
  local sbx="$pkgdir/usr/share/qoder-ide/chrome-sandbox"
  [ -f "$sbx" ] || { echo "错误：解包后找不到 chrome-sandbox" >&2; return 1; }
  chmod 4755 "$sbx"
  # 主程式與 crashpad handler 必須可執行（上游已是 0755，這裡只是防呆）。
  chmod 0755 "$pkgdir/usr/share/qoder-ide/qoder-ide" \
             "$pkgdir/usr/share/qoder-ide/chrome_crashpad_handler"

  # 本包刻意不建任何 /usr/bin 連結（理由見檔頭）：desktop 的 Exec 已是
  # /usr/share/qoder-ide/qoder-ide 絕對路徑，圖形啟動不依賴 PATH。
  # 若哪天要把 CLI 橋接（/usr/share/qoder-ide/bin/qoder）上 PATH，必須先處理
  # 它與 qoder-cli 的 /usr/bin/qoder 撞名，不能直接 ln。

  install -Dm644 "$srcdir/LICENSE.html" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.html"
}
