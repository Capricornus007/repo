pkgver() {
  # ⚠️ 同 librime-git：CI「更新校验和」那一步的 updpkgsums 會把 BUILDDIR 換成
  #    mktemp 目錄並在退出時刪掉，緊接著的 `makepkg --printsrcinfo` 仍要跑
  #    pkgver() → 這時 `cd gstreamer` 落空、git 直接 fatal 退出 128（實測
  #    2026-10-12 run #452 的 librime-git 就紅在這裡）。所以先確認拿得到一個
  #    真的是 git 倉庫的位置，全部找不到就沿用 PKGBUILD 寫死的 pkgver。
  local d v
  for d in "gstreamer" "$SRCDEST/gstreamer" "$srcdir/gstreamer"; do
    [[ -d $d ]] && git -C "$d" rev-parse -q --verify HEAD >/dev/null 2>&1 && break
    d=
  done
  if [[ -z $d ]]; then
    printf '%s\n' "$pkgver"
    return 0
  fi
  # 版號基準吃 meson.build 的 project(... version : 'X')，實測 main 上是 1.29.2.1；
  # 這樣 world／extra 的穩定版換代（1.28.x → 1.29.x）時這邊會自己跟上，不需要 epoch。
  # 用 `git show HEAD:` 讀檔 → 裸倉庫（SRCDEST）也能取到，不依賴工作區。
  v=$(git -C "$d" show HEAD:meson.build \
      | sed -n "s/^[[:space:]]*version : '\([0-9.]*\)'.*/\1/p" | head -1)
  [[ -z "$v" ]] && v=0.0.0
  printf '%s.r%s.g%s\n' "$v" "$(git -C "$d" rev-list --count HEAD)" "$(git -C "$d" rev-parse --short=12 HEAD)"
}

prepare() {
  cd gstreamer

  local src
  for src in "${source[@]}"; do
    src="${src%%::*}"
    src="${src##*/}"
    src="${src%.zst}"
    [[ $src = *.patch ]] || continue
    echo "Applying patch $src..."
    git apply -3 < "../$src"
  done

  cargo fetch --locked --target host-tuple \
    --manifest-path subprojects/gst-devtools/dots-viewer/Cargo.toml
}

build() {
  local meson_options=(
    -D benchmarks=disabled
    -D examples=disabled
    -D glib_debug=disabled
    -D gpl=enabled
    -D gst-devtools:debug_viewer=enabled
    -D gst-examples=disabled
    -D gst-plugins-bad:aja=disabled
    -D gst-plugins-bad:amfcodec=disabled
    -D gst-plugins-bad:androidmedia=disabled
    -D gst-plugins-bad:cuda-nvmm=disabled
    -D gst-plugins-bad:directfb=disabled
    -D gst-plugins-bad:directshow=disabled
    # executorch 是 monorepo main 上新增的 AI 推論插件（2026-10-12 實測：不關掉的話
    # meson 在 ext/executorch/meson.build:23 直接
    # 「ERROR: Dependency "ExecuTorch" not found (tried cmake)」中斷整個 configure）。
    # ExecuTorch 是 Meta 的推論執行期，Arch／Artix 都沒有這顆包（實測全倉只有它用
    # method:'cmake' 取依賴），所以照 Arch 對「上游有、發行版沒有」那批插件的做法關掉。
    -D gst-plugins-bad:executorch=disabled
    -D gst-plugins-bad:flite=disabled
    -D gst-plugins-bad:gs=disabled
    -D gst-plugins-bad:iqa=disabled
    -D gst-plugins-bad:isac=disabled
    -D gst-plugins-bad:lcevcdecoder=disabled
    -D gst-plugins-bad:lcevcencoder=disabled
    -D gst-plugins-bad:magicleap=disabled
    -D gst-plugins-bad:mfx_api=oneVPL
    -D gst-plugins-bad:mpeghdec=disabled
    -D gst-plugins-bad:nvcomp=disabled
    -D gst-plugins-bad:nvdswrapper=disabled
    -D gst-plugins-bad:openni2=disabled
    -D gst-plugins-bad:opensles=disabled
    -D gst-plugins-bad:qt6d3d11=disabled
    -D gst-plugins-bad:svtjpegxs=disabled
    -D gst-plugins-bad:tflite=disabled
    -D gst-plugins-bad:tinyalsa=disabled
    -D gst-plugins-bad:voaacenc=disabled
    -D gst-plugins-bad:voamrwbenc=disabled
    -D gst-plugins-bad:wasapi2=disabled
    -D gst-plugins-bad:wasapi=disabled
    -D gst-plugins-bad:wpe=disabled
    -D gst-plugins-base:libvisual=disabled
    -D gst-plugins-base:tremor=disabled
    -D gst-plugins-good:rpicamsrc=disabled
    -D gst-plugins-ugly:sidplay=disabled
    -D gstreamer:dbghelp=disabled
    -D gstreamer:ptp-helper-permissions=capabilities
    -D libnice=disabled
    -D orc-source=system
    -D package-name="Arch Linux GStreamer ${epoch:+$epoch:}$pkgver-$pkgrel"
    -D package-origin="https://www.archlinux.org/"
  )

  if [[ ${CARCH} != x86_64* ]]; then
    meson_options+=(-D gst-plugins-bad:svthevcenc=disabled)
  fi

  arch-meson gstreamer build "${meson_options[@]}"
  meson compile -C build
}

check() (
  export XDG_RUNTIME_DIR="$PWD/runtime-dir"
  mkdir -p -m 700 "$XDG_RUNTIME_DIR"

  # 測試跑在未安裝的建置樹裡（meson 會把 GST_PLUGIN_SYSTEM_PATH_1_0 設成空、
  # GST_PLUGIN_PATH_1_0 指到 build/），這時 GStreamer 找不到「外掛掃描器」輔助程式，
  # 每個吃 registry 的測試都會看到：
  #   GStreamer-WARNING: External plugin loader failed. This most likely means that
  #   the plugin loader helper binary was not found or could not be run. You might
  #   need to set the GST_PLUGIN_SCANNER environment variable...
  # 實測 2026-10-12 第十次編譯：609 條裡 15 條 FAIL（ges_* 12 條 + nle_* 全部、
  # gst-plugins-base:libs_rtspconnection、gst-plugins-good:generic_states），
  # testlog.txt 第一行警告就是這個。掃描器其實已經建置出來了，只是沒人告訴測試它在哪：
  #   build/subprojects/gstreamer/libs/gst/helpers/gst-plugin-scanner
  # 補環境、不跳測試。
  export GST_PLUGIN_SCANNER="$PWD/build/subprojects/gstreamer/libs/gst/helpers/gst-plugin-scanner"

  # 容器裡沒有 GPU（也沒有 /dev/dri），GL 測試會在「建立 EGL display」這步直接失敗：
  # 2026-10-21 run 39570379334 的 gst-plugins-base:libs_gstglmemory（603 過 1 敗）。
  # 補環境而不是跳測試：走 mesa 的 surfaceless EGL + llvmpipe 軟體渲染。
  export EGL_PLATFORM=surfaceless
  export LIBGL_ALWAYS_SOFTWARE=1
  export GALLIUM_DRIVER=llvmpipe

  export CK_TIMEOUT_MULTIPLIER=5
  export NO_AT_BRIDGE=1 GTK_A11Y=none

  # Flaky due to timeouts
  xvfb-run -s "-nolisten local" \
    meson test -C build --no-rebuild --print-errorlogs -t $CK_TIMEOUT_MULTIPLIER
)

# 清单是照著「某一次建置的實物」寫死的，尖端會自己長高或掉檔：
#  - 上游把插件刪了（實測 2026-10-12：codectimestamper／aasink／cacasink／mpeg2dec 四條）
#    → 舊寫法 `mv` 直接失敗、整場 25 包建置中止。改成記帳到 claim-missing.log、繼續走，
#      並在最後一個包（docs）把帳目印出來给人看。
#  - 上游新增檔而清單沒跟上 → 一定留在 root 裡沒人被認領，由 docs 那個函式的最後一步
#      「root 必須清空」判定紅。靜默漏檔是最壞的失敗，所以這一頭絕不放行。
_install() {
  local src dir hit
  for src in "${files[@]}"; do
    hit=0
    for dir in $src; do [[ -e $dir || -L $dir ]] && hit=1; done
    if (( hit == 0 )); then
      printf '%s\t%s\n' "$pkgname" "$src" >> "$srcdir/claim-missing.log"
      continue
    fi
    for dir in $src; do
      [[ -e $dir || -L $dir ]] || continue
      mkdir -p "$pkgdir/$(dirname "$dir")"
      mv -v "$dir" "$pkgdir/$(dirname "$dir")"
    done
  done
}

package_gstreamer-git() {
  # -git 版要吃掉 world／extra 的同名穩定版：provides 讓依賴方能解析、
  # conflicts 讓 pacman 真的換掉它。穩定版包名寫死（實測 ${pkgname%-git} 在
  # split 執行期取到空值，makepkg 報「conflicts 不可以空白」）。
  provides+=("gstreamer=$pkgver-$pkgrel")
  conflicts+=("gstreamer")

  pkgdesc+=" - core"
  depends=(
    glib2
    glibc
    libcap
    libelf
    libgcc
    libunwind
  )
  optdepends=("python: gst-plugins-doc-cache-generator")
  conflicts+=('gstreamer-vaapi<=1.26.10-5')
  install=gstreamer.install

  meson install -C build --no-rebuild --destdir "$srcdir/root"
  rm -f "$srcdir/claim-missing.log"

  cd root; local files=(
    usr/include/gstreamer-1.0/gst/{base,check,controller,net,*.h}
    usr/lib/libgst{reamer,base,check,controller,net}-1.0.so*
    usr/lib/pkgconfig/gstreamer{,-base,-check,-controller,-net}-1.0.pc
    usr/lib/girepository-1.0/Gst{,Base,Check,Controller,Net}-1.0.typelib
    usr/share/gir-1.0/Gst{,Base,Check,Controller,Net}-1.0.gir

    usr/lib/gstreamer-1.0/gst-{completion,ptp}-helper
    usr/lib/gstreamer-1.0/gst-{hotdoc-plugins,plugin}-scanner
    usr/lib/gstreamer-1.0/gst-plugins-doc-cache-generator
    usr/lib/gstreamer-1.0/libgstcoreelements.so
    usr/lib/gstreamer-1.0/libgstcoretracers.so

    usr/share/locale/*/LC_MESSAGES/gstreamer-1.0.mo

    usr/bin/gst-{inspect,launch,stats,tester,typefind}-1.0
    usr/bin/gst-preregistry-generate
    usr/share/man/man1/gst-{inspect,launch,stats,typefind}-1.0.1

    usr/share/bash-completion/completions/gst-{inspect,launch}-1.0
    usr/share/bash-completion/helpers/gst

    usr/share/gdb/auto-load/usr/lib/libgstreamer-1.0.so*.py
    usr/share/gstreamer-1.0/gdb/glib_gobject_helper.py
    usr/share/gstreamer-1.0/gdb/gst_gdb.py

    usr/share/aclocal/gst-element-check-1.0.m4
    usr/share/cmake/FindGStreamer.cmake
  ); _install
}

package_gst-plugins-bad-libs-git() {
  # -git 版要吃掉 world／extra 的同名穩定版：provides 讓依賴方能解析、
  # conflicts 讓 pacman 真的換掉它。穩定版包名寫死（實測 ${pkgname%-git} 在
  # split 執行期取到空值，makepkg 報「conflicts 不可以空白」）。
  provides+=("gst-plugins-bad-libs=$pkgver-$pkgrel")
  conflicts+=("gst-plugins-bad-libs")

  pkgdesc+=" - bad"
  depends=(
    "gst-plugins-base-libs-git=$pkgver-$pkgrel"
    "gstreamer-git=$pkgver-$pkgrel"
    glib2
    glibc
    libdrm
    libgcc
    libglvnd
    libgudev
    libnice
    libstdc++
    libusb
    libva
    libx11
    libxcb
    libxkbcommon
    libxkbcommon-x11
    mesa
    orc
    vulkan-icd-loader
    wayland
    vmaf
    zlib
  )

  cd root; local files=(
    usr/include/gstreamer-1.0/gst/audio/{audio-bad-prelude,gstnonstreamaudiodecoder,gstplanaraudioadapter}.h
    usr/include/gstreamer-1.0/gst/{analytics,basecamerabinsrc,codecparsers,cuda,insertbin,interfaces,isoff,mpegts,mse,play,player,sctp,transcoder,uridownloader,va,vulkan,wayland,webrtc}
    usr/lib/libgst{adaptivedemux,analytics,badaudio,basecamerabinsrc,codecparsers,codecs,cuda,dxva,insertbin,isoff,mpegts,mse}-1.0.so*
    usr/lib/libgst{photography,play,player,sctp,transcoder,uridownloader,va,vulkan,wayland,webrtc,webrtcnice}-1.0.so*
