# Maintainer: Capricornus007 <capricornus007@users.noreply.github.com>
# License: The Better WTFPL (TBWTFPL) v114514 - https://github.com/Capricornus007/tbwtfpl/blob/main/LICENSE
# 本倉 in-tree 維護版（2026-11-15）。基底：Arch 官方 extra/orc 0.4.44-1，
# 改成 GitLab gstreamer/orc 的 git HEAD。AUR 上沒有 orc-git。
# 官方 PKGBUILD 是 split（orc + orc-docs），-git 版只出主包、不產生文檔，
# 避免 hotdoc 在尖端樹上因 API 變動失敗。git 直出無 tag → 去掉 PGP 驗證。
# epoch=1 保證 1:0.4.44.rN.gHASH 嚴格大於 0.4.44-1，杜絕版本回退。
# ⚠️ 版號由 pkgver() 現算 ⇒ kind: aur 借道排除「校驗和回推」。

pkgname=orc-git
pkgver=0.4.44.r1.gf4ac35cf
pkgrel=1
epoch=1
pkgdesc='Optimized Inner Loop Runtime Compiler (git)'
arch=(x86_64)
url='https://gstreamer.freedesktop.org/modules/orc.html'
license=(BSD-3-Clause)
depends=(glibc)
makedepends=(git meson valgrind)
provides=('orc' "liborc-0.4.so" "liborc-test-0.4.so")
conflicts=('orc')
source=("git+https://gitlab.freedesktop.org/gstreamer/orc.git")
sha256sums=('SKIP')

pkgver() {
  cd orc
  git describe --long --tags | sed 's/^orc-//;s/-/.r/;s/-/./g'
}

build() {
  arch-meson orc build -D hotdoc=disabled
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -Dt "$pkgdir/usr/share/licenses/$pkgname" -m644 orc/COPYING
}
