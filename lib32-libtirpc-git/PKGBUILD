# Maintainer: Capricornus007 <capricornus007@users.noreply.github.com>
# License: The Better WTFPL (TBWTFPL) v114514 - https://github.com/Capricornus007/tbwtfpl/blob/main/LICENSE
#
# 本倉 in-tree 維護版（2026-11-15）。基底：AUR lib32-libtirpc-git 1.3.8.rc1-1。
#
# 為什麼不直接 clone AUR：那份的 source 是 `git://...`（**不帶 git+ 前綴**），
# CI plan 通用分支用 `grep -E "^git\+"` 取第一個 git 來源，會抓不到 →
# `exit 1` → 每輪「跑 pkgver() 失敗」永久跳過、永不出包。這裡改成
# git+git:// 前綴（makepkg 合法寫法），plan 才能正確 clone + 現算版號。
# 上游 git.linux-nfs.org 只有 9418 的 git:// 可用（https smart-HTTP 實測 403，
# 也沒有官方 GitHub mirror），故保留 git:// 協定。
#
# epoch=1 保證 1:1.3.8.rN.gHASH 嚴格大於目標機的 lib32-libtirpc 1.3.7-1。
# ⚠️ 版號由 pkgver() 現算 ⇒ kind: multilib 天然排除「校驗和回推」。

pkgname=lib32-libtirpc-git
pkgver=1.3.8.r1.g004c0d6d
pkgrel=1
epoch=1
pkgdesc='Transport Independent RPC library (SunRPC replacement, 32-bit, git)'
arch=(x86_64)
url='http://git.linux-nfs.org/?p=steved/libtirpc.git;a=summary'
license=(BSD-3-Clause)
depends=(lib32-glibc lib32-krb5 libtirpc)
makedepends=(git autoconf automake libtool)
provides=('lib32-libtirpc')
conflicts=('lib32-libtirpc')
source=("git+git://git.linux-nfs.org/projects/steved/libtirpc.git")
sha256sums=('SKIP')

pkgver() {
  cd libtirpc
  git describe --long --tags | sed 's/^libtirpc-//;s/-/.r/;s/-/./g'
}

prepare() {
  cd libtirpc
  chmod +x autogen.sh
  ./autogen.sh
}

build() {
  cd libtirpc
  export CC='gcc -m32'
  export PKG_CONFIG_PATH=/usr/lib32/pkgconfig
  ./configure --prefix=/usr --libdir=/usr/lib32 --sysconfdir=/etc
  make
}

package() {
  cd libtirpc
  make DESTDIR="$pkgdir" install
  rm -rf "$pkgdir"/{etc,usr/{include,share}}
  install -dm 755 "$pkgdir/usr/share/licenses/$pkgname"
  install -m644 COPYING -t "$pkgdir/usr/share/licenses/$pkgname/"
}
