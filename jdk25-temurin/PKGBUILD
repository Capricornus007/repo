# 2026-11-22 in-tree：基于 AUR jdk25-temurin 25.0.5.1.u2-1 改造（MLFS 系统）。
# 与 aetherium Chromium 树内 JDK 25.0.5.1 (Temurin) 同版本。
# 改造点：
#  1. depends 去 java-runtime-common / java-environment-common / ca-certificates-utils（MLFS 无此三包）
#  2. 去 install 脚本（archlinux-java 不存在）；JAVA_HOME 由 /etc/profile.d/jdk25.sh 提供
#  3. 保留 Temurin 二进制自带的 lib/security/cacerts（不链接系统证书）
pkgname=jdk25-temurin
pkgver=25.0.5.1.u2
pkgrel=1
pkgdesc='Temurin 25 (OpenJDK 25 Java binaries by Adoptium, formerly AdoptOpenJDK)'
arch=(x86_64)
url='https://adoptium.net/'
license=(custom)
depends=(desktop-file-utils libxrender libxtst alsa-lib)
provides=("java-runtime-headless=25"
          "java-runtime=25"
          "java-environment=25"
          "jdk-openjdk=${pkgver}")
options=(!strip)

source=(https://github.com/adoptium/temurin25-binaries/releases/download/jdk-25.0.5.1%2B2/OpenJDK25U-jdk_x64_linux_hotspot_25.0.5.1_2.tar.gz
        freedesktop-java.desktop
        freedesktop-jconsole.desktop
        freedesktop-jshell.desktop)
sha256sums=('760f91b22c3efc9bd1b64ff950598231be82928cc807e30691a0e7a2995a62c0'
            '3dfaf29b2913adfb993fc07f3963b6d0f737e8c5f4d2b1b73bb8fcf96bba896b'
            '4898a30b713aef4cbda17727a99a5337ec467126891474454ed8010f4ce8dc7e'
            'dcc9cc253e1ceb14f8ebda2b047c1ec2a412eac16da574bd587bd2d5f0a53afe')

_jvmdir=/usr/lib/jvm/java-25-temurin
_jdkdir=jdk-25.0.5.1+2

package() {
  install -dm 755 "${pkgdir}${_jvmdir}"
  cp -a "${srcdir}/${_jdkdir}"/* "${pkgdir}${_jvmdir}"

  cd "${pkgdir}${_jvmdir}"

  # Conf
  install -dm 755 "${pkgdir}/etc"
  mv conf "${pkgdir}/etc/java-25-temurin"
  ln -sf /etc/java-25-temurin conf

  # Legal
  install -dm 755 "${pkgdir}/usr/share/licenses"
  mv legal "${pkgdir}/usr/share/licenses/${pkgname}"
  ln -sf /usr/share/licenses/${pkgname} legal

  # JAVA_HOME for login shells
  install -d "${pkgdir}/etc/profile.d"
  echo 'export JAVA_HOME=/usr/lib/jvm/java-25-temurin' > "${pkgdir}/etc/profile.d/jdk25.sh"
  chmod 644 "${pkgdir}/etc/profile.d/jdk25.sh"

  # Desktop files
  for f in jconsole java jshell; do
    install -Dm 644 \
      "${srcdir}/freedesktop-${f}.desktop" \
      "${pkgdir}/usr/share/applications/${f}-${pkgname}.desktop"
  done
}
