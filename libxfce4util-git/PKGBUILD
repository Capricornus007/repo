# 2026-11-02：復活自 953a4e5 的剔除清單（Xfce 4.21 鏈）。
# 原條目用 AUR 的裸名依賴（libxfce4ui/garcon/xfconf…），但 feed 只發 -git 包，
# 容器裡 target not found。這裡把 Xfce 家族依賴改成對應 -git 包，並把
# xfce4-dev-tools 改成 xfce4-dev-tools-git；plan 的 -git 依賴門檻會按 DAG
# 自動跳過尚未發布的層，等前一層進 feed 後下一輪再建。
# Maintainer: Limao Luo <luolimao+AUR@gmail.com>
# Maintainer: Niko Cantero <vextium at gmail dot com>
# (Added from libxfce4util package)
# Contributor: Evangelos Foutras <evangelos@foutrelis.com>
# Contributor: tobias <tobias@archlinux.org>

_pkgname=libxfce4util
pkgname="${_pkgname}-git"
pkgver=4.21.0.r3.gf12d6d6
pkgrel=1  # 2→ 為了讓 merged-usr --sbindir 修正真的重新出貨：pkgver() 只蓋 pkgver、
          #    不動 pkgrel，若維持 1 則資產名與既有 r3.gf12d6d6-1 相同 → 被 plan
          #    「已在 release 裡」永久跳過（契約 1），壞包永遠換不掉。抬 2 才有新檔名。
pkgdesc="Basic utility non-GUI functions for Xfce"
arch=(i686 x86_64)
url=http://gitlab.xfce.org/xfce/${_pkgname}/
license=(GPL2)
groups=(xfce4-git)
depends=(glib2)
makedepends=('git' 'xfce4-dev-tools-git' 'gobject-introspection' 'meson' 'vala')
provides=("${_pkgname}=${pkgver}")
conflicts=(${_pkgname%})
replaces=(${_pkgname%})
source=(git+https://gitlab.xfce.org/xfce/${_pkgname})
sha256sums=('SKIP')

pkgver() {
    cd ${srcdir}/${_pkgname}
    git describe | sed 's/^libxfce4util-//;s/-/.r/;s/-/./g'
}

build() {
  # 4.21 已從 autotools 搬到 meson（upstream master 已無 autogen.sh）。
  # merged-usr 必修：meson 預設 sbindir=/usr/sbin，會把 xfce4-kiosk-query 裝進
  # /usr/sbin 並登記該目錄 → 在 /usr/sbin→bin 符號鏈接（filesystem 持有）的 Artix
  # 上與 filesystem 撞檔（run 41344447837 xfconf-git 實測卡死）。釘回 /usr/bin。
  meson setup "${_pkgname}" build \
    --prefix=/usr --bindir=/usr/bin --sbindir=/usr/bin --libdir=lib \
    --buildtype=plain --auto-features=enabled \
    -Dgtk-doc=false \
    -Dvala=enabled
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
}
