pkgname=kew-git
pkgver=v4.3.6.r23.g9181a7e
pkgrel=1
# 舊 pkgver() 用「最高版 tag + commit 短 hash」拼出 v4.3.6.<hash>，同一 tag 下換
# commit 時 vercmp 會去比 hash 的數字段：DB 停在 892380a7（09-21），之後任何以較小
# 數字開頭的 hash 都被判成「更舊」→ repo-add 拒收、產物被清理步驟當未引用刪掉，
# 這包永遠不再換代（用戶機就裝在 v4.3.6.892380a7-1 上）。改成 describe 的
# <tag>.r<距離>.g<hash>（與 mpv-git 同一套路）才有單調性；epoch 是為了跨過 DB 裡
# 那顆舊格式的條目（實測 vercmp v4.3.6.r23.g… vs v4.3.6.892380a7 = -1）。
epoch=1
pkgdesc="A command-line music player"
arch=('x86_64')
url="https://codeberg.org/ravachol/kew"
license=('GPL2')
conflicts=('kew')
depends=('fftw' 'faad' 'git' 'chafa' 'taglib' 'libogg' 'gcc' 'make' 'glib2' 'opus' 'opusfile' 'libvorbis' 'curl')
replaces=('cue-git')
sha256sums=('SKIP')

source=("git+${url}")

pkgver() {
    cd "$srcdir/kew"
    local tag=$(git for-each-ref --sort=-version:refname --count=1 \
        --format='%(refname:strip=2)' refs/tags)
    local commit_hash=$(git rev-parse --short HEAD)
    echo "${tag}.${commit_hash}" | sed 's/[:\/\-]//g'
}

build() {
    cd "$srcdir/kew"
    make PREFIX=/usr KEW_DATADIR=/usr/share LOCALEDIR=/usr/share/locale
}

package() {
    cd "$srcdir/kew"
    make PREFIX=/usr KEW_DATADIR=/usr/share LOCALEDIR=/usr/share/locale \
        DESTDIR="$pkgdir" install
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/${pkgname}/LICENSE"

    [[ -s "$pkgdir/usr/share/kew/layouts/current.layout" ]]
    [[ -s "$pkgdir/usr/share/kew/themes/default.theme" ]]
}
