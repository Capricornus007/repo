pkgname=kew-git
# 靜態佔位要與 pkgver() 的輸出同形（不帶 v）。理由：provides 這類陣列有可能在
# pkgver() 重算之前就以靜態值展開，若佔位還留著 v，做出來的就是
# `kew=2:v4.3.6…`——比穩定版還舊的那種白補。
pkgver=4.3.6.r23.g9181a7e
pkgrel=2
# 舊 pkgver() 用「最高版 tag + commit 短 hash」拼出 v4.3.6.<hash>，同一 tag 下換
# commit 時 vercmp 會去比 hash 的數字段：DB 停在 892380a7（09-21），之後任何以較小
# 數字開頭的 hash 都被判成「更舊」→ repo-add 拒收、產物被清理步驟當未引用刪掉，
# 這包永遠不再換代（用戶機就裝在 v4.3.6.892380a7-1 上）。改成 describe 的
# <tag>.r<距離>.g<hash>（與 mpv-git 同一套路）才有單調性。
# epoch 連跳兩次的原因（都是實測，不是保守起見）：
#   =1：跨過 DB 裡那顆舊格式條目——vercmp v4.3.6.r23.g… vs v4.3.6.892380a7 回 -1。
#   =2：`6b3fe1f` 那筆只改了 CI 探測公式與檔頭佔位，**漏改下面真正的 pkgver()**，
#        所以 run #261 產出的仍是舊形狀 `1:v4.3.6.9181a7ef-1`（已進 feed）。現在
#        pkgver() 換成 describe 式後，`r…`（alpha 段）比那條目的數字段舊，非再抬
#        一次 epoch 不可。同時這個錯位還有第二個後果：探測說 r23、makepkg 說
#        9181a7ef，「已在 release 裡」永遠比不中 → kew-git 每輪白編一次。
epoch=2
pkgdesc="A command-line music player"
arch=('x86_64')
url="https://codeberg.org/ravachol/kew"
license=('GPL2')
conflicts=('kew')
# 依賴 kew 的包（以及 yay／pikaur 這類輔助工具）只看 provides 不看 conflicts，
# 少了這行 kew-git 就永遠無法滿足 `kew`。版本帶 epoch；這裡不必再剋 `v`，
# 因為 pkgver() 已經把 tag 前綴去掉（與 mpv-git 等本倉其他 -git 包同一公式）。
provides=("kew=${epoch}:${pkgver}")
depends=('fftw' 'faad' 'git' 'chafa' 'taglib' 'libogg' 'gcc' 'make' 'glib2' 'opus' 'opusfile' 'libvorbis' 'curl')
replaces=('cue-git' 'kew')
sha256sums=('SKIP')

source=("git+${url}")

# 必须与 build-packages.yml 的 kew-git 分支逐字相同（那邊的註解同一件事），
# 否則 CI 探測到的版本 ≠ makepkg 實產的版本，「已在 release 裡」永遠比不中。
pkgver() {
    cd "$srcdir/kew"
    # s/^v//g 是補上與本倉其他 -git 包（mpv-git 等）一致的一步：kew 的 tag 帶前綴 v，
    # 不去掉會算出 v4.3.6.r23.…，而 vercmp 把「字母開頭的段」排在數字段之下
    # （實測 vercmp v4.3.6 4.3.6 = -1）→ 任何用 $pkgver 拼出來的 provides/依賴
    # 都會比穩定版還舊，等於白補。去掉 v 之後版本反而比現行的 2:v4.3.6… 更新。
    git describe --tags --long --abbrev=7 | sed 's/\([^-]*-g\)/r\1/;s/-/./g;s/[:\/]//g;s/^v//g'
}

build() {
    cd "$srcdir/kew"
    make PREFIX=/usr KEW_DATADIR=/usr/share LOCALEDIR=/usr/share/locale
}

package() {
    cd "$srcdir/kew"
    make PREFIX=/usr KEW_DATADIR=/usr/share LOCALEDIR=/usr/share/locale \
        DESTDIR="$pkgdir" install
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/${pkgname}/LICENSE"

    [[ -s "$pkgdir/usr/share/kew/layouts/current.layout" ]]
    [[ -s "$pkgdir/usr/share/kew/themes/default.theme" ]]
}
